---
// /indir: the Android app (APK) download page, on the new site layout.
import SiteLayout from '../layouts/SiteLayout.astro';

// Android APK download URL. Public route, so use a PUBLIC_* env var so it can
// be swapped at deploy time without code changes. Falls back to the GitHub
// release asset for the current version.
// Fetch latest APK version from GitHub releases API
let apkData = null;
try {
  const apkRes = await fetch(new URL('/api/apk-version', Astro.url));
  apkData = await apkRes.json().catch(() => null);
} catch { /* ignore */ }
const latestTag = apkData?.version || 'v2.5.2';
const apkUrl =
  import.meta.env.PUBLIC_APK_URL ||
  (apkData?.apkUrl || 'https://github.com/sametrsgl/Languago/releases/latest');
const appVersion = latestTag;
const apkFilename = apkData?.apkFilename || ('Languago-' + latestTag + '.apk');
const apkMetadataNotice = apkData?.version
  ? 'Yayın metadatası doğrulandı.'
  : 'Yayın metadatası alınamadı; sürüm bilgisi doğrulanamadı.';

const features = [
  ['🪪', 'Kelime', 'Aralıklı tekrar (SRS) ile kelimeleri kalıcı öğrenin; seviyenize göre setlerle ilerleyin.'],
  ['🧩', 'Dil bilgisi', 'A1–B2 konu slaytları ve çoktan seçmeli testlerle dil bilgisini adım adım pekiştirin.'],
  ['📖', 'Okuma', 'Seviyenize uygun okuma metinleri ve anlama sorularıyla okumanızı geliştirin.'],
  ['🎮', 'Sınıf içi oyunlar', 'Yazım, kelime ve bilgi yarışması oyunlarıyla öğrendiklerinizi eğlenerek tekrar edin.'],
  ['📴', 'Tamamen çevrimdışı', 'İnternet bağlantısı olmadan da çalışır: ders arasında, yolda, her yerde.'],
  ['🔊', 'Telaffuz', 'IPA karşılıkları ve sesli okuma ile doğru telaffuzu öğrenin.'],
];
const installSteps = [
  ['APK dosyasını indirin', `“İndir” düğmesine dokunun. Dosya adı: ${apkFilename}.`],
  ['Dosyayı açın', 'İndirilenler klasöründe APK dosyasına dokunun. Android “bilinmeyen kaynaklardan yükleme” izni isteyebilir.'],
  ['İzni onaylayın', 'Telefon sorarsa “Bilinmeyen uygulamalara izin ver”i onaylayın. Mağaza dışından kurulan uygulamalar için bu normaldir.'],
  ['Kurun ve başlayın', '“Kur”a dokunun; kurulum bitince Languago ana ekranınızda hazır.'],
];
---

<SiteLayout
  title="Languago Android uygulaması — İndir"
  description={`Languago Android uygulamasını indirin: kelime, dil bilgisi, okuma ve sınıf içi oyunlar çevrimdışı çalışır. Android APK (${appVersion}), ücretsiz ve reklamsız.`}
>
  <div class="dl">
    <header class="dl-head">
      <span class="dl-eyebrow">Android uygulaması</span>
      <h1>Languago cebinizde.</h1>
      <p>Kelime, dil bilgisi, okuma ve sınıf içi oyunlar <b>internetsiz</b> de çalışır. Aralıklı tekrar sistemi ve telaffuz desteğiyle her yerde çalışın.</p>
      <div class="dl-cta">
        <a class="btn btn-accent" href={apkUrl} download={apkFilename}>⬇ İndir ({apkFilename})</a>
        <a class="btn btn-ghost" href="/signup">Web’den başla</a>
      </div>
      <p class="dl-meta">Android · {appVersion} · Ücretsiz ve reklamsız. iPhone ve diğer cihazlarda web sürümünü kullanın. {apkMetadataNotice}</p>
    </header>

    <section>
      <h2>Uygulamada neler var?</h2>
      <div class="dl-grid">
        {features.map(([e, t, d]) => <article class="dl-card"><span class="dl-emoji">{e}</span><h3>{t}</h3><p>{d}</p></article>)}
      </div>
    </section>

    <section class="dl-two">
      <div>
        <h2>Nasıl kurulur?</h2>
        <p class="dl-muted">Uygulama mağaza yerine APK dosyasıyla kurulur. Adımlar bir dakikadan kısa sürer.</p>
        <ol class="dl-steps">
          {installSteps.map(([t, d], i) => <li><span>{i + 1}</span><div><b>{t}</b><p>{d}</p></div></li>)}
        </ol>
      </div>
      <div class="dl-req">
        <h2>Sürüm ve gereksinimler</h2>
        <ul>
          <li><b>Sürüm:</b> Languago {appVersion} ({apkFilename})</li>
          <li><b>Platform:</b> Android telefon ve tablet. iOS henüz yok.</li>
          <li><b>Çevrimdışı:</b> İndirdikten sonra internet gerekmez.</li>
          <li><b>Reklam ve ücret:</b> Yok.</li>
        </ul>
        <p class="dl-muted">Her gün görev, kelime yolu ve canlı dersler web sürümünde.</p>
        <a class="btn btn-primary" href="/app">Web sürümünü açın <span class="arrow">→</span></a>
      </div>
    </section>
  </div>
</SiteLayout>

<style>
  .dl { width: min(var(--max), calc(100% - 32px)); margin: 0 auto; padding: clamp(32px, 6vw, 72px) 0 80px; display: grid; gap: clamp(36px, 5vw, 56px); }
  .dl-head { max-width: 700px; display: grid; gap: 14px; }
  .dl-eyebrow { font-weight: 800; font-size: 13px; letter-spacing: .08em; text-transform: uppercase; color: var(--teal-deep); }
  .dl-head h1 { font-size: clamp(34px, 5vw, 56px); letter-spacing: -.025em; line-height: 1.05; margin: 0; }
  .dl-head p { font-size: 18px; color: var(--muted); margin: 0; line-height: 1.55; }
  .dl-cta { display: flex; gap: 10px; flex-wrap: wrap; }
  .dl-cta .btn-accent { white-space: normal; text-align: center; }
  .dl-head .dl-meta { font-size: 14px; }
  .dl h2 { font-size: 24px; margin: 0 0 14px; }
  .dl-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; }
  .dl-card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); padding: 20px; display: grid; gap: 6px; }
  .dl-card h3 { margin: 0; font-size: 17px; }
  .dl-card p { margin: 0; color: var(--muted); font-size: 14.5px; line-height: 1.5; }
  .dl-emoji { font-size: 26px; }
  .dl-two { display: grid; grid-template-columns: 1.2fr 1fr; gap: 24px; align-items: start; }
  .dl-muted { color: var(--muted); margin: 0 0 14px; line-height: 1.55; }
  .dl-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .dl-steps li { display: flex; gap: 14px; align-items: flex-start; }
  .dl-steps li > span { flex: none; width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; font-weight: 800; background: var(--teal-soft); color: var(--teal-deep); }
  .dl-steps p { margin: 3px 0 0; color: var(--muted); font-size: 14.5px; line-height: 1.5; }
  .dl-req { background: var(--sunk); border: 1px solid var(--line); border-radius: var(--r-lg); padding: clamp(20px, 4vw, 28px); }
  .dl-req ul { margin: 0 0 16px; padding-left: 18px; display: grid; gap: 8px; line-height: 1.5; }
  @media (max-width: 860px) { .dl-two { grid-template-columns: 1fr; } }
</style>
