---
// /seviye-testi: Languago level test v2. Four adaptive sections (vocabulary,
// grammar, reading, listening), about 25–30 minutes. Open to everyone; the
// result is saved for signed-in learners, and visitors can save it by signing up.
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/level-test.css';
import { createSupabaseClient, pageCookieSource } from '../lib/supabase';

export const prerender = false;
let signedIn = false;
try {
  const sb = createSupabaseClient(pageCookieSource(Astro));
  if (sb) signedIn = Boolean((await sb.auth.getUser()).data.user);
} catch { /* visitor */ }
---

<SiteLayout title="Seviye testi — Languago" description="25–30 dakikalık uyarlanabilir İngilizce seviye testi: kelime, dilbilgisi, okuma ve dinleme. Her beceri için ayrı CEFR seviyesi." bare>
  <div class="lt" data-signed-in={signedIn ? '1' : '0'}>
    <div class="lt-top">
      <a class="brand" href="/"><img src="/brand/logo-mark.svg" alt="" width="30" height="30" /><span>languago</span></a>
      <div class="lt-steps" aria-hidden="true" hidden data-steps>
        <span data-step="vocab"><i><b></b></i><em>Kelime</em></span>
        <span data-step="grammar"><i><b></b></i><em>Dilbilgisi</em></span>
        <span data-step="reading"><i><b></b></i><em>Okuma</em></span>
        <span data-step="listening"><i><b></b></i><em>Dinleme</em></span>
      </div>
      <a class="exit" href={signedIn ? '/app' : '/'}>Testten çık</a>
    </div>

    <div class="lt-main">
      <!-- intro -->
      <section class="lt-intro" data-view="intro">
        <div>
          <span class="eyebrow">Ücretsiz seviye testi</span>
          <h1>İngilizce seviyenizi her beceri için ayrı ayrı öğrenin.</h1>
          <p class="lede">Test, verdiğiniz cevaplara göre zorlaşır ya da kolaylaşır. Sonunda genel CEFR seviyenizi ve kelime, dilbilgisi, okuma, dinleme için ayrı seviyelerinizi görürsünüz.</p>
          <div class="lt-parts">
            <div><b>Kelime</b><small>12 soru · ~5 dk</small></div>
            <div><b>Dilbilgisi</b><small>12 soru · ~6 dk</small></div>
            <div><b>Okuma</b><small>3 metin · ~10 dk</small></div>
            <div><b>Dinleme</b><small>4 kayıt · ~7 dk</small></div>
          </div>
          <ul class="lt-notes">
            <li>Dinleme bölümü için kulaklık ya da sessiz bir ortam önerilir.</li>
            <li>Bilmediğiniz soruda “Bilmiyorum”u seçin; tahmin etmek sonucu bozar.</li>
            <li>Sayfayı kapatırsanız kaldığınız yerden devam edebilirsiniz.</li>
          </ul>
        </div>
        <form class="lt-card lt-form" data-start novalidate>
          <fieldset>
            <legend>İngilizcenizi nasıl tanımlarsınız?</legend>
            <div class="choice-row">
              <label><input type="radio" name="self" value="0" /><span>Yeni başlıyorum<small>Çok az ya da hiç bilmiyorum.</small></span></label>
              <label><input type="radio" name="self" value="1" /><span>Temel<small>Basit cümleler kurup anlayabiliyorum.</small></span></label>
              <label><input type="radio" name="self" value="2" checked /><span>Orta<small>Günlük konularda konuşabiliyorum.</small></span></label>
              <label><input type="radio" name="self" value="3" /><span>İyi<small>İşte ya da okulda rahatça kullanıyorum.</small></span></label>
              <label><input type="radio" name="self" value="4" /><span>İleri<small>Neredeyse akıcıyım.</small></span></label>
            </div>
          </fieldset>
          <label class="fld" style="display:grid;gap:6px;font-weight:800;font-size:15px">Hedefiniz
            <select name="goal">
              <option value="general">Genel İngilizce</option>
              <option value="ielts">IELTS, TOEFL ya da PTE</option>
              <option value="yds">YDS, YÖKDİL ya da YDT</option>
              <option value="school">Okul dersleri</option>
              <option value="business">İş İngilizcesi</option>
            </select>
          </label>
          <button class="btn btn-accent" type="submit" data-begin>Teste başla</button>
          <button class="btn btn-ghost" type="button" data-resume hidden>Kaldığım yerden devam et</button>
          <p class="muted" style="font-size:13px;margin:0">Bu cevap yalnızca başlangıç zorluğunu belirler; seviyenizi test sonucu belirler.</p>
        </form>
      </section>

      <section data-view="break" hidden><div class="brk"></div></section>
      <section data-view="question" hidden><div class="q-wrap"></div></section>
      <section data-view="unit" hidden></section>
      <section data-view="result" hidden></section>
      <p class="muted" data-view="loading" hidden style="text-align:center;margin-top:12vh">Hazırlanıyor…</p>
    </div>
  </div>
</SiteLayout>

<script>
  import { SECTIONS, createSession, nextStep, recordAnswer, levelB } from '../lib/level-test.mjs';

  type Q = { id: string; skill: string; level: string; stem: string; options: string[] };
  type U = { id: string; skill: string; level: string; title: string; kind?: string; text?: string; audio?: string; questions: Q[] };
  type Bank = { items: Q[]; units: U[] };

  const KEY = 'languago:level-test-session';
  const DRAFT = 'languago:placement-draft';
  const root = document.querySelector('.lt') as HTMLElement;
  const signedIn = root.dataset.signedIn === '1';
  const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector(s) as T;
  const views = ['intro', 'break', 'question', 'unit', 'result', 'loading'];
  const show = (v: string) => { for (const x of views) ($(`[data-view="${x}"]`) as HTMLElement).hidden = x !== v; $('[data-steps]').hidden = v === 'intro' || v === 'result'; window.scrollTo({ top: 0 }); };
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
  const stemHtml = (s: string) => esc(s).replace(/_{3,}/g, '<span class="gap" aria-label="boşluk"></span>').replace(/\*([^*]+)\*/g, '<em>$1</em>');
  const store = {
    get() { try { return JSON.parse(localStorage.getItem(KEY) || 'null'); } catch { return null; } },
    set(v: unknown) { try { localStorage.setItem(KEY, JSON.stringify(v)); } catch { /* private mode */ } },
    clear() { try { localStorage.removeItem(KEY); } catch { /* ignore */ } },
  };

  let bank: Bank | null = null;
  let run: { session: any; selfReport: number; goal: string; lastSection: number } | null = null;

  const SECTION_INTRO: Record<string, string> = {
    vocab: 'Cümledeki boşluğa en uygun kelimeyi ya da anlamı seçin. 12 soru.',
    grammar: 'Cümleyi dilbilgisi açısından doğru ve doğal biçimde tamamlayan seçeneği seçin. 12 soru.',
    reading: 'Üç kısa metin okuyacaksınız; her metnin dört sorusu var. Metin soruları cevaplarken ekranda kalır.',
    listening: 'Dört kısa kayıt dinleyeceksiniz. Her kaydı en fazla iki kez dinleyebilirsiniz. Dinlemeden önce soruları okuyun.',
  };

  async function loadBank() {
    if (bank) return bank;
    const res = await fetch('/api/level-test/bank');
    bank = await res.json();
    return bank as Bank;
  }
  async function check(id: string, choice: number): Promise<boolean> {
    if (choice < 0) return false;
    for (let i = 0; i < 3; i++) {
      try {
        const r = await fetch('/api/level-test/check', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id, choice }) });
        const d = await r.json();
        if (d.ok) return !!d.correct;
      } catch { /* retry */ }
      await new Promise((r) => setTimeout(r, 600 * (i + 1)));
    }
    throw new Error('check_failed');
  }
  const save = () => run && store.set(run);

  function updateSteps() {
    if (!run) return;
    const s = run.session;
    for (const sec of SECTIONS) {
      const el = $(`[data-step="${sec.key}"]`);
      const done = s.answers.filter((a: any) => a.skill === sec.key).length;
      const total = sec.kind === 'item' ? sec.count : sec.count * (sec.key === 'reading' ? 4 : 3);
      (el.querySelector('b') as HTMLElement).style.setProperty('--p', Math.min(100, Math.round((done / total) * 100)) + '%');
      el.classList.toggle('on', SECTIONS[s.section]?.key === sec.key);
    }
  }

  async function advance() {
    if (!run || !bank) return;
    updateSteps();
    const step: any = nextStep(run.session, bank);
    if (step.type === 'done') return finish();
    if (step.section !== run.lastSection) {
      run.lastSection = step.section;
      save();
      return sectionBreak(step.section);
    }
    if (step.type === 'item') renderItem(step.item);
    else renderUnit(step.unit);
  }

  function sectionBreak(i: number) {
    const sec = SECTIONS[i];
    $('.brk').innerHTML = `<span class="num">${i + 1}. bölüm / 4</span><h1>${esc(sec.label)}</h1><p class="lede">${esc(SECTION_INTRO[sec.key])}</p><button class="btn btn-accent" type="button" data-go>Başla</button>`;
    show('break');
    ($('[data-go]') as HTMLButtonElement).focus();
    $('[data-go]').addEventListener('click', () => advance());
  }

  function optsHtml(q: Q, name: string) {
    return q.options.map((o, i) => `<button type="button" class="opt" aria-pressed="false" data-q="${name}" data-i="${i}"><kbd>${'ABCD'[i]}</kbd><span>${esc(o)}</span></button>`).join('');
  }

  function renderItem(q: Q) {
    const sec = SECTIONS.find((s) => s.key === q.skill)!;
    const n = run!.session.answers.filter((a: any) => a.skill === q.skill).length + 1;
    const wrap = $('.q-wrap');
    wrap.innerHTML = `<div class="q-meta"><span>${esc(sec.label)}</span><span>Soru ${n} / ${sec.count}</span></div>
      <p class="q-stem">${stemHtml(q.stem)}</p><div class="opts" role="group" aria-label="Seçenekler">${optsHtml(q, q.id)}</div>
      <div class="q-actions"><button type="button" class="idk" data-idk>Bilmiyorum</button><button class="btn btn-primary" type="button" data-next disabled>Devam</button></div>`;
    show('question');
    let choice: number | null = null;
    const next = wrap.querySelector('[data-next]') as HTMLButtonElement;
    const pick = (i: number) => {
      choice = i;
      wrap.querySelectorAll('.opt').forEach((b) => b.setAttribute('aria-pressed', String(Number((b as HTMLElement).dataset.i) === i)));
      next.disabled = false;
    };
    wrap.querySelectorAll('.opt').forEach((b) => b.addEventListener('click', () => pick(Number((b as HTMLElement).dataset.i))));
    const submit = async (c: number) => {
      next.disabled = true;
      try {
        const correct = await check(q.id, c);
        run!.session = recordAnswer(run!.session, q, c, correct);
        save();
        advance();
      } catch {
        next.disabled = false;
        alert('Bağlantı sorunu. Lütfen tekrar deneyin.');
      }
    };
    next.addEventListener('click', () => choice !== null && submit(choice));
    (wrap.querySelector('[data-idk]') as HTMLElement).addEventListener('click', () => submit(-1));
    keyHandler = (e: KeyboardEvent) => {
      const k = e.key.toUpperCase();
      const idx = '1234'.indexOf(k) >= 0 ? '1234'.indexOf(k) : 'ABCD'.indexOf(k);
      if (idx >= 0 && idx < q.options.length) pick(idx);
      if (e.key === 'Enter' && choice !== null) submit(choice);
    };
  }

  function renderUnit(u: U) {
    const box = $('[data-view="unit"]');
    const listening = u.skill === 'listening';
    const left = listening
      ? `<div class="player"><span class="eyebrow">Dinleme</span><h2>${esc(u.title)}</h2>
          <div class="play"><button type="button" data-play aria-label="Kaydı çal"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></button><div class="bar"><b></b></div></div>
          <span class="plays" data-plays>2 dinleme hakkınız var.</span>
          <audio preload="auto" src="${esc(u.audio || '')}"></audio></div>`
      : `<article class="passage"><h2>${esc(u.title)}</h2>${esc(u.text || '').split(/\n+/).map((p) => `<p>${p}</p>`).join('')}</article>`;
    const qs = u.questions.map((q, i) => `<div class="uq"><b>${i + 1}. ${esc(q.stem)}</b><div class="opts">${optsHtml(q, q.id)}</div><button type="button" class="idk" data-idk="${q.id}" style="justify-self:start">Bilmiyorum</button></div>`).join('');
    box.innerHTML = `<div class="unit">${left}<div class="unit-qs">${qs}<div class="q-actions"><span class="muted" data-left></span><button class="btn btn-primary" type="button" data-next disabled>Devam</button></div></div></div>`;
    show('unit');
    const chosen = new Map<string, number>();
    const next = box.querySelector('[data-next]') as HTMLButtonElement;
    const left2 = box.querySelector('[data-left]') as HTMLElement;
    const refresh = () => {
      const rest = u.questions.length - chosen.size;
      next.disabled = rest > 0;
      left2.textContent = rest > 0 ? `${rest} soru kaldı` : '';
    };
    box.querySelectorAll('.opt').forEach((b) => b.addEventListener('click', () => {
      const el = b as HTMLElement; const id = el.dataset.q!;
      chosen.set(id, Number(el.dataset.i));
      box.querySelectorAll(`.opt[data-q="${id}"]`).forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      refresh();
    }));
    box.querySelectorAll('[data-idk]').forEach((b) => b.addEventListener('click', () => {
      const id = (b as HTMLElement).dataset.idk!;
      chosen.set(id, -1);
      box.querySelectorAll(`.opt[data-q="${id}"]`).forEach((x) => x.setAttribute('aria-pressed', 'false'));
      (b as HTMLElement).textContent = 'Bilmiyorum ✓';
      refresh();
    }));
    refresh();
    if (listening) wirePlayer(box, u);
    next.addEventListener('click', async () => {
      next.disabled = true;
      try {
        const results = await Promise.all(u.questions.map((q) => check(q.id, chosen.get(q.id) ?? -1)));
        u.questions.forEach((q, i) => { run!.session = recordAnswer(run!.session, q, chosen.get(q.id) ?? -1, results[i], u.id); });
        save();
        advance();
      } catch {
        next.disabled = false;
        alert('Bağlantı sorunu. Lütfen tekrar deneyin.');
      }
    });
    keyHandler = null;
  }

  function wirePlayer(box: Element, u: U) {
    const audio = box.querySelector('audio') as HTMLAudioElement;
    const btn = box.querySelector('[data-play]') as HTMLButtonElement;
    const bar = box.querySelector('.bar b') as HTMLElement;
    const label = box.querySelector('[data-plays]') as HTMLElement;
    const playsKey = 'plays:' + u.id;
    let plays = Number(sessionStorage.getItem(playsKey) || 0);
    const paint = () => {
      const left = 2 - plays;
      btn.disabled = left <= 0 || !audio.paused;
      label.textContent = left > 0 ? `${left} dinleme hakkınız var.` : 'Dinleme hakkınız bitti.';
    };
    audio.addEventListener('timeupdate', () => { bar.style.width = (audio.duration ? (audio.currentTime / audio.duration) * 100 : 0) + '%'; });
    audio.addEventListener('ended', () => { bar.style.width = '100%'; paint(); });
    audio.addEventListener('error', () => { label.textContent = 'Ses dosyası yüklenemedi. Soruları “Bilmiyorum” ile geçebilirsiniz.'; btn.disabled = true; });
    btn.addEventListener('click', () => {
      if (plays >= 2) return;
      plays++; try { sessionStorage.setItem(playsKey, String(plays)); } catch { /* ignore */ }
      audio.currentTime = 0; audio.play().catch(() => undefined); paint();
      btn.disabled = true;
    });
    paint();
  }

  const LEVEL_NAMES: Record<string, string> = { A1: 'Başlangıç', A2: 'Temel', B1: 'Orta', B2: 'Orta üstü', C1: 'İleri', C2: 'Uzman' };
  const CAN_DO: Record<string, Record<string, string>> = {
    vocab: {
      A1: 'Günlük hayattaki temel kelimeleri (aile, yemek, zaman, yer) tanıyorsunuz.',
      A2: 'Alışveriş, seyahat ve sağlık gibi tanıdık konularda kelime bilginiz yeterli.',
      B1: 'İş, okul ve günlük konularda sık kullanılan kelime ve kalıpları biliyorsunuz.',
      B2: 'Soyut konularda ve yaygın eşdizimlerde (collocation) rahatsınız.',
      C1: 'Akademik ve mesleki kelimeleri, deyimleri ve ince anlam farklarını kullanıyorsunuz.',
      C2: 'Seyrek kelimeleri ve üslup farklarını anadil düzeyine yakın biliyorsunuz.',
    },
    grammar: {
      A1: 'Basit cümleler kurabiliyorsunuz: to be, geniş zaman, there is/are, can.',
      A2: 'Geçmiş zamanı, gelecek planlarını ve karşılaştırmaları doğru kullanıyorsunuz.',
      B1: 'Present perfect, koşul cümleleri ve edilgen yapıyla daha karmaşık fikirler anlatıyorsunuz.',
      B2: 'Karışık koşul cümleleri, modal perfect ve ettirgen yapı gibi ileri yapıları kullanıyorsunuz.',
      C1: 'Devrik cümle, vurgu yapıları ve resmi dilbilgisini doğal biçimde kullanıyorsunuz.',
      C2: 'En ince dilbilgisi ayrımlarını ve resmi/edebi yapıları rahatlıkla kullanıyorsunuz.',
    },
    reading: {
      A1: 'Kısa mesajları, tabelaları ve basit duyuruları anlıyorsunuz.',
      A2: 'İlan, e-posta ve kısa yazılar gibi günlük metinlerin ana fikrini ve ayrıntılarını anlıyorsunuz.',
      B1: 'Haber ve e-posta gibi metinlerde ana fikri, ayrıntıları ve yazarın amacını anlıyorsunuz.',
      B2: 'Uzun yazılarda görüşleri, çıkarımları ve yazarın tutumunu takip edebiliyorsunuz.',
      C1: 'Karmaşık ve akademik metinlerde örtük anlamları ve argümanın yapısını anlıyorsunuz.',
      C2: 'Soyut, yoğun ve ironik metinleri ayrıntısıyla ve eleştirel biçimde okuyorsunuz.',
    },
    listening: {
      A1: 'Yavaş ve net konuşulan kısa diyalogları ve mesajları anlıyorsunuz.',
      A2: 'Duyurularda ve günlük konuşmalarda saat, yer, fiyat gibi önemli bilgileri yakalıyorsunuz.',
      B1: 'Radyo haberleri ve sesli mesajlarda ana fikri ve ayrıntıları anlıyorsunuz.',
      B2: 'Toplantı ve podcast gibi doğal hızdaki konuşmalarda görüşleri takip ediyorsunuz.',
      C1: 'Ders, röportaj ve tartışmalarda konuşmacının tutumunu ve örtük anlamları anlıyorsunuz.',
      C2: 'Hızlı, deyimsel ve ince imalı konuşmaları zorlanmadan anlıyorsunuz.',
    },
  };
  const NEXT: Record<string, string> = { A1: 'A2', A2: 'B1', B1: 'B2', B2: 'C1', C1: 'C2', C2: 'C2' };

  async function finish() {
    if (!run) return;
    show('loading');
    let data: any = null;
    try {
      const res = await fetch('/api/level-test/finish', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({
        answers: run.session.answers.map((a: any) => ({ id: a.id, choice: a.choice })), selfReport: run.selfReport, goal: run.goal,
      }) });
      data = await res.json();
    } catch { /* below */ }
    if (!data?.ok) { $('[data-view="loading"]').textContent = 'Sonuç hesaplanamadı. Sayfayı yenileyip tekrar deneyin; cevaplarınız saklı.'; return; }
    if (!data.saved) {
      try { localStorage.setItem(DRAFT, JSON.stringify({ format: 'lt2', answers: run.session.answers.map((a: any) => ({ id: a.id, choice: a.choice })), selfReport: run.selfReport, goal: run.goal })); } catch { /* ignore */ }
    }
    store.clear();
    renderResult(data.result, data.saved);
  }

  function renderResult(r: any, saved: boolean) {
    const o = r.overall;
    const ladder = (lv: string) => ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'].map((x) => `<i class="${levelB(x) <= levelB(lv) ? 'on' : ''}"></i>`).join('');
    const skills = SECTIONS.map((s) => {
      const k = r.skills[s.key]; if (!k) return '';
      const differ = r.strongest && r.weakest && r.skills[r.strongest].level !== r.skills[r.weakest].level;
      const tag = !differ ? '' : r.strongest === s.key ? '<span class="tag">En güçlü beceriniz</span>' : r.weakest === s.key ? '<span class="tag">Önce buna odaklanın</span>' : '';
      return `<div class="skill"><header><b>${esc(s.label)}</b><span>${k.level}</span></header><div class="ladder" aria-hidden="true">${ladder(k.level)}</div><p>${esc(CAN_DO[s.key][k.level])}</p>${tag}</div>`;
    }).join('');
    const cta = saved
      ? `<a class="btn btn-accent" href="/app">Öğrenme yoluma git</a><a class="btn btn-ghost" href="/app/derslerim">Öğretmenimle ders planla</a><span class="muted">Sonucunuz hesabınıza kaydedildi.</span>`
      : `<a class="btn btn-accent" href="/signup">Sonucumu kaydet: ücretsiz kayıt ol</a><a class="btn btn-ghost" href="/signin">Hesabım var, giriş yap</a><span class="muted">Kayıt olunca sonucunuz hesabınıza eklenir.</span>`;
    $('[data-view="result"]').innerHTML = `<div class="lt-card">
      <div class="res-head"><div class="badge-lv"><b>${o.level}</b><small>${esc(LEVEL_NAMES[o.level])}</small></div>
        <div style="display:grid;gap:12px"><span class="eyebrow">Genel seviyeniz</span><h1>${o.level === 'C2' ? 'İngilizceniz uzman düzeyinde.' : `${o.level} seviyesindesiniz, ${NEXT[o.level]} yolunda.`}</h1>
        ${o.level === 'C2' ? '' : `<div class="to-next"><div class="bar"><b style="width:0" data-fill="${Math.round(o.progress * 100)}"></b></div><span class="muted" style="font-size:13.5px">${o.progress < 0.1 ? `${NEXT[o.level]} yolunun başındasınız.` : `${NEXT[o.level]} seviyesine yaklaşık %${Math.round(o.progress * 100)} yoldasınız.`}</span></div>`}</div></div>
      <div class="skills">${skills}</div>
      <div class="res-cta">${cta}</div></div>`;
    show('result');
    requestAnimationFrame(() => requestAnimationFrame(() => {
      const f = $('[data-fill]'); if (f) f.style.width = f.dataset.fill + '%';
    }));
  }

  let keyHandler: ((e: KeyboardEvent) => void) | null = null;
  document.addEventListener('keydown', (e) => { if (keyHandler && !(e.target instanceof HTMLInputElement)) keyHandler(e); });

  async function begin(resume: boolean) {
    show('loading');
    try { await loadBank(); } catch { $('[data-view="loading"]').textContent = 'Test yüklenemedi. İnternet bağlantınızı kontrol edip sayfayı yenileyin.'; return; }
    if (!resume) {
      const f = new FormData($('[data-start]') as HTMLFormElement);
      const selfReport = Number(f.get('self') ?? 2);
      run = { session: createSession({ selfReport, seed: Math.floor(Math.random() * 2 ** 31) }), selfReport, goal: String(f.get('goal') || 'general'), lastSection: -1 };
      save();
    }
    advance();
  }

  const saved = store.get();
  if (saved?.session?.answers?.length) {
    run = saved;
    const r = $('[data-resume]'); r.hidden = false;
    r.addEventListener('click', () => begin(true));
  }
  ($('[data-start]') as HTMLFormElement).addEventListener('submit', (e) => { e.preventDefault(); store.clear(); begin(false); });
  if (new URLSearchParams(location.search).get('basla') === '1') begin(false);
</script>
