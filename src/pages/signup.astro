---
import Layout from '../layouts/Layout.astro';

// Signup is submitted client-side via fetch (accept:'json') to bypass Astro's
// origin-check middleware on the live custom domain.

// Supabase auth base (derive project ref from SUPABASE_URL, fallback to known ref).
// Google OAuth is handled by Supabase Auth: the user clicks this link, Supabase
// redirects back with a session cookie.
const supabaseUrl = import.meta.env.SUPABASE_URL;
const SUPABASE_PROJECT_REF =
  supabaseUrl && supabaseUrl.includes('.supabase.co')
    ? supabaseUrl.replace(/^https?:\/\//, '').split('.')[0]
    : 'wkhjmgfmnmmagsrsdmnz';
const siteUrl = import.meta.env.SITE_URL || 'https://www.languago.site';
const googleAuthUrl = `https://${SUPABASE_PROJECT_REF}.supabase.co/auth/v1/authorize?provider=google&redirect_to=${encodeURIComponent(siteUrl)}`;
---

<Layout
  title="Öğrenci Kaydı — Languago"
  description="1 dakikada ücretsiz öğrenci hesabı oluşturun. İngilizce kelime, dil bilgisi, okuma ve oyunlarla öğrenmeye başlayın."
>
  <main class="auth">
    <h1>Öğrenci Kaydı</h1>
    <p style="color: var(--ink-soft); margin-top: -8px;">
      Languago'e başlamak için hesap oluştur.
    </p>

    <div id="signup-feedback" aria-live="polite"></div>

    <form id="signup-form" novalidate>
      <div class="field">
        <label for="fullName">Ad Soyad <span style="color: var(--ink-soft);">(isteğe bağlı)</span></label>
        <input type="text" id="fullName" name="fullName" maxlength="120" autocomplete="name" />
      </div>

      <div class="field">
        <label for="email">E-posta</label>
        <input type="email" id="email" name="email" required autocomplete="email" />
      </div>

      <div class="field">
        <label for="password">Şifre</label>
        <input type="password" id="password" name="password" required autocomplete="new-password" />
        <div class="hint">En az 6 karakter.</div>
      </div>

      <button class="btn primary" type="submit" style="width: 100%;" id="signup-submit">Kayıt Ol</button>
    </form>

    <div class="divider"><span>veya</span></div>

    <a class="btn btn-google" href={googleAuthUrl}>
      <svg class="g-icon" viewBox="0 0 48 48" aria-hidden="true">
        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
        <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
      </svg>
      Google ile Kayıt Ol
    </a>

    <p class="alt">
      Zaten hesabın var mı? <a href="/signin">Giriş yap</a>
    </p>
  </main>
</Layout>

<script is:inline>
  (function () {
    var form = document.getElementById('signup-form');
    if (!form) return;
    var feedback = document.getElementById('signup-feedback');
    var submitBtn = document.getElementById('signup-submit');

    form.addEventListener('submit', function (e) {
      e.preventDefault();

      var fullName = document.getElementById('fullName').value;
      var email = document.getElementById('email').value;
      var password = document.getElementById('password').value;

      // Disable the button while the request is in flight.
      submitBtn.disabled = true;
      submitBtn.textContent = 'Kaydediliyor…';

      fetch('/api/auth/signup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ fullName: fullName || null, email: email, password: password }),
      })
        .then(function (res) {
          return res.json().catch(function () {
            return null;
          });
        })
        .then(function (result) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Kayıt Ol';

          if (result && result.ok) {
            // Email confirmation disabled in Supabase → session exists → auto-login.
            if (result.hasSession) {
              window.location.href = '/dashboard';
              return;
            }
            feedback.innerHTML =
              '<div class="alert success" role="status">Hesabın oluşturuldu! E-postana gönderilen doğrulama bağlantısını kullan ve giriş yap.</div>';
            return;
          }

          // Error path: result.error may be a field error or a message error.
          var message = 'Kayıt sırasında bir hata oluştu.';
          if (result && result.error) {
            if (result.error.fields) {
              var fieldErrors = [];
              Object.keys(result.error.fields).forEach(function (key) {
                fieldErrors = fieldErrors.concat(result.error.fields[key]);
              });
              if (fieldErrors.length) {
                message = fieldErrors.join(' ');
              } else {
                message = result.error.message || message;
              }
            } else {
              message = result.error.message || message;
            }
          }
          feedback.innerHTML =
            '<div class="alert error" role="alert">' + message.replace(/[<>&"]/g, '') + '</div>';
        })
        .catch(function () {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Kayıt Ol';
          feedback.innerHTML =
            '<div class="alert error" role="alert">Kayıt sırasında bir hata oluştu. Lütfen tekrar dene.</div>';
        });
    });
  })();
</script>