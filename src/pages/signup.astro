---
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/auth.css';

// Signup is submitted client-side via fetch (accept:'json') to bypass Astro's
// origin-check middleware on the live custom domain.

// Google OAuth goes through our server-driven PKCE route: it generates the
// verifier cookie, redirects to Supabase/Google, and lands on
// /api/auth/callback which exchanges the code for session cookies.
const googleAuthUrl = '/api/auth/oauth/google';
// ?rol=ogretmen (footer and homepage links) preselects the teacher card.
const teacherFirst = Astro.url.searchParams.get('rol') === 'ogretmen';
---

<SiteLayout
  title="Ücretsiz kayıt — Languago"
  description="Languago'ya öğrenci ya da öğretmen olarak ücretsiz katılın."
  bare
>
  <div class="auth-wrap">
    <aside class="auth-side" data-auth-side>
      <h2>Size özel bir İngilizce yolculuğu başlasın.</h2>
      <ul><li>Seviyenize ve hedefinize göre özel program</li><li>Kendi seçtiğiniz saatlere uygun canlı dersler</li><li>Öğretmenler için sınıflar, takvim ve materyaller</li></ul>
      <p class="quote">Doğru yöntemlerle İngilizce öğrenmek hayal değil.</p>
    </aside>
    <div class="auth-main">
      <div class="auth-card">
        <div><h1>Ücretsiz kayıt</h1><p class="sub">Bir dakikada hesabınızı açın.</p></div>
        <div id="signup-feedback" aria-live="polite"></div>
        <form id="signup-form" novalidate>
          <fieldset class="roles">
            <legend>Languago'yu nasıl kullanacaksınız?</legend>
            <label class="role"><input type="radio" name="role" value="student" checked={!teacherFirst} />
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 9 12 4l10 5-10 5z"/><path d="M6 11v5c3 2 9 2 12 0v-5"/></svg>
              <b>Öğrenciyim</b><small>Ders almak ve pratik yapmak istiyorum.</small></label>
            <label class="role"><input type="radio" name="role" value="teacher" checked={teacherFirst} />
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>
              <b>Öğretmenim</b><small>Ders vermek ve öğrencilerimi yönetmek istiyorum.</small></label>
          </fieldset>
          <div class="field"><label for="fullName">Ad Soyad</label><input type="text" id="fullName" name="fullName" maxlength="120" autocomplete="name" /></div>
          <div class="field"><label for="email">E-posta</label><input type="email" id="email" name="email" required autocomplete="email" /></div>
          <div class="field"><label for="password">Şifre</label><input type="password" id="password" name="password" required autocomplete="new-password" /><span class="hint">En az 6 karakter.</span></div>
          <button class="btn btn-primary" type="submit" id="signup-submit">Kayıt ol</button>
        </form>
        <div class="divider">veya</div>
        <a class="btn btn-google" href={googleAuthUrl} data-google>
          <svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
          Google ile kayıt ol
        </a>
        <p class="alt">Zaten hesabınız var mı? <a href="/signin">Giriş yapın</a></p>
      </div>
    </div>
  </div>
</SiteLayout>

<script is:inline>
  (function () {
    var form = document.getElementById('signup-form');
    if (!form) return;
    // Google sign-up carries the chosen role.
    var google = document.querySelector('[data-google]');
    var syncGoogle = function () {
      var r = (form.querySelector('input[name="role"]:checked') || {}).value || 'student';
      if (google) google.setAttribute('href', '/api/auth/oauth/google?rol=' + (r === 'teacher' ? 'ogretmen' : 'ogrenci'));
    };
    form.addEventListener('change', syncGoogle);
    syncGoogle();
    var feedback = document.getElementById('signup-feedback');
    var submitBtn = document.getElementById('signup-submit');

    async function savePlacementDraft() {
      var timeout;
      try {
        // Draft transfer is optional; storage/network failure must not block login.
        var key = 'languago:placement-draft';
        var draft = localStorage.getItem(key);
        if (!draft) return;
        var parsed = JSON.parse(draft);
        if (!Array.isArray(parsed?.answers) || !parsed.answers.length) return;
        var controller = new AbortController();
        timeout = setTimeout(function () { controller.abort(); }, 3000);
        var res = await fetch('/api/placement/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(parsed),
          signal: controller.signal,
        });
        // Another tab may have started a new attempt while this request ran.
        if (res.ok && localStorage.getItem(key) === draft) localStorage.removeItem(key);
      } catch (_) {
        // Keep an unsaved draft for a later retry from the homepage.
      } finally {
        clearTimeout(timeout);
      }
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();

      var fullName = document.getElementById('fullName').value;
      var email = document.getElementById('email').value;
      var password = document.getElementById('password').value;

      // Disable the button while the request is in flight.
      submitBtn.disabled = true;
      submitBtn.textContent = 'Kaydediliyor…';

      fetch('/api/auth/signup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ fullName: fullName || null, email: email, password: password, role: (form.querySelector('input[name="role"]:checked') || {}).value || 'student' }),
      })
        .then(function (res) {
          return res.json().catch(function () {
            return null;
          });
        })
        .then(function (result) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Kayıt ol';

          if (result && result.ok) {
            // Email confirmation disabled in Supabase → session exists → auto-login.
            if (result.hasSession) {
              savePlacementDraft().then(function () { window.location.href = '/dashboard'; });
              return;
            }
            // No session yet: retain the draft until a successful sign-in.
            feedback.innerHTML =
              '<div class="alert success" role="status">Hesabın oluşturuldu! E-postana gönderilen doğrulama bağlantısını kullan ve giriş yap.</div>';
            return;
          }

          // Error path: result.error may be a field error or a message error.
          var message = 'Kayıt sırasında bir hata oluştu.';
          if (result && result.error) {
            if (result.error.fields) {
              var fieldErrors = [];
              Object.keys(result.error.fields).forEach(function (key) {
                fieldErrors = fieldErrors.concat(result.error.fields[key]);
              });
              if (fieldErrors.length) {
                message = fieldErrors.join(' ');
              } else {
                message = result.error.message || message;
              }
            } else {
              message = result.error.message || message;
            }
          }
          feedback.innerHTML =
            '<div class="alert error" role="alert">' + message.replace(/[<>&"]/g, '') + '</div>';
        })
        .catch(function () {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Kayıt ol';
          feedback.innerHTML =
            '<div class="alert error" role="alert">Kayıt sırasında bir hata oluştu. Lütfen tekrar dene.</div>';
        });
    });
  })();
</script>