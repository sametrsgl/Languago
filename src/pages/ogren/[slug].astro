---
import Layout from '../../layouts/Layout.astro';
import lessonsData from '../../data/public-lessons.json';
  export const prerender = true;
export function getStaticPaths() { return lessonsData.lessons.map((lesson) => ({ params: { slug: lesson.slug }, props: { lesson } })); }
const { lesson } = Astro.props;
const siteUrl = Astro.site?.origin || 'https://www.languago.site';
const canonical = `${siteUrl}/ogren/${lesson.slug}`;
---
<Layout title={`${lesson.title} — Languago`} description={lesson.objective} canonical={canonical}>
  <main id="main-content" class="container section lesson-preview">
    <a href="/ogren">← Tüm mini dersler</a>
    <p class="kicker" style="margin-top:1.5rem;">{lesson.level} · Mini ders</p>
    <h1>{lesson.title}</h1>
    <p><strong>Hedef:</strong> {lesson.objective}</p>
    <section class="card"><h2>Kısa açıklama</h2><p>{lesson.explanation}</p><h3>Örnekler</h3><ul>{lesson.examples.map((x) => <li>{x}</li>)}</ul>{lesson.reading && <p class="reading-text">{lesson.reading}</p>}</section>
    <section aria-labelledby="practice-title" style="margin-top:2rem;"><h2 id="practice-title">Kısa pratik</h2><div class="public-quiz">{lesson.practice.map((q, i) => <article class="card question" data-question data-answer={q.answerIndex}><h3>{i + 1}. {q.prompt}</h3><div class="options">{q.options.map((option, oi) => <button type="button" class="option" aria-pressed="false" data-option={oi} data-correct-feedback={q.why} data-incorrect-feedback="Tekrar düşün ve metindeki ipucuna bak.">{option}</button>)}</div><p class="feedback" aria-live="polite" hidden></p></article>)}</div></section>
    <script>
      document.querySelectorAll('[data-question]').forEach((question) => { const answer = Number(question.dataset.answer); const feedback = question.querySelector('.feedback'); question.querySelectorAll('[data-option]').forEach((button) => { button.addEventListener('keydown', (event) => { if (event.key === 'Enter' || event.key === ' ') button.click(); }); button.addEventListener('click', () => { const chosen = Number(button.dataset.option); question.querySelectorAll('[data-option]').forEach((b) => b.setAttribute('aria-pressed','false')); button.setAttribute('aria-pressed','true'); feedback.hidden = false; feedback.textContent = chosen === answer ? button.dataset.correctFeedback : button.dataset.incorrectFeedback; }); }); });
    </script>
  </main>
  <script type="application/ld+json" set:html={JSON.stringify({ '@context':'https://schema.org', '@type':'LearningResource', name:lesson.title, description:lesson.objective, educationalLevel:lesson.level, learningResourceType:'English mini lesson', url:canonical })} />
</Layout>
