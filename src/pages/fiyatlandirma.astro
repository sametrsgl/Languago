---
// /fiyatlandirma: plans. For now there is one plan, Ücretsiz, and it has
// everything. Premium services come later; the page asks for ideas through
// the contact form instead of showing prices.
import SiteLayout from '../layouts/SiteLayout.astro';
import ContactForm from '../components/ContactForm.astro';
export const prerender = true;

const free = [
  ['Seviye testi', 'Yetişkin ve 7–13 yaş çocuk testi; seviye, güçlü ve zayıf yönler'],
  ['Bugünün görevi', 'Her gün dil bilgisi, okuma, dinleme, yazma ve konuşma'],
  ['Yapay zekâ geri bildirimi', 'Yazma ve konuşma cevaplarınıza anında yorum'],
  ['Kelime yolu', 'Kelime analizi, her gün 13 yeni kelime, kartlar ve oyunlar'],
  ['Canlı dersler', 'Öğretmeninizle ders talebi, takvim, Meet bağlantısı ve ders raporu'],
  ['Veli paneli', 'Çocuğunuzun görevlerini ve derslerini takip edin'],
  ['Öğretmen araçları', 'Takvim, öğrenci takibi, sınıflar, materyaller ve sınıf oyunları'],
];
---

<SiteLayout title="Fiyatlar — Languago" description="Languago şu an tamamen ücretsiz: seviye testi, her gün görev, kelime yolu, canlı ders takvimi ve öğretmen araçları.">
  <div class="pr">
    <header class="pr-head">
      <span class="pr-eyebrow">Fiyatlar</span>
      <h1>Şu an her şey ücretsiz.</h1>
      <p>Languago’nun bütün özellikleri ücretsiz planda. İleride ek premium hizmetler gelecek; neler olacağını sizinle birlikte belirlemek istiyoruz.</p>
    </header>

    <div class="pr-grid">
      <article class="pr-card pr-free">
        <div class="pr-top">
          <h2>Ücretsiz</h2>
          <span class="pr-badge">Şu anki plan</span>
        </div>
        <p class="pr-price"><b>0 ₺</b><span>kart gerekmez</span></p>
        <ul>
          {free.map(([t, d]) => <li><b>{t}</b><span>{d}</span></li>)}
        </ul>
        <div class="pr-cta">
          <a class="btn btn-accent" href="/signup">Ücretsiz hesap aç <span class="arrow">→</span></a>
          <a class="btn btn-ghost" href="/seviye-testi">Önce seviye testi</a>
        </div>
      </article>

      <article class="pr-card pr-premium">
        <div class="pr-top">
          <h2>Premium</h2>
          <span class="pr-badge soon">Yakında</span>
        </div>
        <p class="pr-price"><b>Hazırlanıyor</b></p>
        <p>Ücretsiz planın üstüne gelecek ek hizmetleri planlıyoruz. Henüz bir fiyat ya da tarih yok.</p>
        <p>Languago’da ne görmek isterdiniz? Fikirleriniz premium planı birlikte şekillendirecek.</p>
        <div class="pr-cta">
          <a class="btn btn-primary" href="#bize-yazin" data-premium>Fikrimi yazmak istiyorum</a>
        </div>
      </article>
    </div>

    <section class="pr-faq">
      <details><summary>Ücretsiz plan için kart bilgisi gerekiyor mu?</summary><p>Hayır. Hesap açmak ve bütün özellikleri kullanmak için ödeme bilgisi istemiyoruz.</p></details>
      <details><summary>Okulum ya da kurumum için kullanabilir miyim?</summary><p>Evet. Öğretmen hesabıyla sınıflarınızı kurabilirsiniz. Kurumunuza özel ihtiyaçlar için aşağıdan ya da <a href="/iletisim?konu=kurum">iletişim sayfasından</a> bize yazın.</p></details>
      <details><summary>Canlı derslerin ücreti var mı?</summary><p>Languago dersleri planlamak ve takip etmek için ücret almaz. Ders ücretleri hakkında öğretmeninizle konuşun.</p></details>
    </section>

    <section class="pr-contact" id="bize-yazin">
      <ContactForm topic="premium" heading="Bize yazın" />
    </section>
  </div>
</SiteLayout>

<script>
  document.querySelector('[data-premium]')?.addEventListener('click', () => {
    const sel = document.querySelector('form[data-cf] select[name=topic]') as HTMLSelectElement | null;
    if (sel) sel.value = 'premium';
    setTimeout(() => (document.querySelector('form[data-cf] textarea') as HTMLTextAreaElement | null)?.focus(), 400);
  });
</script>

<style>
  .pr { width: min(var(--max), calc(100% - 32px)); margin: 0 auto; padding: clamp(32px, 6vw, 72px) 0 80px; display: grid; gap: clamp(28px, 4vw, 44px); }
  .pr-head { max-width: 680px; display: grid; gap: 12px; }
  .pr-eyebrow { font-weight: 800; font-size: 13px; letter-spacing: .08em; text-transform: uppercase; color: var(--teal-deep); }
  .pr-head h1 { font-size: clamp(34px, 5vw, 56px); letter-spacing: -.025em; line-height: 1.05; margin: 0; }
  .pr-head p { font-size: 18px; color: var(--muted); margin: 0; line-height: 1.55; }
  .pr-grid { display: grid; grid-template-columns: 1.35fr 1fr; gap: 20px; align-items: start; }
  .pr-card { border-radius: var(--r-lg); padding: clamp(22px, 4vw, 32px); display: grid; gap: 16px; }
  .pr-card h2 { margin: 0; font-size: 24px; }
  .pr-card p { margin: 0; line-height: 1.55; }
  .pr-free { background: var(--surface); border: 1.5px solid var(--teal); box-shadow: var(--shadow-lg); }
  .pr-premium { background: var(--sunk); border: 1px solid var(--line); color: var(--ink); }
  .pr-premium p { color: var(--muted); }
  .pr-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .pr-badge { font-size: 12.5px; font-weight: 800; padding: 5px 11px; border-radius: 99px; background: var(--teal-soft); color: var(--teal-deep); }
  .pr-badge.soon { background: var(--orange-soft); color: var(--orange-deep); }
  .pr-price { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .pr-price b { font-size: clamp(34px, 5vw, 44px); letter-spacing: -.02em; }
  .pr-premium .pr-price b { font-size: 26px; color: var(--ink); }
  .pr-price span { color: var(--muted); font-weight: 600; }
  .pr-card ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .pr-card li { display: grid; grid-template-columns: 22px 1fr; column-gap: 10px; }
  .pr-card li::before { content: '✓'; grid-row: span 2; width: 22px; height: 22px; border-radius: 50%; background: var(--teal-soft); color: var(--teal-deep); font-weight: 800; font-size: 13px; display: grid; place-items: center; margin-top: 1px; }
  .pr-card li span { color: var(--muted); font-size: 14.5px; }
  .pr-cta { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 4px; }
  .pr-faq { display: grid; gap: 10px; max-width: 820px; }
  .pr-faq details { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); padding: 16px 20px; }
  .pr-faq summary { font-weight: 700; cursor: pointer; }
  .pr-faq p { margin: 10px 0 0; color: var(--muted); line-height: 1.55; }
  .pr-contact { max-width: 820px; scroll-margin-top: 90px; }
  @media (max-width: 860px) { .pr-grid { grid-template-columns: 1fr; } }
</style>
