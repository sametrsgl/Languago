---
import Layout from '../layouts/Layout.astro';
import { actions } from 'astro:actions';
import { createSupabaseClient, pageCookieSource } from '../lib/supabase';

let error: string | undefined;

// Already authenticated? Send straight to the dashboard.
const supabase = createSupabaseClient(pageCookieSource(Astro));
if (supabase) {
  const { data } = await supabase.auth.getUser();
  if (data.user) {
    return Astro.redirect('/dashboard');
  }
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const { error: err } = await Astro.callAction(actions.signin, {
    email: String(form.get('email') ?? ''),
    password: String(form.get('password') ?? ''),
  });

  if (err) {
    error = err.message ?? 'Giriş başarısız. Bilgilerini kontrol et.';
  } else {
    return Astro.redirect('/dashboard');
  }
}
---

<Layout
  title="Giriş Yap — Languago"
  description="Languago hesabına giriş yap; derslerine, ilerlemene ve sınıf içi oyunlara eriş."
>
  <main class="auth">
    <h1>Giriş Yap</h1>
    <p style="color: var(--ink-soft); margin-top: -8px;">
      Hesabınla devam et.
    </p>

    {error && <div class="alert error" role="alert">{error}</div>}

    <form method="POST">
      <div class="field">
        <label for="email">E-posta</label>
        <input type="email" id="email" name="email" required autocomplete="email" />
      </div>

      <div class="field">
        <label for="password">Şifre</label>
        <input type="password" id="password" name="password" required autocomplete="current-password" />
      </div>

      <button class="btn primary" type="submit" style="width: 100%;">Giriş Yap</button>
    </form>

    <p class="alt">
      Hesabın yok mu? <a href="/signup">Kayıt ol</a>
    </p>
  </main>
</Layout>