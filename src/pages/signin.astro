---
import Layout from '../layouts/Layout.astro';
import { createSupabaseClient, pageCookieSource } from '../lib/supabase';

// Already authenticated (e.g. visiting logged-in from another page)?
// Send straight to the dashboard.
const supabase = createSupabaseClient(pageCookieSource(Astro));
if (supabase) {
  const { data } = await supabase.auth.getUser();
  if (data.user) {
    return Astro.redirect('/dashboard');
  }
}
---

<Layout
  title="Giriş Yap — Languago"
  description="Languago hesabına giriş yap; derslerine, ilerlemene ve sınıf içi oyunlara eriş."
>
  <main class="auth">
    <h1>Giriş Yap</h1>
    <p style="color: var(--ink-soft); margin-top: -8px;">
      Hesabınla devam et.
    </p>

    <div id="signin-feedback" aria-live="polite"></div>

    <form id="signin-form" novalidate>
      <div class="field">
        <label for="email">E-posta</label>
        <input type="email" id="email" name="email" required autocomplete="email" />
      </div>

      <div class="field">
        <label for="password">Şifre</label>
        <input type="password" id="password" name="password" required autocomplete="current-password" />
      </div>

      <button class="btn primary" type="submit" style="width: 100%;" id="signin-submit">Giriş Yap</button>
    </form>

    <p class="alt">
      Hesabın yok mu? <a href="/signup">Kayıt ol</a>
    </p>
  </main>
</Layout>

<script is:inline>
  (function () {
    var form = document.getElementById('signin-form');
    if (!form) return;
    var feedback = document.getElementById('signin-feedback');
    var submitBtn = document.getElementById('signin-submit');

    form.addEventListener('submit', function (e) {
      e.preventDefault();

      var email = document.getElementById('email').value;
      var password = document.getElementById('password').value;

      submitBtn.disabled = true;
      submitBtn.textContent = 'Giriş yapılıyor…';

      fetch(location.pathname + '?_action=signin', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: email, password: password }),
      })
        .then(function (res) {
          return res.json().catch(function () {
            return null;
          });
        })
        .then(function (result) {
          if (result && result.data && result.data.ok) {
            window.location.href = '/dashboard';
            return;
          }

          submitBtn.disabled = false;
          submitBtn.textContent = 'Giriş Yap';

          var message = 'Giriş başarısız. Bilgilerini kontrol et.';
          if (result && result.error) {
            if (result.error.fields) {
              var fieldErrors = [];
              Object.keys(result.error.fields).forEach(function (key) {
                fieldErrors = fieldErrors.concat(result.error.fields[key]);
              });
              if (fieldErrors.length) {
                message = fieldErrors.join(' ');
              } else {
                message = result.error.message || message;
              }
            } else {
              message = result.error.message || message;
            }
          }
          feedback.innerHTML =
            '<div class="alert error" role="alert">' + message.replace(/[<>&"]/g, '') + '</div>';
        })
        .catch(function () {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Giriş Yap';
          feedback.innerHTML =
            '<div class="alert error" role="alert">Giriş sırasında bir hata oluştu. Lütfen tekrar dene.</div>';
        });
    });
  })();
</script>