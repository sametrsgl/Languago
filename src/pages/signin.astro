---
import Layout from '../layouts/Layout.astro';
import { actions, isInputError } from 'astro:actions';
import { createSupabaseClient, pageCookieSource } from '../lib/supabase';

let error: string | undefined;

// Native form submission (accept:'form') — Astro runs the action in the
// middleware and exposes the result here via getActionResult.
const result = Astro.getActionResult(actions.signin);

if (result?.error) {
  if (isInputError(result.error)) {
    error = Object.values(result.error.fields).flat().join(' ');
  } else {
    error = result.error.message ?? 'Giriş başarısız. Bilgilerini kontrol et.';
  }
} else if (result?.data?.ok) {
  return Astro.redirect('/dashboard');
}

// Already authenticated (e.g. visiting logged-in from another page)?
// Send straight to the dashboard.
const supabase = createSupabaseClient(pageCookieSource(Astro));
if (supabase) {
  const { data } = await supabase.auth.getUser();
  if (data.user) {
    return Astro.redirect('/dashboard');
  }
}
---

<Layout
  title="Giriş Yap — Languago"
  description="Languago hesabına giriş yap; derslerine, ilerlemene ve sınıf içi oyunlara eriş."
>
  <main class="auth">
    <h1>Giriş Yap</h1>
    <p style="color: var(--ink-soft); margin-top: -8px;">
      Hesabınla devam et.
    </p>

    {error && <div class="alert error" role="alert">{error}</div>}

    <form method="POST" action={actions.signin}>
      <div class="field">
        <label for="email">E-posta</label>
        <input type="email" id="email" name="email" required autocomplete="email" />
      </div>

      <div class="field">
        <label for="password">Şifre</label>
        <input type="password" id="password" name="password" required autocomplete="current-password" />
      </div>

      <button class="btn primary" type="submit" style="width: 100%;">Giriş Yap</button>
    </form>

    <p class="alt">
      Hesabın yok mu? <a href="/signup">Kayıt ol</a>
    </p>
  </main>
</Layout>