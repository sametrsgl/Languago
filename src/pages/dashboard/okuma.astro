---
import AppLayout from '../../layouts/AppLayout.astro';
import { getSessionUser } from '../../lib/auth';
import { pageCookieSource } from '../../lib/supabase';
import { READING_LEVELS } from '../../lib/study';

const user = await getSessionUser(pageCookieSource(Astro));
if (!user) return Astro.redirect('/signin');
---

<AppLayout title="Okuma — Languago" description="Seviyene uygun okuma metinleri ve anlama soruları.">
  <main class="study">
    <nav class="crumb">
      <a class="back" href="/dashboard">← Öğrenci Paneli</a>
      <span class="sep">›</span>
      <span class="cur">Okuma</span>
    </nav>
    <h1>Okuma 📖</h1>
    <p class="muted">Bir seviye veya sınav tipi seç, metin seç, oku ve anlama sorularını çöz.</p>
    <div class="barline"></div>

    <div class="tiles">
      {
        READING_LEVELS.map((lvl) => (
          <a class="tile" style="border-top:4px solid var(--brand);" href={`/dashboard/okuma/${lvl.key}`}>
            <div class="tt">{lvl.label}</div>
            <div class="bb">Okuma metinleri</div>
          </a>
        ))
      }
    </div>
  </main>
</AppLayout>