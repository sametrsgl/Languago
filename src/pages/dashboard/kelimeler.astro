---
import AppLayout from '../../layouts/AppLayout.astro';
import { getSessionUser } from '../../lib/auth';
import { pageCookieSource } from '../../lib/supabase';
import { VOCAB_SETS } from '../../lib/study';
import { readProgress, payloadStr } from '../../lib/progress';
import '../../styles/vocab.css'; // scoped Tailwind v4 (theme + utilities only — no preflight)

// Protected route.
const user = await getSessionUser(pageCookieSource(Astro));
if (!user) return Astro.redirect('/signin');

// Lazy-load the ~1.3 MB vocabulary module only on this page, keeping it out
// of the initial client bundle and the other routes' server chunks.
const { WORD_DATA } = await import('../../data/words.js');

const sets = VOCAB_SETS.map((s) => ({
  ...s,
  count: (WORD_DATA.sets as Record<string, string[]>)[s.key]?.length ?? 0,
}));

// index word -> the set(s) it belongs to (a word can appear in several sets).
const byLevel: Record<string, string[]> = {};
for (const [lvl, keys] of Object.entries(WORD_DATA.sets as Record<string, string[]>)) {
  for (const k of keys) {
    (byLevel[k] ||= []).push(lvl);
  }
}

const items = Object.values(WORD_DATA.words).map((w: any) => ({
  w: w.w,
  p: w.p,
  d: w.d,
  e: w.e,
  i: w.i,
  t: w.t,
  lv: byLevel[w.w] || [],
}));
// Escape "<" so the JSON can never break out of its <script> tag.
const vocabJson = JSON.stringify(items).replace(/</g, '\\u003c');
const setMetaJson = JSON.stringify(sets).replace(/</g, '\\u003c');

// Best-effort "where you left off": latest vocab progress row for the signed-in
// student. Never crashes — `payloadStr`/`readProgress` are guarded.
const vocabProgress = await readProgress(pageCookieSource(Astro), 'vocab');
const resumeWord = payloadStr(vocabProgress, 'lastWord');
const resumeSet = payloadStr(vocabProgress, 'set', 'lastSet');
// Only auto-select a set if it's a real, known set key.
const resumeSetKey = sets.some((s) => s.key === resumeSet) ? resumeSet : '';
// Signed-in user id — used to key the per-user Favorites in localStorage.
const userId = user?.id ?? '';

// Level badge accent colors (gamified), mirrored in the client script.
const LV_CLR: Record<string, string> = {
  a1: 'bg-emerald-500', a2: 'bg-teal-500', b1: 'bg-sky-500', b2: 'bg-indigo-500',
  c1: 'bg-violet-500', c2: 'bg-fuchsia-500', ielts: 'bg-amber-500',
  toefl: 'bg-rose-500', yokdil: 'bg-cyan-600', yds: 'bg-orange-500', gre: 'bg-slate-500',
};
const POS_TR: Record<string, string> = {
  noun: 'isim', verb: 'fiil', adjective: 'sıfat', adverb: 'zarf',
  preposition: 'edat', conjunction: 'bağlaç', pronoun: 'zamir',
  interjection: 'ünlem', determiner: 'belirteç', modal: 'kip fiili',
  article: 'artikel', phrase: 'ifade',
};

// Server-render the default view (Tümü, first 120) so the page is visible
// even with JS disabled; the client script rebuilds an interactive grid.
const ssrItems = items.slice(0, 120);
const levelLabel = (lv: string) => sets.find((s) => s.key === lv)?.label ?? lv;
---

<AppLayout title="Kelime Kartları — Languago" description="Kelime kartlarıyla çalış, ara, sesli dinle ve favorilerine ekle.">
  <main class="study kv-wide">
    <nav class="crumb">
      <a class="back" href="/dashboard">← Öğrenci Paneli</a>
      <span class="sep">›</span>
      <span class="cur">Kelime</span>
    </nav>

    <header class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <h1 class="m-0 text-ink">Kelime Kartları <span class="align-middle">🪪</span></h1>
        <p class="muted mt-2 mb-0">
          {items.length.toLocaleString('tr-TR')} kelime · Karta tıkla / <kbd class="kv-kbd">Enter</kbd> ile çevir,
          🔊 ile dinle, ⭐ ile favorine ekle.
        </p>
      </div>
      <span class="flex items-center gap-1 rounded-full bg-primary-soft px-3 py-1 text-xs font-bold text-primary-deep">
        🗂️ {sets.length} set
      </span>
    </header>
    <div class="barline"></div>

    {resumeWord && (
      <div class="resume" id="resume" data-word={resumeWord}>
        <span class="resume-ico">🗂️</span>
        <span class="resume-txt">
          Kaldığın yer: <span class="resume-word">{resumeWord}</span> —
          öğrenmeye devam et!
        </span>
        <button type="button" class="go" data-go>Devam et →</button>
      </div>
    )}

    <!-- Two-column responsive grid: sticky level/set sidebar (lg+) + main column -->
    <div class="kv-grid mt-5 lg:grid lg:grid-cols-[250px_1fr] lg:gap-6">

      <!-- LEFT · sticky level/set filters (collapses to wrapped chips on mobile) -->
      <aside class="lg:sticky lg:top-[84px] lg:self-start lg:max-h-[calc(100vh-110px)] lg:overflow-y-auto lg:pr-1">
        <h2 class="mb-2 mt-0 text-[0.72rem] font-extrabold uppercase tracking-wider text-ink-soft">
          Setler &amp; Seviyeler
        </h2>
        <div id="setlist" class="flex flex-wrap gap-2 lg:flex-col lg:gap-1.5">
          <button type="button" data-set-key="all"
            class="kv-set-btn on flex items-center justify-between gap-2 rounded-xl border border-primary/30 bg-primary px-3 py-2 text-left text-sm font-bold text-white shadow-sm transition hover:-translate-y-px hover:shadow">
            <span>Tümü</span>
            <span class="rounded-full bg-white/25 px-2 py-0.5 text-xs font-bold tabular-nums">
              {items.length.toLocaleString('tr-TR')}
            </span>
          </button>
          {sets.map((s) => (
            <button type="button" data-set-key={s.key}
              class="kv-set-btn flex items-center justify-between gap-2 rounded-xl border border-line bg-white px-3 py-2 text-left text-sm font-semibold text-ink-soft transition hover:-translate-y-px hover:border-primary hover:text-primary-deep hover:shadow">
              <span>{s.label}</span>
              <span class="rounded-full bg-bg-soft px-2 py-0.5 text-xs tabular-nums text-ink-soft">
                {s.count.toLocaleString('tr-TR')}
              </span>
            </button>
          ))}
        </div>
        <noscript>
          <p class="mt-3 text-sm text-ink-soft">Kartları görmek için lütfen JavaScript'i etkinleştir.</p>
        </noscript>
      </aside>

      <!-- RIGHT · sticky toolbar + flashcard grid -->
      <section class="min-w-0">
        <!-- Sticky top toolbar: search + sort + Öğrenilmedi toggle -->
        <div class="sticky top-[72px] z-10 -mx-1 mb-3 rounded-2xl border border-line/80 bg-white/90 p-2 shadow-sm backdrop-blur sm:flex sm:items-center sm:gap-2">
          <label class="relative flex flex-1 items-center">
            <span class="pointer-events-none absolute left-3 text-ink-soft" aria-hidden="true">🔍</span>
            <input
              id="search"
              type="search"
              placeholder="İngilizce kelime veya Türkçe anlam ara…"
              autocomplete="off"
              aria-label="Kelime veya Türkçe anlam ara"
              class="w-full rounded-xl border border-line bg-white py-2.5 pl-9 pr-3 text-sm text-ink outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/30"
            />
          </label>

          <label class="mt-2 flex items-center gap-1 text-xs font-semibold text-ink-soft sm:mt-0">
            <span aria-hidden="true">↕</span>
            <span class="sr-only">Sıralama</span>
            <select
              id="sort"
              aria-label="Sıralama ölçütü"
              class="rounded-xl border border-line bg-white px-2.5 py-2.5 text-sm text-ink outline-none focus:border-primary focus:ring-2 focus:ring-primary/30"
            >
              <option value="default">Sırala: Varsayılan</option>
              <option value="az">Alfabetik A→Z</option>
              <option value="za">Alfabetik Z→A</option>
            </select>
          </label>

          <button
            type="button"
            id="unlearned"
            aria-pressed="false"
            class="mt-2 flex items-center gap-1.5 rounded-xl border border-line bg-white px-3 py-2.5 text-sm font-semibold text-ink-soft transition hover:border-brand hover:text-brand-deep sm:mt-0"
          >
            <span aria-hidden="true">🎯</span> Öğrenilmedi
          </button>
        </div>

        <div id="countline" class="mb-2 px-1 text-xs font-semibold text-ink-soft" role="status"></div>

        <!-- 20-word set progression: pager + progress bar -->
        <div id="setpanel" class="mb-3"></div>

        <!-- Flashcard grid --->
        <div id="flashgrid" class="grid gap-4 [grid-template-columns:repeat(auto-fill,minmax(220px,1fr))]">
          <!-- server-rendered default view (no-JS fallback); client rebuilds -->
          {ssrItems.map((w) => {
            const pos = POS_TR[w.p] || w.p || '';
            const lvcls = (w.lv as string[]).slice(0, 3);
            return (
              <div class="kv-card group rounded-2xl border border-line bg-white p-3 shadow-sm outline-none transition hover:-translate-y-0.5 hover:border-primary hover:shadow-lg focus-visible:ring-2 focus-visible:ring-primary/60"
                data-w={w.w} tabindex="0" role="button"
                aria-label={`${w.w} — kartı çevirmek için Enter veya tıkla`}>
                <div class="kv-card-inner min-h-[190px]">
                  {/* FRONT */}
                  <div class="kv-face kv-front flex flex-col">
                    <div class="mb-2 flex flex-wrap items-center gap-1.5">
                      <span class="rounded-full bg-primary px-2.5 py-0.5 text-[0.7rem] font-bold text-white">{pos}</span>
                      {lvcls.map((lv) => (
                        <span class={`rounded-full ${LV_CLR[lv] || 'bg-slate-400'} px-2 py-0.5 text-[0.65rem] font-bold text-white`}>{levelLabel(lv)}</span>
                      ))}
                    </div>
                    <div class="text-[clamp(1.35rem,3vw,1.9rem)] font-extrabold capitalize leading-tight text-ink">{w.w}</div>
                    {w.i && <div class="mt-1 font-mono text-sm text-ink-soft/80">{w.i}</div>}
                    <span class="mt-auto inline-flex items-center gap-1 self-start rounded-full bg-bg-soft px-2.5 py-1 text-[0.7rem] font-bold text-ink-soft">
                      ⟳ Tıkla · Çevir
                    </span>
                  </div>
                  {/* BACK */}
                  <div class="kv-face kv-back flex flex-col">
                    <div class="mb-2 flex flex-wrap items-center gap-1.5">
                      {lvcls.map((lv) => (
                        <span class={`rounded-full ${LV_CLR[lv] || 'bg-slate-400'} px-2 py-0.5 text-[0.65rem] font-bold text-white`}>{levelLabel(lv)}</span>
                      ))}
                    </div>
                    <div class="text-lg font-extrabold leading-snug text-primary-deep">🇹🇷 {w.t}</div>
                    {w.i && <div class="mt-0.5 font-mono text-xs text-ink-soft/70">{w.i}</div>}
                    <div class="mt-2 text-sm font-semibold text-ink">
                      <span class="mr-1 text-[0.62rem] font-extrabold uppercase tracking-wide text-primary">Tanım</span>
                      <span class="block text-ink-soft">{w.d}</span>
                    </div>
                    {w.e && (
                      <div class="mt-2 border-l-[3px] border-primary pl-2 text-[0.85rem] italic text-ink-soft">
                        {w.e}
                      </div>
                    )}
                  </div>
                </div>
                {/* action buttons (unaffected by flip) */}
                <div class="mt-2 flex items-center gap-1.5 border-t border-line/70 pt-2">
                  <button type="button" data-play data-w={w.w}
                    class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-line bg-white text-base transition hover:border-primary hover:bg-primary-soft"
                    aria-label={`${w.w} kelimesini sesli oku`}>🔊</button>
                  <button type="button" data-fav data-w={w.w} aria-pressed="false"
                    class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-line bg-white text-base transition hover:border-brand hover:bg-amber-50"
                    aria-label={`${w.w} kelimesini favorilere ekle`}>☆</button>
                  <span class="ml-auto text-[0.65rem] font-semibold text-ink-soft hidden sm:inline">Languago · Kelime</span>
                </div>
              </div>
            );
          })}
        </div>

        <div id="empty" hidden class="empty mt-6 rounded-2xl border border-dashed border-line bg-bg-soft p-10 text-center text-ink-soft">
          <div class="text-3xl">🤔</div>
          <div class="mt-2 font-semibold text-ink">Sonuç bulunamadı</div>
          <div class="text-sm">Farklı bir kelime dene ya da set değiştir.</div>
        </div>
      </section>
    </div>

    <script is:inline id="vocab-meta" type="application/json" set:html={setMetaJson}></script>
    <script is:inline id="vocab-data" type="application/json" set:html={vocabJson}></script>

    <script define:vars={{ resumeWord, resumeSetKey, userId }}>
      (function () {
        function getJson(id) {
          var el = document.getElementById(id);
          if (!el || !el.textContent) return null;
          try { return JSON.parse(el.textContent); } catch (e) { return null; }
        }
        var words = getJson('vocab-data') || [];
        var sets = getJson('vocab-meta') || [];
        var byW = {};
        words.forEach(function (w) { byW[w.w] = w; });

        var badgeLabels = {};
        sets.forEach(function (s) { badgeLabels[s.key] = s.label; });
        var LV_CLR = {
          a1: 'bg-emerald-500', a2: 'bg-teal-500', b1: 'bg-sky-500', b2: 'bg-indigo-500',
          c1: 'bg-violet-500', c2: 'bg-fuchsia-500', ielts: 'bg-amber-500',
          toefl: 'bg-rose-500', yokdil: 'bg-cyan-600', yds: 'bg-orange-500', gre: 'bg-slate-500'
        };
        var POS_TR = { noun: 'isim', verb: 'fiil', adjective: 'sıfat', adverb: 'zarf', preposition: 'edat', conjunction: 'bağlaç', pronoun: 'zamir', interjection: 'ünlem', determiner: 'belirteç', modal: 'kip fiili', article: 'artikel', phrase: 'ifade' };

        var grid = document.getElementById('flashgrid');
        var countEl = document.getElementById('countline');
        var setPanEl = document.getElementById('setpanel');
        var emptyEl = document.getElementById('empty');
        var searchEl = document.getElementById('search');
        var sortEl = document.getElementById('sort');
        var unlearnedEl = document.getElementById('unlearned');

        var activeSet = 'all';
        var query = '';
        var sortOrder = 'default';
        var onlyUnlearned = false;
        var viewed = {};
        var lastSet = 'all';
        var RESULT_CAP = 200;

        /* ---------- 20-word SET PROGRESSION ---------- */
        var SET_SIZE = 20;
        var uid = userId || 'anon';
        // Persisted per-level set progress + current set (survives reload).
        var progKey = 'languago_setprog_' + uid;   // { level: { setIdx: count } }
        var curKey  = 'languago_curset_' + uid;     // { level: setIdx }
        var setProg = {};
        var setCur  = {};
        (function loadSetState() {
          try { setProg = JSON.parse(localStorage.getItem(progKey) || '{}') || {}; } catch (e) { setProg = {}; }
          try { setCur  = JSON.parse(localStorage.getItem(curKey)  || '{}') || {}; } catch (e) { setCur = {}; }
        })();
        function persistSetState() {
          try { localStorage.setItem(progKey, JSON.stringify(setProg)); } catch (e) {}
          try { localStorage.setItem(curKey,  JSON.stringify(setCur));  } catch (e) {}
        }
        function levelSetProg(lvl) { return (setProg[lvl] = setProg[lvl] || {}); }
        function setCountFor(lvl, idx) { return levelSetProg(lvl)[idx] || 0; }
        function setDoneFor(chunk, count) { return count >= chunk.length; }
        // First incomplete set index for a level (from all its chunks' saved counts).
        function firstIncomplete(lvl, totalSets) {
          var prog = setProg[lvl] || {};
          for (var i = 0; i < totalSets; i++) if (!prog[i] || prog[i] < SET_SIZE) return i;
          return 0;
        }

        /* ---------- Deterministic per-level shuffle + part-of-speech units ---------- */
        // Fixed PoS bucket order → each set becomes a themed unit. Anything not in
        // this list (interjection, determiner, modal, article, phrase…) falls into
        // a catch-all "other" bucket that drains last.
        var POS_ORDER = ['noun', 'verb', 'adjective', 'adverb', 'pronoun', 'preposition', 'conjunction'];
        var POS_UNIT_TR = { noun: 'İsimler', verb: 'Fiiller', adjective: 'Sıfatlar', adverb: 'Zarflar', pronoun: 'Zamirler', preposition: 'Edatlar', conjunction: 'Bağlaçlar', other: 'Diğer' };
        // FNV-1a 32-bit hash → stable 32-bit seed per scope key.
        function hashSeed(str) {
          var h = 2166136261;
          for (var i = 0; i < str.length; i++) {
            h ^= str.charCodeAt(i);
            h = Math.imul(h, 16777619);
          }
          return h >>> 0;
        }
        // mulberry32 PRNG — small, fast, deterministic given the same seed.
        function mulberry32(a) {
          return function () {
            a |= 0; a = (a + 0x6D2B79F5) | 0;
            var t = Math.imul(a ^ (a >>> 15), 1 | a);
            t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
            return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
          };
        }
        function shuffleArr(arr, seed) {
          var rng = mulberry32(hashSeed(seed));
          var a = arr.slice();
          for (var i = a.length - 1; i > 0; i--) {
            var j = Math.floor(rng() * (i + 1));
            var t = a[i]; a[i] = a[j]; a[j] = t;
          }
          return a;
        }
        // Memoized deterministic "unit" order for a scope (level key or 'all').
        // Grouped by PoS (fixed bucket order), shuffled within each bucket using a
        // seed that embeds the level key, so every level has a different but STABLE
        // set of 20-word sets across reloads (persisted set progress stays valid).
        var orderedCache = {};
        function orderedForLevel(lvl) {
          if (orderedCache[lvl]) return orderedCache[lvl];
          var buckets = {};
          POS_ORDER.forEach(function (p) { buckets[p] = []; });
          buckets.other = [];
          for (var i = 0; i < words.length; i++) {
            var w = words[i];
            if (lvl !== 'all' && (w.lv || []).indexOf(lvl) === -1) continue;
            var pos = w.p || 'other';
            (buckets[pos] || buckets.other).push(w);
          }
          var out = [];
          var keys = POS_ORDER.concat(['other']);
          for (var k = 0; k < keys.length; k++) {
            var key = keys[k];
            if (buckets[key].length) out = out.concat(shuffleArr(buckets[key], lvl + '::' + key));
          }
          orderedCache[lvl] = out;
          return out;
        }
        // Label a set by its dominant part of speech when >= 80% of its words share
        // one PoS (themed unit); otherwise return '' so just "Set N" is shown.
        function setUnitLabel(chunk) {
          var counts = {}, total = chunk.length, best = null, bestN = 0;
          if (!total) return '';
          chunk.forEach(function (w) { var p = w.p || 'other'; counts[p] = (counts[p] || 0) + 1; });
          for (var p in counts) { if (counts[p] > bestN) { bestN = counts[p]; best = p; } }
          return (best && bestN / total >= 0.8 && POS_UNIT_TR[best]) ? POS_UNIT_TR[best] : '';
        }

        function esc(s) {
          var d = document.createElement('div');
          d.textContent = s == null ? '' : String(s);
          return d.innerHTML;
        }

        /* ---------- Favorites (localStorage, keyed by user id) ---------- */
        var favKey = 'languago_favs_' + (userId || 'anon');
        var favs = {};
        (function loadFavs() {
          try {
            var arr = JSON.parse(localStorage.getItem(favKey) || '[]');
            if (Array.isArray(arr)) arr.forEach(function (w) { favs[w] = true; });
          } catch (e) {}
        })();
        function toggleFav(w, btn) {
          if (favs[w]) { delete favs[w]; }
          else { favs[w] = true; }
          try { localStorage.setItem(favKey, JSON.stringify(Object.keys(favs))); } catch (e) {}
          if (btn) {
            var on = !!favs[w];
            btn.setAttribute('aria-label', (on ? '' : 'favorilere ekle: ') + w);
            btn.setAttribute('aria-pressed', on ? 'true' : 'false');
            btn.textContent = on ? '★' : '☆';
            btn.classList.toggle('is-fav', on);
          }
          if (onlyUnlearned) render();
        }

        /* ---------- Audio (Web Speech API) ---------- */
        function speak(word) {
          try {
            if (!('speechSynthesis' in window)) return;
            window.speechSynthesis.cancel();
            var u = new SpeechSynthesisUtterance(word);
            u.lang = 'en-US';
            u.rate = 0.92;
            window.speechSynthesis.speak(u);
          } catch (e) {}
        }

        /* ---------- Progress (same contract as before) ---------- */
        function saveProgress(w) {
          try {
            fetch('/dashboard/progress', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({
                module: 'vocab',
                payload: {
                  set: lastSet,
                  lastWord: w.w,
                  viewedWords: Object.keys(viewed),
                  viewedCount: Object.keys(viewed).length,
                },
              }),
            }).catch(function () {});
          } catch (e) {}
        }
        function opened(w) {
          if (!viewed[w.w]) viewed[w.w] = 1;
          else viewed[w.w] += 1;
          // Record 20-word-set progress for the current level + set (only in chunked mode).
          if (!query && activeSet !== 'all') {
            var lvl = activeSet;
            var idx = setCur[lvl] || 0;
            var prog = levelSetProg(lvl);
            prog[idx] = Math.min(prog[idx] || 0, 100000) + 1; // view count for this set
            persistSetState();
          }
          // Fire-and-forget progress upsert on every card open (guarded).
          saveProgress(w);
        }

        /* ---------- Card rendering ---------- */
        function badgeHtml(lv) {
          return '<span class="rounded-full ' + (LV_CLR[lv] || 'bg-slate-400') + ' px-2 py-0.5 text-[0.65rem] font-bold text-white">' + esc(badgeLabels[lv] || lv) + '</span>';
        }
        function cardHtml(w) {
          var pos = POS_TR[w.p] || w.p || '';
          var posHtml = pos ? '<span class="rounded-full bg-primary px-2.5 py-0.5 text-[0.7rem] font-bold text-white">' + esc(pos) + '</span>' : '';
          var lv = (w.lv || []).slice(0, 3);
          var lvHtml = lv.map(badgeHtml).join('');
          var fav = !!favs[w.w];
          return (
            '<div class="kv-card rounded-2xl border border-line bg-white p-3 shadow-sm outline-none transition hover:-translate-y-0.5 hover:border-primary hover:shadow-lg focus-visible:ring-2 focus-visible:ring-primary/60" data-w="' + esc(w.w) + '" tabindex="0" role="button" aria-label="' + esc(w.w) + ' — kartı çevirmek için Enter veya tıkla">' +
              '<div class="kv-card-inner min-h-[190px]">' +
                '<div class="kv-face kv-front flex flex-col">' +
                  '<div class="mb-2 flex flex-wrap items-center gap-1.5">' + posHtml + lvHtml + '</div>' +
                  '<div class="text-[clamp(1.35rem,3vw,1.9rem)] font-extrabold capitalize leading-tight text-ink">' + esc(w.w) + '</div>' +
                  (w.i ? '<div class="mt-1 font-mono text-sm text-ink-soft/80">' + esc(w.i) + '</div>' : '') +
                  '<span class="mt-auto inline-flex items-center gap-1 self-start rounded-full bg-bg-soft px-2.5 py-1 text-[0.7rem] font-bold text-ink-soft">⟳ Tıkla · Çevir</span>' +
                '</div>' +
                '<div class="kv-face kv-back flex flex-col">' +
                  '<div class="mb-2 flex flex-wrap items-center gap-1.5">' + lvHtml + '</div>' +
                  '<div class="text-lg font-extrabold leading-snug text-primary-deep">🇹🇷 ' + esc(w.t) + '</div>' +
                  (w.i ? '<div class="mt-0.5 font-mono text-xs text-ink-soft/70">' + esc(w.i) + '</div>' : '') +
                  '<div class="mt-2 text-sm font-semibold text-ink">' +
                    '<span class="mr-1 text-[0.62rem] font-extrabold uppercase tracking-wide text-primary">Tanım</span>' +
                    '<span class="block text-ink-soft">' + esc(w.d) + '</span>' +
                  '</div>' +
                  (w.e ? '<div class="mt-2 border-l-[3px] border-primary pl-2 text-[0.85rem] italic text-ink-soft">' + esc(w.e) + '</div>' : '') +
                '</div>' +
              '</div>' +
              '<div class="mt-2 flex items-center gap-1.5 border-t border-line/70 pt-2">' +
                '<button type="button" data-play data-w="' + esc(w.w) + '" class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-line bg-white text-base transition hover:border-primary hover:bg-primary-soft" aria-label="' + esc(w.w) + ' kelimesini sesli oku">🔊</button>' +
                '<button type="button" data-fav data-w="' + esc(w.w) + '" aria-pressed="' + (fav ? 'true' : 'false') + '" class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-line bg-white text-base transition hover:border-brand hover:bg-amber-50 ' + (fav ? 'is-fav border-brand bg-amber-50' : '') + '" aria-label="' + esc(w.w) + (fav ? ' favorilerden çıkar' : ' kelimesini favorilere ekle') + '">' + (fav ? '★' : '☆') + '</button>' +
                '<span class="ml-auto hidden text-[0.65rem] font-semibold text-ink-soft sm:inline">Languago · Kelime</span>' +
              '</div>' +
            '</div>'
          );
        }

        function flipCard(card) {
          var flipped = card.classList.toggle('is-flipped');
          var w = card.getAttribute('data-w');
          if (flipped && w) {
            var wo = byW[w];
            if (wo) opened(wo);
          }
        }

        function currentSetInfo(list) {
          // list = the filtered word array for the active level (chunked mode).
          var totalSets = Math.max(1, Math.ceil(list.length / SET_SIZE));
          var lvl = activeSet;
          var idx = setCur[lvl] || 0;
          if (idx >= totalSets) idx = 0;
          setCur[lvl] = idx;
          var chunk = list.slice(idx * SET_SIZE, idx * SET_SIZE + SET_SIZE);
          var doneCount = setCountFor(lvl, idx);
          return { totalSets: totalSets, idx: idx, chunk: chunk, doneCount: doneCount };
        }

        function render() {
          var q = query.trim().toLowerCase();
          var searching = !!q;
          var list = [];

          // Base word order for the active scope: non-search views use the
          // deterministic PoS-grouped + per-level-shuffled order (stable across
          // reloads, so persisted set progress stays meaningful). Search bypasses
          // this entirely and filters the untouched data order (full scope, then
          // az/za sort below).
          var base = searching ? words : orderedForLevel(activeSet);
          // Build the filtered list for the selected scope (level or 'all'), no cap yet.
          for (var i = 0; i < base.length; i++) {
            var w = base[i];
            if (activeSet !== 'all' && (w.lv || []).indexOf(activeSet) === -1) continue;
            if (q && !((w.w && w.w.toLowerCase().indexOf(q) !== -1) || (w.t && w.t.toLowerCase().indexOf(q) !== -1))) continue;
            if (onlyUnlearned && (favs[w.w] || viewed[w.w])) continue;
            list.push(w);
          }
          if (sortOrder === 'az') list.sort(function (a, b) { return a.w.localeCompare(b.w); });
          else if (sortOrder === 'za') list.sort(function (a, b) { return b.w.localeCompare(a.w); });
          var total = list.length;

          // Decide the slice to render.
          var out, setInfo = null;
          if (searching) {
            out = list.slice(0, RESULT_CAP); // search bypasses sets (cap for perf)
          } else {
            setInfo = currentSetInfo(list);
            out = setInfo.chunk;
          }

          var extra = '';
          if (setInfo && total === 0) {
            extra = '';
          } else if (setInfo) {
            var done = setDoneFor(out, setInfo.doneCount) || setInfo.doneCount >= out.length;
            var pct = out.length ? Math.min(100, Math.round((setInfo.doneCount / out.length) * 100)) : 0;
            var shownTotal = (setInfo.idx + 1) + ' / ' + setInfo.totalSets;
            var unit = setUnitLabel(out);
            var chips = '';
            var firstN = Math.min(8, setInfo.totalSets);
            for (var c = 0; c < firstN; c++) {
              chips += '<button type="button" class="set-chip' + (c === setInfo.idx ? ' on' : '') + '" data-setidx="' + c + '" aria-label="Set ' + (c + 1) + '">' + (c + 1) + '</button>';
            }
            if (setInfo.totalSets > firstN) {
              if (setInfo.idx >= firstN) chips += '<span class="set-more">…</span><button type="button" class="set-chip' + (setInfo.idx === setInfo.totalSets - 1 ? ' on' : '') + '" data-setidx="' + (setInfo.totalSets - 1) + '" aria-label="Set ' + setInfo.totalSets + '">' + setInfo.totalSets + '</button>';
              else chips += '<span class="set-more">…</span><button type="button" class="set-chip" data-setidx="' + (setInfo.totalSets - 1) + '" aria-label="Set ' + setInfo.totalSets + '">' + setInfo.totalSets + '</button>';
            }
            extra = (
              '<div class="setprogress">' +
                '<div class="setline">' +
                  '<button type="button" class="set-prev" data-prev aria-label="Önceki set"' + (setInfo.idx === 0 ? ' disabled' : '') + '>← Önceki</button>' +
                  '<div class="setmeta">' +
                    '<div class="setlab">' + (unit ? '📚 ' + esc(unit) + ' · ' : '') + 'Set ' + shownTotal + ' <span class="set-sub">' + (setInfo.idx * SET_SIZE + 1) + '–' + (setInfo.idx * SET_SIZE + out.length) + ' / ' + total + ' kelime</span></div>' +
                    '<div class="set-chips">' + chips + '</div>' +
                  '</div>' +
                  '<button type="button" class="set-next" data-next aria-label="Sonraki set"' + (setInfo.idx === setInfo.totalSets - 1 ? ' disabled' : '') + '>Sonraki →</button>' +
                '</div>' +
                '<div class="setbar"><div class="setbar-fill" style="width:' + pct + '%"></div></div>' +
                '<div class="setcount">' + (done ? '✓ Tamamlandı! 🎉' : Math.min(setInfo.doneCount || 0, out.length) + ' / ' + out.length + ' kelimeye baktın · %' + pct) + '</div>' +
              '</div>'
            );
          }

          countEl.textContent = searching
            ? (out.length >= RESULT_CAP ? 'İlk ' + RESULT_CAP + ' sonuç gösteriliyor…' : total.toLocaleString('tr-TR') + ' sonuç')
            : (total.toLocaleString('tr-TR') + ' kelime · Set ' + (setInfo ? (setInfo.idx + 1) : 1) + '/' + (setInfo ? setInfo.totalSets : 1));
          emptyEl.hidden = out.length !== 0;
          setPanEl.innerHTML = extra || '';
          grid.textContent = '';
          var frag = document.createDocumentFragment();
          var tmp = document.createElement('div');
          out.forEach(function (w) {
            tmp.innerHTML = cardHtml(w);
            var node = tmp.firstElementChild;
            frag.appendChild(node);
          });
          grid.appendChild(frag);
        }

        /* ---------- Events ---------- */
        document.getElementById('setlist').addEventListener('click', function (e) {
          var b = e.target.closest('[data-set-key]');
          if (!b) return;
          var newKey = b.getAttribute('data-set-key');
          var changedLevel = newKey !== activeSet;
          activeSet = newKey;
          lastSet = activeSet === 'all' ? 'all' : activeSet;
          if (changedLevel) {
            // Reset search + sort so the level view is clean, and jump to the
            // first incomplete set for this level (best-effort).
            query = ''; searchEl.value = ''; unlearnedEl.setAttribute('aria-pressed', 'false'); onlyUnlearned = false;
            var list = [];
            for (var li = 0; li < words.length; li++) {
              var ww = words[li];
              if (activeSet !== 'all' && (ww.lv || []).indexOf(activeSet) === -1) continue;
              list.push(ww);
            }
            var totalSets = Math.max(1, Math.ceil(list.length / SET_SIZE));
            setCur[activeSet] = firstIncomplete(activeSet, totalSets);
            persistSetState();
          }
          document.querySelectorAll('#setlist .kv-set-btn').forEach(function (c) {
            var on = c === b;
            c.classList.toggle('on', on);
            c.classList.toggle('bg-primary', on);
            c.classList.toggle('text-white', on);
            c.classList.toggle('border-primary/30', on);
            c.classList.toggle('border-line', !on);
            c.classList.toggle('text-ink-soft', !on);
          });
          render();
        });

        // Set pager + chips (delegated on the set panel).
        setPanEl.addEventListener('click', function (e) {
          var chip = e.target.closest('[data-setidx]');
          if (chip) {
            setCur[activeSet] = parseInt(chip.getAttribute('data-setidx'), 10) || 0;
            persistSetState();
            render();
            return;
          }
          var prev = e.target.closest('[data-prev]');
          if (prev && !prev.disabled) {
            var i1 = (setCur[activeSet] || 0) - 1;
            setCur[activeSet] = i1 < 0 ? 0 : i1;
            persistSetState(); render(); return;
          }
          var next = e.target.closest('[data-next]');
          if (next && !next.disabled) {
            var list = [];
            for (var ni = 0; ni < words.length; ni++) {
              var nw = words[ni];
              if (activeSet !== 'all' && (nw.lv || []).indexOf(activeSet) === -1) continue;
              list.push(nw);
            }
            var totalSets = Math.max(1, Math.ceil(list.length / SET_SIZE));
            var i2 = (setCur[activeSet] || 0) + 1;
            setCur[activeSet] = i2 >= totalSets ? totalSets - 1 : i2;
            persistSetState(); render(); return;
          }
        });

        searchEl.addEventListener('input', function () { query = searchEl.value; render(); });
        sortEl.addEventListener('change', function () { sortOrder = sortEl.value; render(); });

        unlearnedEl.addEventListener('click', function () {
          onlyUnlearned = !onlyUnlearned;
          unlearnedEl.setAttribute('aria-pressed', onlyUnlearned ? 'true' : 'false');
          unlearnedEl.classList.toggle('bg-brand', onlyUnlearned);
          unlearnedEl.classList.toggle('text-white', onlyUnlearned);
          unlearnedEl.classList.toggle('border-brand', onlyUnlearned);
          render();
        });

        grid.addEventListener('click', function (e) {
          var t = e.target;
          var play = t.closest('[data-play]');
          if (play) { speak(play.getAttribute('data-w')); e.stopPropagation(); return; }
          var fav = t.closest('[data-fav]');
          if (fav) { toggleFav(fav.getAttribute('data-w'), fav); e.stopPropagation(); return; }
          var card = t.closest('.kv-card');
          if (card) flipCard(card);
        });

        grid.addEventListener('keydown', function (e) {
          if (e.key !== 'Enter' && e.key !== ' ') return;
          if (e.target.closest && e.target.closest('button, input, select')) return;
          var card = e.target.closest && e.target.closest('.kv-card');
          if (card) { e.preventDefault(); flipCard(card); }
        });

        // Auto-select the last studied set (best-effort), if provided.
        if (resumeSetKey) {
          activeSet = resumeSetKey;
          lastSet = resumeSetKey;
          document.querySelectorAll('#setlist .kv-set-btn').forEach(function (c) {
            var on = c.getAttribute('data-set-key') === resumeSetKey;
            c.classList.toggle('on', on);
            c.classList.toggle('bg-primary', on);
            c.classList.toggle('text-white', on);
            c.classList.toggle('border-primary/30', on);
            c.classList.toggle('border-line', !on);
            c.classList.toggle('text-ink-soft', !on);
          });
        }

        // "Kaldığın yerden devam et" banner → reopen last viewed word.
        var resumeEl = document.getElementById('resume');
        if (resumeEl && resumeWord) {
          resumeEl.addEventListener('click', function (e) {
            var go = e.target.closest('[data-go]');
            if (!go) return;
            if (!byW[resumeWord]) return;
            if (!viewed[resumeWord] || activeSetIsMissing(resumeWord)) {
              activeSet = 'all'; query = ''; sortOrder = 'default'; onlyUnlearned = false;
              searchEl.value = '';
              render();
            }
            var card = null;
            var cards = grid.querySelectorAll('.kv-card');
            for (var i = 0; i < cards.length; i++) {
              if (cards[i].getAttribute('data-w') === resumeWord) { card = cards[i]; break; }
            }
            if (card) {
              card.classList.add('is-flipped');
              var wo = byW[resumeWord];
              if (wo) opened(wo);
              card.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
          });
        }
        function activeSetIsMissing(word) {
          if (activeSet === 'all') return false;
          return (byW[word] && byW[word].lv && byW[word].lv.indexOf(activeSet) === -1);
        }

        render();
      })();
    </script>
  </main>
</AppLayout>