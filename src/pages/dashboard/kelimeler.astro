---
import AppLayout from '../../layouts/AppLayout.astro';
import { getSessionUser } from '../../lib/auth';
import { pageCookieSource } from '../../lib/supabase';
import { WORD_DATA } from '../../data/words.js';
import { createVocabularyDiagnostic, recordsFromWordData } from '../../lib/vocab-path.mjs';

const user = await getSessionUser(pageCookieSource(Astro));
if (!user) return Astro.redirect('/signin');

const diagnostic = createVocabularyDiagnostic(recordsFromWordData(WORD_DATA));
const publicDiagnostic = diagnostic.map(({ answer: _answer, ...question }) => question);
const diagnosticJson = JSON.stringify(publicDiagnostic).replace(/</g, '\\u003c');
---

<AppLayout title="Kişisel Kelime Yolu — Languago" description="Seviyeni ölç, sana özel kelime yolunda bağlamla öğren ve geri çağırma oyunlarıyla kalıcılaştır.">
  <main class="vocab-path-page">
    <nav class="crumb"><a class="back" href="/dashboard">← Öğrenci Paneli</a><span class="sep">›</span><span class="cur">Kişisel Kelime Yolu</span></nav>

    <header class="path-hero">
      <div>
        <p class="eyebrow">Kelimeler artık liste değil, öğrenme yolu</p>
        <h1>Kelimeleri gerçekten kullanarak öğren.</h1>
        <p class="path-lead">Önce 80 soruluk kelime tanılamasıyla başlangıç seviyeni ölçelim. Sonra sana özel 10 adımlı bir yol açalım: bağlam, eşleştirme, geri çağırma, kısa okuma ve gerçek hayat görevleri.</p>
      </div>
      <div class="method-card" aria-label="Öğrenme ilkeleri">
        <strong>Yolun dört ayağı</strong>
        <span>Gör · Geri çağır · Kullan · Aralıklı tekrar et</span>
      </div>
    </header>

    <section id="diagnostic-card" class="path-card" aria-labelledby="diagnostic-title">
      <div class="path-card__head">
        <div><p class="eyebrow">1 · Başlangıç haritası</p><h2 id="diagnostic-title">80 soruluk kelime testi</h2></div>
        <span class="status-pill" id="diagnostic-level">A1 → C2</span>
      </div>
      <p class="muted">Sorular kolaydan zora ilerler. Sonuç tek bir kelimeyi bilip bilmediğine değil, her CEFR bandındaki kanıtına göre hesaplanır.</p>
      <div class="diagnostic-progress"><span id="diagnostic-progress-bar"></span></div>
      <div id="diagnostic-body">
        <button class="btn primary" type="button" id="diagnostic-start">80 soruluk testi başlat</button>
        <span class="muted small">Yaklaşık 10–15 dakika · Sonucun hesabına kaydedilir.</span>
      </div>
    </section>

    <section id="path-card" class="path-card" hidden aria-labelledby="path-title">
      <div class="path-card__head">
        <div><p class="eyebrow">2 · Sana özel rota</p><h2 id="path-title">Kişisel kelime yolu</h2></div>
        <span class="status-pill" id="path-level"></span>
      </div>
      <p id="path-intro" class="muted"></p>
      <div id="step-nav" class="step-nav" aria-label="10 adımlı kelime yolu"></div>
      <div id="step-workspace" class="step-workspace"></div>
    </section>

    <section class="research-note" aria-labelledby="method-title">
      <p class="eyebrow">Neden böyle?</p>
      <h2 id="method-title">Kart görmek yetmez.</h2>
      <p>Yol; anlam odaklı okuma, anlamlı üretim, dil odaklı çalışma ve akıcılık tekrarını dengeler. Her kelimeyi farklı bağlamlarda yeniden çağırman ve gerçek bir iletişim amacıyla kullanman beklenir.</p>
    </section>
  </main>
</AppLayout>

<script is:inline id="vocab-diagnostic" type="application/json" set:html={diagnosticJson}></script>

<script>
  import { buildMeaningOptions, learnerExample } from '../../lib/vocab-path.mjs';

  const diagnostic = JSON.parse(document.querySelector('#vocab-diagnostic')?.textContent || '[]');
  const startButton = document.querySelector('#diagnostic-start');
  const body = document.querySelector('#diagnostic-body');
  const progressBar = document.querySelector('#diagnostic-progress-bar');
  const diagnosticLevel = document.querySelector('#diagnostic-level');
  const pathCard = document.querySelector('#path-card');
  const pathLevel = document.querySelector('#path-level');
  const pathIntro = document.querySelector('#path-intro');
  const stepNav = document.querySelector('#step-nav');
  const workspace = document.querySelector('#step-workspace');
  let diagnosticIndex = 0;
  let answers = [];
  let path = null;
  let currentStep = 0;
  let completedSteps = [];

  function text(value) { return String(value ?? ''); }
  function esc(value) {
    const node = document.createElement('span');
    node.textContent = text(value);
    return node.innerHTML;
  }
  function button(label, className = 'btn ghost') {
    const el = document.createElement('button');
    el.type = 'button'; el.className = className; el.textContent = label;
    return el;
  }
  function savePathProgress() {
    fetch('/dashboard/progress', {
      method: 'POST', headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ module: 'vocab-path', payload: {
        level: path?.level, currentStep, completedSteps, mastery: completedSteps.length / 10,
        updatedAt: new Date().toISOString(),
      }}),
    }).catch(() => {});
  }

  function renderDiagnostic() {
    const question = diagnostic[diagnosticIndex];
    if (!question) return finishDiagnostic();
    diagnosticLevel.textContent = `${question.level} · ${diagnosticIndex + 1}/80`;
    progressBar.style.width = `${(diagnosticIndex / diagnostic.length) * 100}%`;
    body.innerHTML = '';
    const source = document.createElement('p'); source.className = 'muted small'; source.textContent = 'Kelime tanılaması'; body.append(source);
    const title = document.createElement('h3'); title.textContent = question.prompt; body.append(title);
    const options = document.createElement('div'); options.className = 'answer-grid'; body.append(options);
    question.options.forEach((option, index) => {
      const answer = button(option, 'answer-button');
      answer.addEventListener('click', () => {
        answers[diagnosticIndex] = index;
        options.querySelectorAll('button').forEach((item) => { item.disabled = true; });
        answer.classList.add('is-selected');
        const next = button(diagnosticIndex === diagnostic.length - 1 ? 'Sonucu hesapla' : 'Sonraki soru →', 'btn primary');
        next.addEventListener('click', () => { diagnosticIndex += 1; renderDiagnostic(); });
        body.append(next);
      });
      options.append(answer);
    });
  }

  async function finishDiagnostic() {
    progressBar.style.width = '100%';
    body.innerHTML = '<p class="muted">Cevapların değerlendiriliyor…</p>';
    try {
      const resultResponse = await fetch('/api/vocab/diagnostic', {
        method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ answers }),
      });
      const result = await resultResponse.json();
      if (!resultResponse.ok) throw new Error(result.error || 'diagnostic');
      diagnosticLevel.textContent = `${result.level} · %${Math.round(result.confidence * 100)} güven`;
      body.innerHTML = `<div class="result-banner"><strong>Başlangıç seviyen: ${esc(result.level)}</strong><span>${result.questionsAnswered} cevap üzerinden kişisel yolun hazırlanıyor.</span></div>`;
      const pathResponse = await fetch(`/api/vocab/path?level=${encodeURIComponent(result.level)}`);
      if (!pathResponse.ok) throw new Error('path');
      path = await pathResponse.json();
      pathCard.hidden = false;
      pathLevel.textContent = result.level;
      pathIntro.textContent = `Bu rota ${path.words.length} kelimeyi 10 farklı görev türünde kullandırır. Bir adımı tamamlamadan sonraki adım açılmaz.`;
      currentStep = 0; completedSteps = [];
      renderPath();
      pathCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch (error) {
      body.innerHTML = `<p class="error-copy">${esc(error.message || 'Test sonucu kaydedilemedi. Lütfen tekrar dene.')}</p>`;
    }
  }

  function renderPath() {
    stepNav.innerHTML = '';
    path.steps.forEach((step, index) => {
      const item = button(`${step.index} · ${step.title}${completedSteps.includes(index) ? ' ✓' : ''}`, index <= currentStep ? 'step-button' : 'step-button is-locked');
      item.disabled = index > currentStep;
      item.classList.toggle('is-current', index === currentStep);
      item.addEventListener('click', () => { currentStep = index; renderPath(); });
      stepNav.append(item);
    });
    renderStep(path.steps[currentStep]);
  }

  function renderStep(step) {
    workspace.innerHTML = '';
    const heading = document.createElement('div'); heading.className = 'step-heading';
    heading.innerHTML = `<div><p class="eyebrow">Adım ${step.index} · ${esc(step.type)}</p><h3>${esc(step.title)}</h3><p class="muted">${esc(step.objective)}</p></div><span class="scenario-tag">${esc(step.scenario)}</span>`;
    workspace.append(heading);
    const wordStrip = document.createElement('div'); wordStrip.className = 'word-strip';
    step.words.forEach((word) => { const chip = document.createElement('span'); chip.textContent = word.w; wordStrip.append(chip); });
    workspace.append(wordStrip);

    if (step.type === 'preview') {
      const article = document.createElement('article'); article.className = 'reading-box';
      article.innerHTML = `<p>${step.words.slice(0, 3).map((word) => esc(learnerExample(word))).join(' ')}</p><p class="muted">Hedef kelimeleri metinde bulduktan sonra “Hazırım” seç.</p>`;
      workspace.append(article);
      addCompleteButton('Hazırım — bu bağlamı anladım'); return;
    }

    const target = step.words[step.index % step.words.length];
    if (step.type === 'recall' || step.type === 'mission') {
      const prompt = document.createElement('p'); prompt.className = 'prompt-box'; prompt.textContent = step.type === 'mission' ? `${step.scenario} “${target.t}” fikrini İngilizce bir cümlede kullan.` : `İpucu: ${target.t} · İngilizce kelimeyi yaz.`; workspace.append(prompt);
      const input = document.createElement('input'); input.className = 'path-input'; input.placeholder = 'İngilizce kelime veya kısa cümle…'; input.autocomplete = 'off'; workspace.append(input);
      const check = button(step.type === 'mission' ? 'Görevi tamamla' : 'Hatırladım', 'btn primary');
      check.addEventListener('click', () => {
        const value = input.value.trim().toLowerCase();
        if (step.type === 'mission' ? value.split(/\s+/).length >= 3 : value === target.w.toLowerCase()) completeStep();
        else showStepMessage('Biraz daha düşün. İpucunu cümlede kullanmayı dene.');
      }); workspace.append(check); return;
    }

    const options = document.createElement('div'); options.className = 'answer-grid';
    const candidates = buildMeaningOptions(target, step.words);
    const prompt = document.createElement('p'); prompt.className = 'prompt-box';
    prompt.textContent = step.type === 'cloze' ? learnerExample(target).replace(new RegExp(target.w, 'i'), '______') : step.type === 'dialogue' ? `${step.scenario} En uygun kelime hangisi?` : step.type === 'sorting' ? `Bu kelimenin anlamını doğru görevde seç: ${target.w}` : `“${target.w}” için doğru anlamı seç.`;
    workspace.append(prompt);
    candidates.forEach((option) => { const answer = button(option, 'answer-button'); answer.addEventListener('click', () => { if (option === target.t) completeStep(); else { answer.classList.add('is-wrong'); showStepMessage('Henüz değil. Cümledeki anlam ipucunu tekrar oku.'); } }); options.append(answer); });
    workspace.append(options);
  }

  function showStepMessage(message) { let node = workspace.querySelector('.step-message'); if (!node) { node = document.createElement('p'); node.className = 'step-message'; workspace.append(node); } node.textContent = message; }
  function addCompleteButton(label) { const done = button(label, 'btn primary'); done.addEventListener('click', completeStep); workspace.append(done); }
  function completeStep() { if (!completedSteps.includes(currentStep)) completedSteps.push(currentStep); if (currentStep < path.steps.length - 1) currentStep += 1; savePathProgress(); renderPath(); }

  startButton?.addEventListener('click', () => { startButton.remove(); renderDiagnostic(); });
</script>

<style>
  [hidden] { display: none !important; }
  .vocab-path-page { max-width: 980px; margin: 0 auto; padding: 1.25rem 1rem 4rem; }
  .path-hero { display: flex; justify-content: space-between; gap: 2rem; align-items: end; padding: 1rem 0 2rem; }
  .path-hero h1 { max-width: 15ch; margin: .35rem 0 .8rem; font-size: clamp(2rem, 5vw, 4rem); line-height: .98; }
  .path-lead { max-width: 62ch; color: var(--ink-soft, #637); }
  .eyebrow { margin: 0; color: #0d9488; font-size: .75rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  .method-card, .research-note { padding: 1rem 1.2rem; border: 1px solid var(--line, #d8e2e1); border-radius: 1rem; background: rgba(13,148,136,.07); }
  .method-card { display: grid; gap: .35rem; min-width: 220px; }
  .method-card span { color: var(--ink-soft, #637); font-size: .85rem; }
  .path-card { margin: 1rem 0; padding: clamp(1rem, 3vw, 2rem); border: 1px solid var(--line, #d8e2e1); border-radius: 1.25rem; background: var(--surface, #fff); box-shadow: 0 12px 35px rgba(15,45,45,.06); }
  .path-card__head, .step-heading { display: flex; justify-content: space-between; gap: 1rem; align-items: start; }
  .path-card h2, .path-card h3 { margin: .35rem 0 .7rem; }
  .status-pill, .scenario-tag { border-radius: 999px; padding: .4rem .7rem; background: rgba(13,148,136,.12); color: #087f75; font-size: .78rem; font-weight: 800; white-space: nowrap; }
  .diagnostic-progress { height: .45rem; margin: 1.25rem 0; overflow: hidden; border-radius: 999px; background: rgba(13,148,136,.12); }
  .diagnostic-progress span { display: block; height: 100%; width: 0; background: #0d9488; transition: width .2s ease; }
  .muted { color: var(--ink-soft, #637); }
  .small { font-size: .85rem; }
  .answer-grid { display: grid; gap: .65rem; margin: 1rem 0; }
  .answer-button { padding: .85rem 1rem; border: 1px solid var(--line, #d8e2e1); border-radius: .75rem; background: transparent; color: inherit; text-align: left; cursor: pointer; }
  .answer-button:hover:not(:disabled), .answer-button.is-selected { border-color: #0d9488; background: rgba(13,148,136,.1); }
  .answer-button.is-wrong { border-color: #c2410c; background: rgba(194,65,12,.1); }
  .result-banner, .reading-box, .prompt-box { margin: 1rem 0; padding: 1rem; border-radius: .9rem; background: rgba(13,148,136,.08); }
  .result-banner { display: grid; gap: .3rem; }
  .step-nav { display: grid; grid-template-columns: repeat(10, minmax(0, 1fr)); gap: .4rem; margin: 1.5rem 0; }
  .step-button { min-height: 3.2rem; padding: .35rem; border: 1px solid var(--line, #d8e2e1); border-radius: .65rem; background: white; color: inherit; font-size: .72rem; cursor: pointer; }
  .step-button.is-current { border-color: #0d9488; box-shadow: 0 0 0 2px rgba(13,148,136,.16); }
  .step-button.is-locked { opacity: .45; cursor: not-allowed; }
  .word-strip { display: flex; flex-wrap: wrap; gap: .4rem; margin: 1rem 0; }
  .word-strip span { padding: .35rem .55rem; border-radius: .5rem; background: #f1f5f4; color: #315; font-size: .8rem; font-weight: 700; }
  .path-input { width: 100%; margin: .75rem 0; padding: .8rem; border: 1px solid var(--line, #d8e2e1); border-radius: .7rem; }
  .step-message, .error-copy { color: #b45309; font-weight: 700; }
  .research-note { margin-top: 1rem; }
  @media (max-width: 720px) { .path-hero { display: grid; } .method-card { min-width: 0; } .step-nav { grid-template-columns: repeat(5, minmax(0, 1fr)); } .path-card__head, .step-heading { display: grid; } }
</style>
