---
import AppLayout from '../../layouts/AppLayout.astro';
import { createSupabaseClient, pageCookieSource } from '../../lib/supabase';
import { getSessionUser } from '../../lib/auth';

const source = pageCookieSource(Astro);
const user = await getSessionUser(source);
if (!user) return Astro.redirect('/signin');

// Server-side read of the signed-in user's OWN notifications. RLS
// `notif_owner_read` scopes to auth.uid(), so a user only ever sees their own.
// Guarded: if Supabase is missing or the read fails, we render a friendly empty
// state instead of crashing (build/prerender safe).
type Notif = {
  id: string;
  title: string;
  body?: string | null;
  href?: string | null;
  kind?: string | null;
  is_read?: boolean;
  created_at?: string | null;
};

let notifications: Notif[] = [];
const supabase = createSupabaseClient(source);
if (supabase) {
  try {
    const { data } = await supabase
      .from('notifications')
      .select('id, title, body, href, kind, is_read, created_at')
      .order('created_at', { ascending: false })
      .limit(100);
    notifications = (data ?? []) as Notif[];
  } catch {
    notifications = [];
  }
}
const unread = notifications.filter((n) => !n.is_read);

const rel = (iso?: string | null) => {
  if (!iso) return '';
  const created = new Date(iso);
  if (Number.isNaN(created.getTime())) return '';
  const s = Math.round((Date.now() - created.getTime()) / 1000);
  if (s < 60) return 'az önce';
  const m = Math.floor(s / 60);
  if (m < 60) return `${m} dk önce`;
  const h = Math.floor(m / 60);
  if (h < 24) return `${h} sa önce`;
  const d = Math.floor(h / 24);
  if (d === 1) return 'dün';
  if (d < 7) return `${d} gün önce`;
  return created.toLocaleDateString('tr-TR', { day: 'numeric', month: 'short' });
};
---

<AppLayout title="Bildirimler — Languago" description="Bildirim kutun, her zaman burada.">
  <main class="study">
    <nav class="crumb">
      <a class="back" href="/dashboard">← Öğrenci Paneli</a>
      <span class="sep">›</span>
      <span class="cur">Bildirimler</span>
    </nav>

    <div class="notif-head">
      <div>
        <h1 style="margin:0;">Bildirimler 🔔</h1>
        <p class="muted" style="margin:4px 0 0;">
          {unread.length > 0 ? `${unread.length} okunmamış bildirimin var.` : 'Bütün bildirimlerin okundu. 👏'}
        </p>
      </div>
      {unread.length > 0 && (
        <button type="button" class="btn ghost sm" id="notif-mark-all">
          Tümünü oku
        </button>
      )}
    </div>
    <div class="barline"></div>

    {
      notifications.length === 0 ? (
        <div class="notif-empty">
          <span>📭</span>
          <h2>Henüz bildirimin yok</h2>
          <p>Sınıf hatırlatmaları, ders gelişmeleri ve öğretmeninden gelen iletiler burada görünecek.</p>
          <a class="btn primary" href="/dashboard">Panele Dön →</a>
        </div>
      ) : (
        <>
          {
            unread.length > 0 && (
              <section class="notif-group">
                <h2 class="notif-group__title">Okunmamış</h2>
                <ul class="notif-list">
                  {unread.map((n) => (
                    <li class="notif-row is-unread">
                      <button
                        type="button"
                        class="notif-row__body"
                        data-id={n.id}
                        data-href={n.href ?? undefined}
                        data-has-link={n.href ? true : false}
                      >
                        <span class="notif-row__dot" aria-hidden="true"></span>
                        <span class="notif-row__text">
                          <span class="notif-row__title">{n.title || 'Bildirim'}</span>
                          {n.body && <span class="notif-row__bodytext">{n.body}</span>}
                        </span>
                        <span class="notif-row__time">{rel(n.created_at)}</span>
                      </button>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }
          {
            notifications.filter((n) => n.is_read).length > 0 && (
              <section class="notif-group">
                <h2 class="notif-group__title">Öncekiler</h2>
                <ul class="notif-list">
                  {notifications.filter((n) => n.is_read).map((n) => (
                    <li class="notif-row">
                      <button
                        type="button"
                        class="notif-row__body"
                        data-id={n.id}
                        data-href={n.href ?? undefined}
                        data-has-link={n.href ? true : false}
                      >
                        <span class="notif-row__dot read" aria-hidden="true"></span>
                        <span class="notif-row__text">
                          <span class="notif-row__title">{n.title || 'Bildirim'}</span>
                          {n.body && <span class="notif-row__bodytext">{n.body}</span>}
                        </span>
                        <span class="notif-row__time">{rel(n.created_at)}</span>
                      </button>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }
        </>
      )
    }
  </main>
</AppLayout>

<script is:inline>
  (function () {
    // Mark-all-read → POST { all:true }, then reload so the server-rendered
    // unread/read grouping updates.
    var markAll = document.getElementById('notif-mark-all');
    if (markAll) {
      markAll.addEventListener('click', function () {
        markAll.disabled = true;
        markAll.textContent = 'Okunuyor…';
        fetch('/api/notifications', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ all: true }),
        })
          .finally(function () {
            window.location.reload();
          });
      });
    }

    // Single item → mark read (best-effort) then navigate on its href.
    var rows = document.querySelectorAll('.notif-row__body');
    for (var i = 0; i < rows.length; i++) {
      rows[i].addEventListener('click', function () {
        var id = this.getAttribute('data-id');
        var href = this.getAttribute('data-href');
        if (id) {
          fetch('/api/notifications', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: id }),
          }).catch(function () {});
        }
        if (href) {
          window.location.href = href;
        }
      });
    }
  })();
</script>

<style>
  .notif-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .notif-empty {
    text-align: center;
    padding: 48px 20px;
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    background: var(--bg-soft);
    max-width: 460px;
    margin: 24px auto;
  }
  .notif-empty > span {
    font-size: 2.6rem;
  }
  .notif-empty h2 {
    margin: 8px 0 6px;
  }
  .notif-empty p {
    color: var(--ink-soft);
    margin-bottom: 20px;
  }
  .notif-group {
    margin-top: 28px;
  }
  .notif-group__title {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    margin: 0 0 10px;
  }
  .notif-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .notif-row__body {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    width: 100%;
    text-align: left;
    padding: 16px 18px;
    border: none;
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    cursor: pointer;
    font-family: inherit;
    transition: background 0.12s;
  }
  .notif-list li:last-child .notif-row__body {
    border-bottom: none;
  }
  .notif-row__body:hover {
    background: var(--teal-soft);
  }
  .notif-row__dot {
    flex: 0 0 auto;
    width: 10px;
    height: 10px;
    margin-top: 7px;
    border-radius: 50%;
    background: var(--teal);
    box-shadow: 0 0 0 3px rgba(13, 148, 136, 0.18);
  }
  .notif-row__dot.read {
    background: var(--line);
    box-shadow: none;
  }
  .notif-row__text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
    flex: 1 1 auto;
  }
  .notif-row__title {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--teal-dark);
  }
  .notif-row.is-unread .notif-row__title {
    color: var(--teal-dark);
  }
  .notif-row__bodytext {
    font-size: 0.88rem;
    color: var(--ink-soft);
    line-height: 1.45;
  }
  .notif-row__time {
    flex: 0 0 auto;
    font-size: 0.75rem;
    color: var(--ink-soft);
    white-space: nowrap;
    margin-top: 3px;
  }
  @media (max-width: 560px) {
    .notif-row__time {
      display: none;
    }
  }
</style>