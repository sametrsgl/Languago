---
import Layout from '../../layouts/Layout.astro';
import { getSessionUser } from '../../lib/auth';
import { pageCookieSource } from '../../lib/supabase';
import { GRAMMAR_LEVELS } from '../../lib/study';

const user = await getSessionUser(pageCookieSource(Astro));
if (!user) return Astro.redirect('/signin');
---

<Layout title="Dilbilgisi — Languago" description="A1–B2 seviyesinde dilbilgisi konuları ve alıştırmalar.">
  <main class="study">
    <a class="back" href="/dashboard">← Öğrenci Paneli</a>
    <h1>Dilbilgisi 🧩</h1>
    <p class="muted">Bir seviye seç, konu slaytlarını çalış, sonra çoktan seçmeli testle pekiştir.</p>
    <div class="barline"></div>

    <div class="tiles">
      {
        Object.entries(GRAMMAR_LEVELS).map(([key, lvl]) => (
          <a class="tile" style={`border-top:4px solid ${lvl.color};`} href={`/dashboard/dilbilgisi/${key}`}>
            <div class="tt" style={`color:${lvl.color};`}>{lvl.label}</div>
            <div class="bb">{lvl.subtitle}</div>
          </a>
        ))
      }
    </div>
  </main>
</Layout>