---
import AppLayout from '../../../layouts/AppLayout.astro';
import { getSessionUser } from '../../../lib/auth';
import { pageCookieSource } from '../../../lib/supabase';
import { READING_LEVELS, loadReading, exportSuffix, levelTitle } from '../../../lib/study';
import { readProgress, payloadStr } from '../../../lib/progress';

const user = await getSessionUser(pageCookieSource(Astro));
if (!user) return Astro.redirect('/signin');

const level = Astro.params.level ?? '';
const found = READING_LEVELS.some((l) => l.key === level);
if (!found) return Astro.redirect('/dashboard/okuma');

const mod = await loadReading(level);
const readings = mod ? mod[`READINGS_${exportSuffix(level)}`] : null;
if (!readings) return Astro.redirect('/dashboard/okuma');

const passages = (readings as { id: string; topic: string; title: string; questions: unknown[] }[]) || [];

// Best-effort "where you left off": mark passages the student has read, drawn
// from their latest reading progress row. Guarded — never crashes when absent.
const readingProgress = await readProgress(pageCookieSource(Astro), 'reading');
const donePassage = payloadStr(readingProgress, 'passage', 'lastPassage');
const doneSet = new Set<string>(donePassage ? [donePassage] : []);

// group by topic for a friendlier browse structure
const topics = new Map<string, typeof passages>();
for (const p of passages) {
  const arr = topics.get(p.topic) || [];
  arr.push(p);
  topics.set(p.topic, arr);
}
---

<AppLayout title={`${levelTitle(level)} · Okuma — Languago`} description="Okuma metinleri ve anlama soruları.">
  <main class="study">
    <nav class="crumb">
      <a class="back" href="/dashboard">Öğrenci Paneli</a>
      <span class="sep">›</span>
      <a class="lnk" href="/dashboard/okuma">Okuma</a>
      <span class="sep">›</span>
      <span class="cur">{levelTitle(level)}</span>
    </nav>
    <h1>{levelTitle(level)} Okuma</h1>
    <p class="muted">{passages.length} metin · temaya göre gruplanmış</p>
    <div class="barline"></div>

    {
      [...topics.entries()].map(([topic, list]) => (
        <section style="margin-bottom:26px;">
          <h2 style="font-size:1.05rem;color:var(--ink-soft);">
            <span class="badge" style="background:var(--teal-dark);">{topic}</span>
          </h2>
          <div class="tiles">
            {list.map((p) => (
              <a class:list={['tile', { done: doneSet.has(p.id) }]} style="border-top:4px solid var(--brand);" href={`/dashboard/okuma/${level}/${p.id}`}>
                {doneSet.has(p.id) && <span class="done-mark">✓</span>}
                <div class="tt">{p.title}</div>
                <div class="bb">{p.questions.length} soru</div>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </main>
</AppLayout>