---
import AppLayout from '../../../../layouts/AppLayout.astro';
import { getSessionUser } from '../../../../lib/auth';
import { pageCookieSource } from '../../../../lib/supabase';
import { READING_LEVELS, loadReading, exportSuffix, levelTitle } from '../../../../lib/study';

const user = await getSessionUser(pageCookieSource(Astro));
if (!user) return Astro.redirect('/signin');

const level = Astro.params.level ?? '';
const passageId = Astro.params.passage ?? '';
if (!READING_LEVELS.some((l) => l.key === level)) return Astro.redirect('/dashboard/okuma');

const mod = await loadReading(level);
const readings = mod ? mod[`READINGS_${exportSuffix(level)}`] : null;
const passage = (readings as { id: string; topic: string; title: string; text: string; questions: { q: string; options: string[]; a: number; why?: string[] }[] }[])
  ?.find((p) => p.id === passageId);
if (!passage) return Astro.redirect(`/dashboard/okuma/${level}`);

const questions = passage.questions || [];
const total = questions.length;

// Next passage in this level (for the "Sonraki Metin →" proceed button)
const idx = (readings as { id: string; title: string }[])?.findIndex((p) => p.id === passageId) ?? -1;
const nextPassage = idx >= 0 && idx < readings.length - 1 ? readings[idx + 1] : null;
const nextHref = nextPassage ? `/dashboard/okuma/${level}/${(nextPassage as { id: string }).id}` : null;
---

<AppLayout title={`${passage.title} — ${levelTitle(level)} · Languago`} description={`${levelTitle(level)} okuma metni`}>
  <main class="study">
    <nav class="crumb">
      <a class="back" href="/dashboard">Öğrenci Paneli</a>
      <span class="sep">›</span>
      <a class="lnk" href="/dashboard/okuma">Okuma</a>
      <span class="sep">›</span>
      <a class="lnk" href={`/dashboard/okuma/${level}`}>{levelTitle(level)}</a>
      <span class="sep">›</span>
      <span class="cur">{passage.title}</span>
    </nav>
    <h1>{passage.title}</h1>
    <p class="muted">
      <span class="badge" style="background:var(--teal-dark);">{passage.topic}</span>{' '}
      {levelTitle(level)} · Metni oku, ardından {total} soruyu çöz.
    </p>
    <div class="barline"></div>

    <div class="passage">{passage.text}</div>

    <h2 style="font-size:1.2rem;margin-top:34px;">❓ Anlama Soruları</h2>
    <div class="pbar">
      <div class="pbar-track"><div class="pbar-fill" id="readFill" data-total={total}></div></div>
      <span class="pbar-label" id="readPbar">0 / {total} soru</span>
    </div>
    <div class="score-line" id="readScore">
      Skor: <span id="readScoreNum">0</span> / {total} — seçince cevap anında belli olur.
    </div>
    <div id="readQuiz">
      {questions.map((qq, i) => (
        <div class="quiz-q" data-idx={i}>
          <div class="qq">{i + 1}. {qq.q}</div>
          {qq.options.map((opt, oi) => (
            <button type="button" class="option" data-correct={oi === qq.a ? '1' : '0'} data-oi={oi}>
              {String.fromCharCode(65 + oi)}) {opt}
            </button>
          ))}
          <div class="reveal" data-reveal></div>
        </div>
      ))}
    </div>

    <div id="readDone" style="display:none;text-align:center;margin-top:26px;" data-next-href={nextHref ?? ''} data-next-title={nextPassage ? (nextPassage as { title: string }).title : ''} data-has-next={nextPassage ? '1' : '0'}>
      <hr class="barline" />
      {nextPassage ? (
        <>
          <p class="muted">Metni bitirdin! Şimdi sıradaki okumaya geçebilirsin 👉</p>
          <a class="btn primary" id="readNextBtn" href={nextHref ?? `/dashboard/okuma/${level}`}>
            Sonraki Metin: {(nextPassage as { title: string }).title} →
          </a>
        </>
      ) : (
        <p class="muted">Tebrikler — bu seviyede son okumayı da bitirdin 👏 Tüm okumalar tamam!</p>
      )}
    </div>

    <script define:vars={{ level, passageId, passageTitle: passage.title, questions }}>
      (function () {
        // level, passageId, passageTitle, questions available via define:vars
        var quiz = document.getElementById('readQuiz');
        if (!quiz) return;
        var correct = 0;
        var answered = 0;
        var total = quiz.querySelectorAll('.quiz-q').length;
        var scoreNum = document.getElementById('readScoreNum');
        var scoreLine = document.getElementById('readScore');
        var fillEl = document.getElementById('readFill');
        var pbarEl = document.getElementById('readPbar');

        function updatePbar(answered) {
          var pct = Math.round((answered / total) * 100);
          if (fillEl) fillEl.style.width = pct + '%';
          if (pbarEl) pbarEl.textContent = answered + ' / ' + total + ' soru';
        }

        quiz.addEventListener('click', function (e) {
          var btn = e.target.closest('.option');
          if (!btn || btn.disabled) return;
          var q = btn.closest('.quiz-q');
          if (!q) return;
          var reveal = q.querySelector('[data-reveal]');
          if (reveal) reveal.style.whiteSpace = 'pre-line'; // why notlarını kendi satırında göster
          var isCorrect = btn.getAttribute('data-correct') === '1';
          var chosenIdx = parseInt(btn.getAttribute('data-oi') || '-1', 10);
          var idx = parseInt(q.getAttribute('data-idx') || '0', 10);
          var qq = questions[idx];
          var ansIdx = qq ? qq.a : -1;
          // Şıka özel "neden doğru/yanlış" notu (options ile aynı dizin). why[] yoksa null → eski mesaj korunur.
          function whyOf(i) {
            if (qq && Array.isArray(qq.why) && i >= 0 && i < qq.why.length && qq.why[i]) return qq.why[i];
            return null;
          }
          q.querySelectorAll('.option').forEach(function (o) { o.disabled = true; });
          q.querySelectorAll('.option[data-correct="1"]').forEach(function (o) {
            o.classList.add('correct');
          });
          if (isCorrect) {
            correct++;
            var whyRight = whyOf(ansIdx);
            if (reveal) {
              reveal.textContent = '✓ Doğru! Harikasın! 🎉' + (whyRight ? '\n' + whyRight : '');
              reveal.className = 'reveal ok';
            }
          } else {
            btn.classList.add('wrong');
            var whyChosen = whyOf(chosenIdx);
            var whyCorrect = whyOf(ansIdx);
            var msg = 'Tekrar deneyebilirsin 💪 — doğru cevap yukarıda yeşil gösterildi.';
            if (whyChosen) msg += '\n❌ Seçtiğin şık: ' + whyChosen;
            if (whyCorrect) msg += '\n✅ Doğru cevap: ' + whyCorrect;
            if (reveal) { reveal.textContent = msg; reveal.className = 'reveal try'; }
          }
          answered++;
          if (scoreNum) scoreNum.textContent = String(correct);
          updatePbar(answered);
          if (answered >= total && scoreLine) {
            scoreLine.textContent = 'Test tamamlandı! Skor: ' + correct + ' / ' + total +
              (correct === total ? ' — Mükemmel! 🎉 Sen çok iyi bir okursun!' : correct >= Math.ceil(total / 2) ? ' — İyi iş! 💪 Harika gidiyorsun.' : ' — Olsun, metni tekrar okuyunca daha da iyi olacaksın 📖💪');
            saveProgress();
            var doneBox = document.getElementById('readDone');
            if (doneBox) doneBox.style.display = '';
          }
        });

        function saveProgress() {
          try {
            fetch('/dashboard/progress', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({
                module: 'reading',
                payload: { level: level, passage: passageId, title: passageTitle, correct: correct, total: total },
              }),
            }).catch(function () {});
          } catch (e) {}
        }
      })();
    </script>
  </main>
</AppLayout>