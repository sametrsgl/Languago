---
import Layout from '../../layouts/Layout.astro';
import { createSupabaseClient, pageCookieSource } from '../../lib/supabase';

// Protected route: read the session server-side and redirect if not signed in.
const supabase = createSupabaseClient(pageCookieSource(Astro));
if (!supabase) {
  return Astro.redirect('/signin');
}
const { data } = await supabase.auth.getUser();
if (!data.user) {
  return Astro.redirect('/signin');
}
const user = data.user;
const fullName =
  (user.user_metadata?.full_name as string | undefined) || undefined;

// Teacher/admin get an extra admin entry point — role read server-side from
// profiles.role (RLS returns only the caller's own row).
let isTeacher = false;
try {
  const { data: profile } = await supabase
    .from('profiles')
    .select('role')
    .eq('id', user.id)
    .maybeSingle();
  const role = (profile?.role as string | undefined) ?? 'student';
  isTeacher = role === 'teacher' || role === 'admin';
} catch {
  isTeacher = false;
}

const studyLinks = [
  {
    href: '/dashboard/kelimeler',
    emoji: '🪪',
    title: 'Kelime',
    desc: 'Kelime setlerine göz at, İngilizce ↔ Türkçe ara ve detaylı kartları incele.',
  },
  {
    href: '/dashboard/dilbilgisi',
    emoji: '🧩',
    title: 'Dilbilgisi',
    desc: 'A1–B2 seviyesindeki konu slaytları ve çoktan seçmeli pekiştirme testleri.',
  },
  {
    href: '/dashboard/okuma',
    emoji: '📖',
    title: 'Okuma',
    desc: 'Seviyene uygun okuma metinleri ve anlama soruları ile pratik yap.',
  },
  {
    href: '/dashboard/oyunlar',
    emoji: '🎮',
    title: 'Oyunlar',
    desc: 'Sınıf içi kelime oyunları: eksik harfleri tamamla, zamanlı yarışmada kelime bul.',
  },
];
---

<Layout
  title="Öğrenci Paneli — Languago"
  description="Derslerine, ilerlemene ve sınıf içi oyunlarına buradan eriş."
>
  <main class="study">
    <h1>Hoş geldin{fullName ? `, ${fullName}` : ''}! 👋</h1>
    <p class="muted">Languago öğrenci panelindesin. Kendi kendine çalışma modüllerin aşağıda.</p>
    <div class="barline"></div>

    <div class="dash-nav">
      {
        studyLinks.map((l) => (
          <a class="card tile card-link" href={l.href}>
            <div>
              <div style="font-size:1.8rem;">{l.emoji}</div>
              <div class="tt">{l.title}</div>
              <div class="bb">{l.desc}</div>
            </div>
          </a>
        ))
      }
    </div>

    {
      isTeacher && (
        <a class="card tile card-link teacher-dash" href="/teacher">
          <div>
            <div style="font-size:1.8rem;">📋</div>
            <div class="tt">Öğretmen Paneli</div>
            <div class="bb">
              Sınıflarını, öğrencilerini ve ilerlemelerini yönetmek için öğretmen
              panelini aç.
            </div>
          </div>
        </a>
      )
    }

    <div class="panel" style="margin-top:24px;background:var(--bg-soft);border:1px solid var(--line);border-radius:var(--radius);padding:20px;">
      <p style="margin:0 0 10px;">
        <strong>Giriş yapan hesap:</strong> <span class="email">{user.email}</span>
      </p>
      <a class="btn ghost" href="/dashboard/dilbilgisi">Dilbilgisi</a>{' '}
      <a class="btn ghost" href="/dashboard/okuma">Okuma</a>{' '}
      <a class="btn ghost" href="/dashboard/kelimeler">Kelime</a>
      <form id="signout-form" style="display:inline;">
        <button class="btn ghost" type="submit" style="margin-left:8px;">Çıkış Yap</button>
      </form>
    </div>
  </main>
</Layout>

<script is:inline>
  (function () {
    var form = document.getElementById('signout-form');
    if (!form) return;
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var btn = form.querySelector('button');
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Çıkılıyor…';
      }
      fetch('/api/auth/signout', { method: 'POST' })
        .then(function () {
          window.location.href = '/signin';
        })
        .catch(function () {
          // Endpoint failure: still leave the dashboard so the user is not
          // left stuck.
          window.location.href = '/signin';
        });
    });
  })();
</script>