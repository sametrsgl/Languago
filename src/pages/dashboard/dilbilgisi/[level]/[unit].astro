---
// Languago — Dilbilgisi Ünitesi (derin öğrenme etkileşimi)
// Auth/SSR/guard/saveProgress korunur. Tüm içerik mevcut ünite verisinden
// (slides / mistakes / practice / MCQ) türetilir. Vanilla JS, teal+orange.
import AppLayout from '../../../../layouts/AppLayout.astro';
import { getSessionUser } from '../../../../lib/auth';
import { pageCookieSource } from '../../../../lib/supabase';
import { GRAMMAR_LEVELS, loadGrammar, loadGrammarMcq, exportSuffix, levelTitle } from '../../../../lib/study';

const user = await getSessionUser(pageCookieSource(Astro));
if (!user) return Astro.redirect('/signin');

const level = Astro.params.level ?? '';
const unitId = Astro.params.unit ?? '';
const meta = GRAMMAR_LEVELS[level as keyof typeof GRAMMAR_LEVELS];
if (!meta) return Astro.redirect('/dashboard/dilbilgisi');

const mod = await loadGrammar(level);
const grammar = mod ? mod[`GRAMMAR_${exportSuffix(level)}`] : null;
const mcqMod = await loadGrammarMcq(level);
const mcqGroups: Record<string, { q: string; options: string[]; a: number }[] | undefined> =
  mcqMod ? mcqMod[`GRAMMAR_MCQ_${exportSuffix(level)}`] : null;

const unit = grammar?.units?.find((u: any) => u.id === unitId);
if (!unit) return Astro.redirect(`/dashboard/dilbilgisi/${level}`);

const slides: { h: string; b: string }[] = unit.slides ?? [];
const mistakes: { w: string; r: string; n: string }[] = unit.mistakes ?? [];
const practice: { q: string; hint: string; a: string[] }[] = unit.practice ?? [];
const quiz: { q: string; options: string[]; a: number }[] = (mcqGroups && mcqGroups[unitId]) || [];
const total = quiz.length;

// --- sekme kategorisi: slayt başlığından türetilir (genel ünitelerde zarifçe boşalır) ---
function normTR(s: string): string {
  // Türkçe yerelinde küçült (İ→ı) sonra ince/düz ı-i ayrımını birleştir.
  return String(s).toLocaleLowerCase('tr').replace(/ı/g, 'i');
}
function slideCat(h: string): string {
  const t = normTR(h);
  if (t.includes('nesne')) return 'nesne';
  if (t.includes('iyelik') && t.includes('sifat')) return 'iyelik-sifat';
  if (t.includes('iyelik') && t.includes('zamir')) return 'iyelik-zamir';
  if (t.includes('ozne') || t.includes('zamir')) return 'ozne';
  return 'genel';
}

const TABS = [
  { k: 'all', label: 'Tümü' },
  { k: 'ozne', label: 'Özne Zamirleri' },
  { k: 'nesne', label: 'Nesne Zamirleri' },
  { k: 'iyelik-sifat', label: 'İyelik Sıfatları' },
  { k: 'iyelik-zamir', label: 'İyelik Zamirleri' },
];

// A1 iyelik/zamir karşılaştırma matrisi (öğrenme amaçlı statik haritadır).
const MATRIX = [
  { tr: 'Ben', subj: 'I', obj: 'me', sa: 'my', sz: 'mine' },
  { tr: 'Sen', subj: 'You', obj: 'you', sa: 'your', sz: 'yours' },
  { tr: 'O (erkek)', subj: 'He', obj: 'him', sa: 'his', sz: 'his' },
  { tr: 'O (kadın)', subj: 'She', obj: 'her', sa: 'her', sz: 'hers' },
  { tr: 'O (nesne)', subj: 'It', obj: 'it', sa: 'its', sz: '—' },
  { tr: 'Biz', subj: 'We', obj: 'us', sa: 'our', sz: 'ours' },
  { tr: 'Onlar', subj: 'They', obj: 'them', sa: 'their', sz: 'theirs' },
];

// Uygulama / Eşleştirme için ikidilli mini havuz.
const PAIRS = [
  { en: 'I', tr: 'Ben', ic: '🙋' },
  { en: 'you', tr: 'Sen', ic: '🫵' },
  { en: 'he', tr: 'O (erkek)', ic: '👦' },
  { en: 'She', tr: 'O (kadın)', ic: '👩' },
  { en: 'my', tr: 'Benim', ic: '👤' },
  { en: 'your', tr: 'Senin', ic: '🫱' },
  { en: 'his', tr: 'Onun (erkek)', ic: '🧑' },
  { en: 'her', tr: 'Onun (kadın)', ic: '👩‍🦰' },
  { en: 'our', tr: 'Bizim', ic: '👥' },
  { en: 'their', tr: 'Onların', ic: '🧑‍🤝‍🧑' },
];

// Boşluk doldurma çipleri: doğru cevap + havuzdan çeldiriciler.
function shuffleArr<T>(arr: T[]): T[] {
  const a = arr.slice();
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}
const pool: string[] = Array.from(new Set([
  ...practice.flatMap((p) => (p.a || []) as string[]),
  ...quiz.flatMap((q) => q.options),
]));
const gapChips: string[][] = practice.map((p) => {
  const correct = (p.a && p.a[0]) || '';
  const others = pool.filter(
    (x) => String(x).toLowerCase() !== correct.toLowerCase() &&
      !(p.a || []).some((aa) => aa.toLowerCase() === String(x).toLowerCase())
  );
  return shuffleArr([correct, ...others.slice(0, 3)]);
});

const interactCount = quiz.length + practice.length + 5 + 6; // MCQ+boşluk+uygulama+eşleştirme
---

<AppLayout title={`${unit.title} — ${levelTitle(level)} · Languago`} description={meta.subtitle}>
  <main class="study gram">
    <nav class="crumb">
      <a class="back" href="/dashboard">Öğrenci Paneli</a>
      <span class="sep">›</span>
      <a class="lnk" href="/dashboard/dilbilgisi">Dilbilgisi</a>
      <span class="sep">›</span>
      <a class="lnk" href={`/dashboard/dilbilgisi/${level}`}>{levelTitle(level)}</a>
      <span class="sep">›</span>
      <span class="cur">{unit.title}</span>
    </nav>
    <h1 style={`color:${meta.color};`}>{unit.title}</h1>
    <p class="muted">{unit.short} · {slides.length} slayt{interactCount ? ` · ${interactCount} etkileşimli alıştırma` : ''}</p>
    <div class="barline"></div>

    <!-- V. Modül düzeyi ilerleme göstergesi -->
    <div class="gram-progress card">
      <div class="gram-progress__head"><span>💧 İlerleme</span><strong id="gramPct">%0</strong></div>
      <div class="pbar-track"><div class="pbar-fill gram-progress__fill" id="gramFillEnd"></div></div>
      <div class="gram-progress__sub" id="gramProgSub">Etkileşimleri tamamladıkça ilerlemen dolar.</div>
    </div>

    <!-- I. Çok sekmeli konu anlatımı -->
    <h2 style="font-size:1.2rem;">📘 Konu Anlatımı</h2>
    <div class="gram-tabs" id="tabBar" role="tablist">
      {TABS.map((t) => (
        <button type="button" class="gram-tab" data-tab={t.k} role="tab" aria-selected={t.k === 'all' ? 'true' : 'false'}>{t.label}</button>
      ))}
    </div>

    <div class="slide-box" id="slideBox">
      <div id="slideItems" data-count={slides.length}>
        {slides.map((s, i) => (
          <div data-slide={i} data-cat={slideCat(s.h)} style={i === 0 ? '' : 'display:none;'}>
            <h3>{s.h}</h3>
            <div class="body">{s.b}</div>
          </div>
        ))}
      </div>
      <div class="gram-empty" id="tabEmpty" style="display:none;">Bu konu için ayrı bir slayt yok — alttaki karşılaştırma tablosunda inceleyebilir ya da <strong>Tümü</strong> sekmesine geçebilirsin 👇</div>
      <div class="slidebox-nav">
        <button type="button" id="prevSlide" class="btn ghost">← Önceki</button>
        <span id="slidePos" class="muted">{slides.length ? `1 / ${slides.length}` : ''}</span>
        <button type="button" id="nextSlide" class="btn primary">Sonraki →</button>
      </div>
    </div>

    <!-- Karşılaştırmalı renk kodlu zamir matrisi -->
    <div class="gram-matrix card" id="matrixCard" data-emph="all">
      <h3 style="margin-bottom:2px;">🔎 Karşılaştırma Tablosu</h3>
      <p class="muted">Dört biçimi aynı kişiyle yan yana gör. Bir hücreye gelince <strong>satırın tüm biçimleri</strong> vurgulanır.</p>
      <div class="gram-matrix__wrap">
        <table class="gram-matrix__t">
          <thead>
            <tr>
              <th class="gm-person">Kişi</th>
              <th class="gm-sub">Özne <small>Zamirleri</small></th>
              <th class="gm-obj">Nesne <small>Zamirleri</small></th>
              <th class="gm-sa">İyelik <small>Sıfatı</small></th>
              <th class="gm-sz">İyelik <small>Zamiri</small></th>
            </tr>
          </thead>
          <tbody>
            {MATRIX.map((r) => (
              <tr>
                <td class="gm-person">{r.tr}</td>
                <td class="gm-sub">{r.subj}</td>
                <td class="gm-obj">{r.obj}</td>
                <td class="gm-sa">{r.sa}</td>
                <td class="gm-sz">{r.sz}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="gram-matrix__legend">
        <span class="gm-legend gm-l-sub">Özne</span>
        <span class="gm-legend gm-l-obj">Nesne</span>
        <span class="gm-legend gm-l-sa">İyelik Sıfatı</span>
        <span class="gm-legend gm-l-sz">İyelik Zamiri</span>
      </div>
    </div>

    <!-- II. Satır içi Uygulama (tap-to-match) -->
    <div class="gram-apply card" id="applyCard">
      <button type="button" id="applyToggle" class="btn primary">⚡ Hızlı Uygulama (30 sn)</button>
      <div id="applyBody" class="gram-apply__body" style="display:none;">
        <p class="muted">İngilizce biçimi Türkçe karşılığıyla eşleştir: önce <strong>soldan</strong> birini, sonra <strong>sağdan</strong> karşılığını seç.</p>
        <div class="gram-match">
          <div class="gram-match__col" id="applyL"></div>
          <div class="gram-match__col" id="applyR"></div>
        </div>
        <div class="gram-match__fb" id="applyFb"></div>
      </div>
    </div>

    <!-- III. Çeşitlendirilmiş Pekiştirme -->
    <h2 style="font-size:1.2rem;margin-top:34px;">🧩 Pekiştirme Testi</h2>

    {total > 0 && (
      <>
        <div class="pbar">
          <div class="pbar-track"><div class="pbar-fill" id="gramFill" data-total={total}></div></div>
          <span class="pbar-label" id="gramPbar">0 / {total} soru</span>
        </div>
        <div class="gram-qtip card">
          Her soru için <strong>anında</strong> geri bildirim alırsın; yanlışta <strong>Neden?</strong> ile açıklamayı gör.
        </div>
        <div id="quizBox">
          {quiz.map((qq, i) => (
            <div class="quiz-q" data-idx={i} data-total={total}>
              <div class="qq">{i + 1}. {qq.q}</div>
              {qq.options.map((opt, oi) => (
                <button type="button" class="option" data-correct={oi === qq.a ? '1' : '0'}>{String.fromCharCode(65 + oi)}) {opt}</button>
              ))}
              <div class="reveal" data-reveal></div>
              <button type="button" class="gram-why" data-why style="display:none;">💡 Neden?</button>
              <div class="gram-whybox" data-whybox style="display:none;"></div>
            </div>
          ))}
        </div>
      </>
    )}

    {practice.length > 0 && (
      <>
        <h3 style="margin-top:30px;">✍️ Boşluğu Doldur <span class="muted" style="font-weight:500;">(çipi tıkla ya da boşluğa sürükle)</span></h3>
        <div id="gapBox">
          {practice.map((p, i) => {
            const parts = p.q.split('___');
            return (
              <div class="gram-gap" data-ans={(p.a && p.a[0]) || ''} data-hint={p.hint || ''} data-idx={i}>
                <div class="gram-gap__q">
                  {parts.length > 1 ? (
                    <>
                      {parts[0]}<span class="gram-slot" data-slot role="button">?</span>{parts[1]}
                    </>
                  ) : (
                    <>{p.q}<span class="gram-slot" data-slot role="button">?</span></>
                  )}
                </div>
                <div class="gram-gap__hint muted">💡 {p.hint || 'İpucu yok'}</div>
                <div class="gram-chips">
                  {(gapChips[i] || []).map((c) => (
                    <button type="button" class="gram-chip" draggable="true" data-val={c}>{c}</button>
                  ))}
                </div>
                <div class="gram-gap__fb" data-gf></div>
              </div>
            );
          })}
        </div>
      </>
    )}

    <h3 style="margin-top:30px;">🧲 Eşleştirme</h3>
    <div class="gram-matchcard card">
      <p class="muted">Zamirleri karşılıklarıyla eşleştir: soldan birini seç, sağdan eşini bul.</p>
      <div class="gram-match">
        <div class="gram-match__col" id="matchL"></div>
        <div class="gram-match__col" id="matchR"></div>
      </div>
      <div class="gram-match__fb" id="matchFb"></div>
    </div>

    <!-- IV. Performans analizi + Uygulama Listesi -->
    <button type="button" id="resultsBtn" class="btn primary" style="margin-top:30px;">📊 Sonuçlarımı Gör</button>
    <div class="gram-analysis card" id="analysis" style="display:none;">
      <h3>💪 Performans Analizi</h3>
      <p id="anaMsg" class="gram-analysis__msg"></p>
      <div class="gram-analysis__bars" id="anaBars"></div>
      <div class="gram-revlist" id="revList">
        <div class="gram-revlist__title">📚 Uygulama Listesi — gözden geçir</div>
        <button type="button" class="gram-rev gram-rev--ozne" data-gotab="ozne">Özne zamirlerini gözden geçir →</button>
        <button type="button" class="gram-rev gram-rev--nesne" data-gotab="nesne">Nesne zamirlerini gözden geçir →</button>
        <button type="button" class="gram-rev gram-rev--sa" data-gotab="iyelik-sifat">İyelik sıfatlarını gözden geçir →</button>
        <button type="button" class="gram-rev gram-rev--sz" data-gotab="iyelik-zamir">İyelik zamirlerini gözden geçir →</button>
      </div>
      <button type="button" id="retryBtn" class="btn ghost">🔁 Alıştırmaları tekrar başlat</button>
    </div>
  </main>

  <style is:global>
    /* ---- Languago grammar deep-learning module ---- */
    .gram-progress { margin: 4px 0 22px; }
    .gram-progress__head { display: flex; align-items: center; justify-content: space-between; font-size: 0.95rem; margin-bottom: 10px; }
    .gram-progress__sub { font-size: 0.82rem; color: var(--ink-soft); margin-top: 8px; }
    .gram-progress__fill { background: linear-gradient(90deg, var(--teal), var(--brand)); }

    .gram-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin: 4px 0 16px; }
    .gram-tab {
      border: 1px solid var(--line); background: var(--bg); color: var(--ink-soft);
      border-radius: 999px; padding: 8px 16px; font-weight: 700; font-size: 0.88rem;
      cursor: pointer; transition: all 0.15s; font-family: inherit;
    }
    .gram-tab:hover { border-color: var(--teal); color: var(--teal-dark); }
    .gram-tab.on { background: var(--teal); border-color: var(--teal); color: #fff; box-shadow: 0 8px 18px -10px rgba(13,148,136,0.7); }
    .gram-tab.done::after { content: '✓'; margin-left: 6px; color: inherit; opacity: 0.85; }
    .gram-empty { background: var(--teal-soft); border-radius: 10px; padding: 12px 14px; color: var(--teal-dark); font-size: 0.92rem; margin-bottom: 14px; }

    .gram-matrix { margin-top: 22px; }
    .gram-matrix__wrap { overflow-x: auto; border-radius: 12px; border: 1px solid var(--line); }
    .gram-matrix__t { width: 100%; border-collapse: collapse; min-width: 560px; text-align: center; }
    .gram-matrix__t th { padding: 12px 10px; font-size: 0.88rem; color: #fff; }
    .gram-matrix__t th small { display: block; font-weight: 500; opacity: 0.9; }
    .gram-matrix__t td { padding: 13px 10px; border-top: 1px solid var(--line); font-weight: 700; font-size: 1.05rem; }
    th.gm-sub, td.gm-sub { background: var(--teal-soft); color: var(--teal-dark); }
    th.gm-obj, td.gm-obj { background: #99f6e4; color: #0f766e; }
    th.gm-sa,  td.gm-sa  { background: #fef3c7; color: #b45309; }
    th.gm-sz,  td.gm-sz  { background: #fde68a; color: #92400e; }
    th.gm-person, td.gm-person { background: var(--bg-soft); color: var(--ink); }
    th.gm-sub { background: var(--teal); }
    th.gm-obj { background: #0d9488; }
    th.gm-sa  { background: var(--brand); }
    th.gm-sz  { background: #d97706; }
    .gram-matrix__t tbody tr { transition: transform 0.1s; }
    /* satır üzerine gelince tüm biçimler vurgulanır */
    .gram-matrix__t tbody tr:hover td { box-shadow: inset 0 0 0 2.5px var(--teal); }
    .gram-matrix__t tbody tr:hover td.gm-person { box-shadow: inset 0 0 0 2.5px var(--teal-dark); color: var(--teal-dark); }
    /* sekmeye göre ilgili sütunu vurgula */
    .gram-matrix[data-emph="ozne"]         th.gm-sub, .gram-matrix[data-emph="ozne"]         td.gm-sub { box-shadow: inset 0 0 0 3px var(--teal); }
    .gram-matrix[data-emph="nesne"]        th.gm-obj, .gram-matrix[data-emph="nesne"]        td.gm-obj { box-shadow: inset 0 0 0 3px #0f766e; }
    .gram-matrix[data-emph="iyelik-sifat"] th.gm-sa,  .gram-matrix[data-emph="iyelik-sifat"] td.gm-sa  { box-shadow: inset 0 0 0 3px var(--brand-dark); }
    .gram-matrix[data-emph="iyelik-zamir"] th.gm-sz,  .gram-matrix[data-emph="iyelik-zamir"] td.gm-sz  { box-shadow: inset 0 0 0 3px #d97706; }
    .gram-matrix__legend { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 12px; font-size: 0.82rem; color: var(--ink-soft); }
    .gm-legend { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; }
    .gm-legend::before { content: ''; width: 14px; height: 14px; border-radius: 4px; display: inline-block; }
    .gm-l-sub::before { background: var(--teal-soft); border: 1px solid var(--teal); }
    .gm-l-obj::before { background: #99f6e4; border: 1px solid #0d9488; }
    .gm-l-sa::before  { background: #fef3c7; border: 1px solid var(--brand); }
    .gm-l-sz::before  { background: #fde68a; border: 1px solid #d97706; }

    .gram-apply { margin-top: 22px; border-left: 5px solid var(--brand); }
    .gram-apply .btn { font-size: 0.95rem; }
    .gram-apply__body { margin-top: 16px; }

    .gram-match { display: flex; gap: 22px; flex-wrap: wrap; }
    .gram-match__col { flex: 1 1 200px; display: flex; flex-direction: column; gap: 8px; }
    .gram-match__item {
      border: 1px solid var(--line); background: var(--bg); border-radius: 12px;
      padding: 11px 14px; font-weight: 700; font-size: 0.98rem; cursor: pointer;
      font-family: inherit; text-align: center; transition: all 0.12s; color: var(--ink);
    }
    .gram-match__item:hover:not(:disabled):not(.ok) { border-color: var(--teal); background: var(--teal-soft); }
    .gram-match__item.sel { border-color: var(--teal); background: var(--teal); color: #fff; box-shadow: 0 6px 14px -8px rgba(13,148,136,0.8); }
    .gram-match__item.ok { background: #d3f9d8; border-color: #69db7c; color: var(--success); cursor: default; opacity: 0.9; }
    .gram-match__item.no { background: #ffe3e3; border-color: #ffa8a8; color: var(--danger); animation: gramShake 0.25s; }
    .gram-match__item:disabled { cursor: pointer; }
    @keyframes gramShake { 0%,100%{transform:translateX(0);} 25%{transform:translateX(-4px);} 75%{transform:translateX(4px);} }
    .gram-match__fb { margin-top: 14px; font-weight: 700; min-height: 22px; }

    .gram-qtip { background: var(--teal-soft); border: 1px solid var(--teal); color: var(--teal-dark); font-size: 0.9rem; padding: 10px 14px; border-radius: 10px; margin: 0 0 6px; }
    .gram-why { margin-top: 8px; border: 1px solid var(--line); background: var(--bg); color: var(--teal-dark); border-radius: 999px; padding: 6px 14px; font-weight: 700; font-size: 0.82rem; cursor: pointer; }
    .gram-why:hover { background: var(--teal-soft); border-color: var(--teal); }
    .gram-whybox { margin-top: 8px; background: var(--bg); border: 1px dashed var(--teal); border-radius: 10px; padding: 10px 12px; font-size: 0.9rem; color: var(--ink-soft); }

    .gram-gap { border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-soft); padding: 16px; margin: 14px 0; }
    .gram-gap__q { font-weight: 700; font-size: 1.06rem; margin-bottom: 4px; }
    .gram-slot {
      display: inline-block; min-width: 64px; text-align: center; border-bottom: 2px dashed var(--teal);
      background: var(--bg); border-radius: 6px; padding: 2px 10px; margin: 0 4px; font-weight: 800; color: var(--ink-soft);
    }
    .gram-slot.filled { border-bottom: 2px solid var(--success); color: var(--success); }
    .gram-slot.ok { border-bottom: 3px solid var(--success); color: var(--success); background: #d3f9d8; }
    .gram-slot.no { border-bottom: 3px solid var(--danger); color: var(--danger); background: #ffe3e3; animation: gramShake 0.25s; }
    .gram-gap__hint { font-size: 0.85rem; margin: 2px 0 10px; }
    .gram-chips { display: flex; flex-wrap: wrap; gap: 8px; }
    .gram-chip {
      border: 1px solid var(--line); background: var(--bg); border-radius: 999px; padding: 8px 16px;
      font-weight: 700; font-size: 0.92rem; cursor: pointer; font-family: inherit; color: var(--ink);
      transition: all 0.12s;
    }
    .gram-chip:hover:not(:disabled) { border-color: var(--teal); background: var(--teal-soft); }
    .gram-chip.dragging { opacity: 0.4; }
    .gram-chip.okchip { background: #d3f9d8; border-color: #69db7c; color: var(--success); cursor: default; }
    .gram-chip.no { background: #ffe3e3; border-color: #ffa8a8; color: var(--danger); animation: gramShake 0.25s; }
    .gram-chip:disabled { cursor: default; }
    .gram-gap__fb { margin-top: 10px; font-weight: 700; font-size: 0.92rem; min-height: 20px; }
    .gram-gap__fb.ok { color: var(--success); }
    .gram-gap__fb.no { color: var(--teal-dark); }

    .gram-matchcard { margin-top: 10px; }

    .gram-analysis { margin-top: 24px; border-top: 6px solid var(--teal); }
    .gram-analysis__msg { font-size: 1.02rem; }
    .gram-analysis__bars { display: grid; gap: 10px; margin: 14px 0; }
    .gram-bar__row { display: flex; align-items: center; gap: 10px; font-size: 0.86rem; }
    .gram-bar__lab { flex: 0 0 130px; color: var(--ink-soft); font-weight: 600; }
    .gram-bar__track { flex: 1; height: 10px; background: var(--line); border-radius: 999px; overflow: hidden; }
    .gram-bar__fill { height: 100%; background: linear-gradient(90deg, var(--teal), var(--brand)); border-radius: 999px; transition: width 0.4s ease; }
    .gram-bar__num { flex: 0 0 60px; text-align: right; font-weight: 700; color: var(--ink-soft); }
    .gram-revlist { margin: 18px 0 16px; padding-top: 14px; border-top: 1px solid var(--line); }
    .gram-revlist__title { font-weight: 700; margin-bottom: 8px; }
    .gram-rev {
      display: block; width: 100%; text-align: left; margin: 6px 0; border: 1px solid var(--line);
      background: var(--bg); border-radius: 10px; padding: 10px 14px; font-weight: 700; font-size: 0.92rem;
      cursor: pointer; font-family: inherit; color: var(--ink);
    }
    .gram-rev:hover { border-color: var(--teal); color: var(--teal-dark); background: var(--teal-soft); }

    @media (max-width: 560px) {
      .gram-tabs { gap: 6px; }
      .gram-tab { padding: 7px 12px; font-size: 0.8rem; }
      .gram-bar__lab { flex-basis: 100px; }
    }
  </style>

  <script define:vars={{ level, unitId, unitTitle: unit.title, unitShort: unit.short, quiz, practice, mistakes, pairs: PAIRS }}>
    (function () {
      // ---- yardımcılar ----
      function shuffle(a) { var arr = a.slice(); for (var i = arr.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var t = arr[i]; arr[i] = arr[j]; arr[j] = t; } return arr; }
      function qs(sel, root) { return (root || document).querySelector(sel); }
      function qsa(sel, root) { return Array.prototype.slice.call((root || document).querySelectorAll(sel)); }

      var SUBJ = ['i', 'you', 'he', 'she', 'it', 'we', 'they'];
      var OBJ = ['me', 'him', 'us', 'them'];
      var SA = ['my', 'your', 'his', 'her', 'its', 'our', 'their'];
      var SZ = ['mine', 'yours', 'hers', 'ours', 'theirs'];
      function areaOf(w) {
        var s = String(w).toLowerCase().replace(/[^a-z']/g, '');
        if (SA.indexOf(s) !== -1) return 'iyelik-sifat';
        if (SZ.indexOf(s) !== -1) return 'iyelik-zamir';
        if (OBJ.indexOf(s) !== -1) return 'nesne';
        if (SUBJ.indexOf(s) !== -1) return 'ozne';
        return null;
      }
      var AREA_LABEL = { ozne: 'Özne Zamirleri', nesne: 'Nesne Zamirleri', 'iyelik-sifat': 'İyelik Sıfatları', 'iyelik-zamir': 'İyelik Zamirleri' };

      // ---- V. Modül ilerlemesi ----
      var totals = { mcq: quiz.length, gap: practice.length, apply: 5, match: 6 };
      var doneC = { mcq: 0, gap: 0, apply: 0, match: 0 };
      var results = []; // {area, ok}
      var grandTotal = totals.mcq + totals.gap + totals.apply + totals.match;

      function updProgress() {
        var answered = doneC.mcq + doneC.gap + doneC.apply + doneC.match;
        var pct = grandTotal ? Math.round((answered / grandTotal) * 100) : 0;
        var fill = document.getElementById('gramFillEnd');
        var pctEl = document.getElementById('gramPct');
        var sub = document.getElementById('gramProgSub');
        if (fill) fill.style.width = pct + '%';
        if (pctEl) pctEl.textContent = '%' + pct;
        if (sub) sub.textContent = answered + ' / ' + grandTotal + ' etkileşim tamamlandı';
      }
      updProgress();

      // ---- I. Sekmeler + kaydırma ----
      var itemsAll = qsa('#slideItems [data-slide]');
      var posEl = document.getElementById('slidePos');
      var tabEmpty = document.getElementById('tabEmpty');
      var cur = 0;
      var visibleEls = itemsAll.slice();

      function show(i) {
        if (!visibleEls.length) return;
        if (i < 0) i = 0; if (i >= visibleEls.length) i = visibleEls.length - 1;
        cur = i;
        visibleEls.forEach(function (it, idx) { it.style.display = idx === cur ? '' : 'none'; });
        if (posEl) posEl.textContent = (cur + 1) + ' / ' + visibleEls.length;
      }

      var tabBar = document.getElementById('tabBar');
      qsa('.gram-tab', tabBar).forEach(function (tab) {
        tab.addEventListener('click', function () {
          setTab(tab.getAttribute('data-tab'));
        });
      });

      function setTab(k) {
        qsa('.gram-tab').forEach(function (t) {
          var on = t.getAttribute('data-tab') === k;
          t.classList.toggle('on', on);
          t.setAttribute('aria-selected', on ? 'true' : 'false');
          t.classList.add('done'); // açılan sekme tamamlanmış sayılır
        });
        var mc = document.getElementById('matrixCard');
        if (mc) mc.setAttribute('data-emph', k);
        visibleEls = itemsAll.filter(function (it) {
          if (k === 'all') return true;
          return (it.getAttribute('data-cat') || 'genel') === k;
        });
        if (tabEmpty) tabEmpty.style.display = (k !== 'all' && visibleEls.length === 0) ? '' : 'none';
        if (visibleEls.length) cur = 0; show(cur);
      }

      var prev = document.getElementById('prevSlide');
      var next = document.getElementById('nextSlide');
      if (prev) prev.addEventListener('click', function () { show(cur - 1); });
      if (next) next.addEventListener('click', function () { show(cur + 1); });

      // ---- ortak eşleştirme motoru (Uygulama + Eşleştirme) ----
      function buildPair(cfg) {
        // cfg: {left, right, done, si, fn}
        var leftBox = document.getElementById(cfg.left);
        var rightBox = document.getElementById(cfg.right);
        var fb = document.getElementById(cfg.fb);
        var pairs = cfg.pairs;
        var sel = null;
        var n = pairs.length;
        var doneN = 0;
        var leftItems = [];
        var rightItems = [];
        var i;

        for (i = 0; i < n; i++) {
          var p = pairs[i];
          var li = document.createElement('button');
          li.type = 'button';
          li.className = 'gram-match__item';
          li.dataset.id = p.en;
          li.textContent = cfg.leftLabel(p);
          var ri = document.createElement('button');
          ri.type = 'button';
          ri.className = 'gram-match__item';
          ri.dataset.id = p.en;
          ri.textContent = cfg.rightLabel(p);
          leftItems.push({ btn: li, p: p });
          rightItems.push({ btn: ri, p: p });
          leftBox.appendChild(li);
          rightBox.appendChild(ri);
          li.addEventListener('click', (function (it) {
            return function () {
              if (it.btn.disabled) return;
              leftItems.forEach(function (x) { x.btn.classList.remove('sel'); });
              it.btn.classList.add('sel');
              sel = it;
            };
          })(leftItems[i]));
          ri.addEventListener('click', (function (it) {
            return function () {
              if (it.btn.disabled) return;
              if (!sel) { flash(fb, 'Önce soldan birini seç 👈'); return; }
              tryMatch(sel, it);
            };
          })(rightItems[i]));
        }

        function tryMatch(l, r) {
          if (l.p.en !== r.p.en) {
            l.btn.classList.remove('sel');
            l.btn.classList.add('no');
            r.btn.classList.add('no');
            var ll = l, rr = r;
            setTimeout(function () { ll.btn.classList.remove('no'); rr.btn.classList.remove('no'); l.btn.classList.remove('sel'); }, 400);
            flash(fb, 'Olmadı 🤏 — ' + (rr.p.ic || '') + ' ' + rr.p.tr + ' ile başka bir yeri dene.');
            sel = null;
            return;
          }
          l.btn.disabled = true;
          r.btn.disabled = true;
          l.btn.classList.add('ok');
          r.btn.classList.add('ok');
          l.btn.classList.remove('sel');
          doneN++;
          results.push({ area: areaOf(l.p.en), ok: true });
          if (cfg.onPair) cfg.onPair();
          if (doneN === n) {
            sel = null;
            flash(fb, cfg.doneMsg, true);
            if (cfg.onDone) cfg.onDone();
          } else {
            flash(fb, null, false, '');
          }
        }

        function flash(el, msg, ok, empty) {
          if (el) {
            el.textContent = msg || '';
            el.style.color = ok ? 'var(--success)' : (empty === '' ? '' : 'var(--teal-dark)');
          }
        }
        return {};
      }

      // ---- II. Satır içi Uygulama ----
      var applyToggle = document.getElementById('applyToggle');
      var applyStarted = false;
      applyToggle.addEventListener('click', function () {
        var body = document.getElementById('applyBody');
        var open = body.style.display !== 'none';
        body.style.display = open ? 'none' : '';
        if (!open && !applyStarted) {
          applyStarted = true;
          var chosen = shuffle(pairs.slice()).slice(0, 5);
          buildPair({
            left: 'applyL', right: 'applyR', fb: 'applyFb', pairs: chosen,
            leftLabel: function (p) { return p.tr; },
            rightLabel: function (p) { return p.en; },
            onPair: function () { doneC.apply++; updProgress(); },
            onDone: function () { doneC.apply = totals.apply; updProgress(); fbOk('applyFb', 'Süper! 5/5 eşleştirdin 🎉 Zamirler gitgide oturuyor.'); }
          });
        }
      });
      function fbOk(id, msg) { var el = document.getElementById(id); if (el) { el.textContent = msg; el.style.color = 'var(--success)'; } }

      // ---- III. MCQ (Neden? açıklamalı) ----
      var quizBox = document.getElementById('quizBox');
      if (quizBox) {
        quizBox.addEventListener('click', function (e) {
          var why = e.target.closest('[data-why]');
          if (why) {
            var box = why.parentNode.querySelector('[data-whybox]');
            if (box) { box.style.display = box.style.display === 'none' ? '' : 'none'; }
            return;
          }
          var btn = e.target.closest('.option');
          if (!btn || btn.disabled) return;
          var q = btn.closest('.quiz-q');
          if (!q) return;
          var reveal = q.querySelector('[data-reveal]');
          var opts = q.querySelectorAll('.option');
          var isCorrect = btn.getAttribute('data-correct') === '1';
          var idx = parseInt(q.getAttribute('data-idx') || '0', 10);
          var qq = quiz[idx];
          var ansIdx = qq ? qq.a : -1;
          var answer = qq ? qq.options[qq.a] : '';
          opts.forEach(function (o) { o.disabled = true; });
          q.querySelectorAll('.option[data-correct="1"]').forEach(function (o) { o.classList.add('correct'); });
          results.push({ area: areaOf(answer), ok: isCorrect });
          doneC.mcq++; updProgress();
          if (isCorrect) {
            if (reveal) { reveal.textContent = '✓ Doğru! Harikasın! 🎉'; reveal.className = 'reveal ok'; }
          } else {
            btn.classList.add('wrong');
            if (reveal) { reveal.textContent = 'Tekrar gözden geçir 💪 — doğru cevap yukarıda yeşil. Neden? ile öğren.'; reveal.className = 'reveal try'; }
          }
          var whyBtn = q.querySelector('[data-why]');
          var whyB = q.querySelector('[data-whybox]');
          if (whyBtn) whyBtn.style.display = '';
          if (whyB) whyB.textContent = explain(qq, ansIdx);
          if (qq && qq.options[qq.a] !== undefined && qq.options[qq.a] !== null && qq.q) { /* noop guard */ }

          if (doneC.mcq >= total) saveProgress();
        });
      }

      function explain(qq, ansIdx) {
        // Önce seçeneğe özel "neden yanlış/doğru" notu (varsa) göster
        if (qq && Array.isArray(qq.why) && ansIdx >= 0 && ansIdx < qq.why.length && qq.why[ansIdx]) {
          return qq.why[ansIdx] + ' 💡';
        }
        var word = qq && qq.options ? qq.options[ansIdx >= 0 ? ansIdx : (qq.a || 0)] : '';
        var s = String(word).toLowerCase();
        // yakın gerçek not: unit.mistakes 'n' alanlarında eşleştir, yoksa genel nazik not
        for (var i = 0; i < mistakes.length; i++) {
          if (String(mistakes[i].n || '').toLowerCase().indexOf(s) !== -1) return mistakes[i].n + ' 🙌';
        }
        for (var j = 0; j < mistakes.length; j++) {
          if (String(mistakes[j].r || '').toLowerCase().indexOf(s) !== -1) return mistakes[j].n + ' 💡';
        }
        return 'Doğru cevap: ' + word + '. Konu anlatımındaki karşılaştırma tablosunda bu biçimi tekrar bulabilirsin 💚';
      }

      // ---- III. Boşluğu Doldur (sürükle & bırak) ----
      function startGap() {
        qsa('#gapBox .gram-gap').forEach(function (g) {
          var slot = g.querySelector('[data-slot]');
          var chipBtns = g.querySelectorAll('.gram-chip');
          var ans = (g.getAttribute('data-ans') || '').toLowerCase();
          var hint = g.getAttribute('data-hint') || '';

          function tryChip(chip) {
            if (chip.disabled) return;
            var val = chip.getAttribute('data-val');
            if (String(val).toLowerCase() === ans) {
              slot.textContent = val;
              slot.classList.remove('no'); slot.classList.add('ok', 'filled');
              chip.disabled = true; chip.classList.add('okchip');
              chipBtns.forEach(function (c) { if (!c.classList.contains('okchip')) { c.disabled = true; c.style.opacity = 0.45; } });
              var fb = g.querySelector('[data-gf]');
              if (fb) { fb.textContent = '✓ Doğru! ' + (hint ? '💡 ' + hint + '.' : 'Harikasın!'); fb.className = 'gram-gap__fb ok'; }
              results.push({ area: areaOf(val), ok: true });
              doneC.gap++; updProgress();
              if (doneC.gap >= totals.gap) saveProgressFromPractice();
            } else {
              chip.classList.add('no');
              var c = chip;
              setTimeout(function () { c.classList.remove('no'); }, 400);
              var fb2 = g.querySelector('[data-gf]');
              if (fb2) { fb2.textContent = 'Hmm, tam değil 🤔 — ' + (hint ? 'İpucu: ' + hint : 'ipucuna bak'); fb2.className = 'gram-gap__fb no'; }
            }
          }

          chipBtns.forEach(function (chip, i) {
            chip.addEventListener('click', function () { tryChip(chip); });
            chip.addEventListener('dragstart', function (e) {
              e.dataTransfer.setData('text/plain', 'v' + i);
              chip.classList.add('dragging');
            });
            chip.addEventListener('dragend', function () { chip.classList.remove('dragging'); });
          });
          slot.addEventListener('dragover', function (e) { e.preventDefault(); });
          slot.addEventListener('drop', function (e) {
            e.preventDefault();
            // basit: ilk boş çipi dene
            for (var k = 0; k < chipBtns.length; k++) { if (!chipBtns[k].disabled) { tryChip(chipBtns[k]); break; } }
          });
          slot.addEventListener('click', function () {
            for (var k = 0; k < chipBtns.length; k++) { if (!chipBtns[k].disabled) { tryChip(chipBtns[k]); break; } }
          });
        });
      }
      startGap();

      // ---- III. Eşleştirme (ikidilli) ----
      var MATCH_DONE = false;
      var chosenMatch = shuffle(pairs.slice()).slice(0, 6);
      buildPair({
        left: 'matchL', right: 'matchR', fb: 'matchFb', pairs: chosenMatch,
        leftLabel: function (p) { return (p.ic || '') + ' ' + p.en; },
        rightLabel: function (p) { return p.tr; },
        onPair: function () { doneC.match++; updProgress(); },
        onDone: function () { doneC.match = totals.match; MATCH_DONE = true; updProgress(); var el = document.getElementById('matchFb'); if (el) { el.textContent = 'Harikasın! Tüm zamirleri eşleştirdin 🧲🎉'; el.style.color = 'var(--success)'; } saveProgressFromPractice(); }
      });

      // ---- IV. Sonuç / analiz + Uygulama Listesi ----
      document.getElementById('resultsBtn').addEventListener('click', function () {
        buildAnalysis();
        var a = document.getElementById('analysis');
        a.style.display = '';
        a.scrollIntoView({ behavior: 'smooth', block: 'near' });
        saveProgress();
      });

      function buildAnalysis() {
        var byArea = {};
        Object.keys(AREA_LABEL).forEach(function (k) { byArea[k] = { tried: 0, ok: 0 }; });
        results.forEach(function (r) {
          if (r.area && byArea[r.area]) { byArea[r.area].tried++; if (r.ok) byArea[r.area].ok++; }
        });
        // un-addressed alanlar (o konu test edilmedi) "nötr" olarak listede
        var bars = document.getElementById('anaBars');
        bars.innerHTML = '';
        var best = null, bestScore = -1, weak = null, weakScore = 2;
        Object.keys(AREA_LABEL).forEach(function (k) {
          var d = byArea[k];
          var score = d.tried ? (d.ok / d.tried) : 0;
          var pct = d.tried ? Math.round((d.ok / d.tried) * 100) : 0;
          var row = document.createElement('div');
          row.className = 'gram-bar__row';
          var lab = document.createElement('span'); lab.className = 'gram-bar__lab'; lab.textContent = AREA_LABEL[k];
          var tr = document.createElement('span'); tr.className = 'gram-bar__track';
          var fl = document.createElement('span'); fl.className = 'gram-bar__fill'; fl.style.width = pct + '%';
          tr.appendChild(fl);
          var nu = document.createElement('span'); nu.className = 'gram-bar__num'; nu.textContent = d.tried ? d.ok + '/' + d.tried : '—';
          row.appendChild(lab); row.appendChild(tr); row.appendChild(nu);
          bars.appendChild(row);
          if (d.tried) {
            if (score > bestScore) { bestScore = score; best = k; }
            if (score < weakScore && d.tried >= 1) { weakScore = score; weak = k; }
          }
        });
        // hiçbir alan test edilmediyse en zayıf olarak genel öneri
        var already = Object.keys(byArea).some(function (k) { return byArea[k].tried > 0; });
        var msgEl = document.getElementById('anaMsg');
        if (!already) {
          msgEl.innerHTML = '<strong>Zamirlerine güzel başladın!</strong> 📘 Biraz etkileşim tamamladıktan sonra burada konuya göre güçlü ve zayıf yönlerini göreceksin.';
        } else {
          var parts = [];
          parts.push('<strong>Zamirlerini güçlendirdin!</strong> 🎉');
          if (best) parts.push('En iyi konun: <strong>' + AREA_LABEL[best] + '</strong>.');
          var weakLabel = weak ? AREA_LABEL[weak] : 'İyelik biçimleri';
          parts.push('<strong>' + weakLabel + '</strong> \u00fczerinde biraz daha pratik yapabilirsin. Aşağıdaki <em>Uygulama Listesi</em>\u2019nden ilgili konuyu tekrar açabilirsin.');
          msgEl.innerHTML = parts.join(' ');
        }
      }

      // ---- Uygulama Listesi: sekmeye git + kaydır ----
      qsa('[data-gotab]').forEach(function (b) {
        b.addEventListener('click', function () {
          setTab(b.getAttribute('data-gotab'));
          var box = document.getElementById('slideBox');
          if (box) box.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });

      // ---- tekrar başlat ----
      document.getElementById('retryBtn').addEventListener('click', function () {
        results = [];
        doneC.mcq = doneC.gap = doneC.apply = doneC.match = 0;
        updProgress();
        setTab('all');
        // boşlukları sıfırla
        qsa('#gapBox .gram-gap').forEach(function (g) {
          var slot = g.querySelector('[data-slot]');
          slot.textContent = '?'; slot.className = 'gram-slot';
          qsa('.gram-chip', g).forEach(function (c) { c.disabled = false; c.classList.remove('okchip', 'no'); c.style.opacity = ''; });
          var fb = g.querySelector('[data-gf]'); if (fb) { fb.textContent = ''; fb.className = 'gram-gap__fb'; }
        });
        if (quizBox) {
          qsa('.quiz-q', quizBox).forEach(function (q) {
            qsa('.option', q).forEach(function (o) { o.disabled = false; o.classList.remove('correct', 'wrong'); });
            var r = q.querySelector('[data-reveal]'); if (r) { r.textContent = ''; r.className = 'reveal'; }
            var wb = q.querySelector('[data-why]'); if (wb) wb.style.display = 'none';
            var whyB = q.querySelector('[data-whybox]'); if (whyB) { whyB.style.display = 'none'; whyB.textContent = ''; }
          });
        }
        document.getElementById('analysis').style.display = 'none';
        if (tracker) tracker.reset();
      });

      // eşleştirme yuvalarını yeniden kurmak için basit tutucu
      var tracker = { reset: function () { window.location.reload(); } };

      // ---- saveProgress (mevcut /dashboard/progress) ----
      function saveProgress() {
        try {
          fetch('/dashboard/progress', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ module: 'grammar', payload: { level: level, unit: unitId, title: unitTitle, correct: quiz.length ? doneC.mcq : 0, total: quiz.length } })
          }).catch(function () {});
        } catch (e) {}
      }
      function saveProgressFromPractice() {
        // boşluk/eşleştirme bittiğinde de kayıt edilir (etkileşim derinliği korunur)
        try {
          fetch('/dashboard/progress', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ module: 'grammar', payload: { level: level, unit: unitId, title: unitTitle, correct: doneC.gap, total: totals.gap > 0 ? totals.gap : 1 } })
          }).catch(function () {});
        } catch (e) {}
      }

      // başlangıç durumu
      setTab('all');
    })();
  </script>
</AppLayout>