  </style>

  <script define:vars={{ level, unitId, unitTitle: unit.title, unitShort: unit.short, slides, quiz, practice, mistakes, pairs: PAIRS, pronounRelated }}>
    (function () {
      // ---- yardımcılar ----
      function shuffle(a) { var arr = a.slice(); for (var i = arr.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var t = arr[i]; arr[i] = arr[j]; arr[j] = t; } return arr; }
      function qs(sel, root) { return (root || document).querySelector(sel); }
      function qsa(sel, root) { return Array.prototype.slice.call((root || document).querySelectorAll(sel)); }

      var SUBJ = ['i', 'you', 'he', 'she', 'it', 'we', 'they'];
      var OBJ = ['me', 'him', 'us', 'them'];
      var SA = ['my', 'your', 'his', 'her', 'its', 'our', 'their'];
      var SZ = ['mine', 'yours', 'hers', 'ours', 'theirs'];
      function areaOf(w) {
        var s = String(w).toLowerCase().replace(/[^a-z']/g, '');
        if (SA.indexOf(s) !== -1) return 'iyelik-sifat';
        if (SZ.indexOf(s) !== -1) return 'iyelik-zamir';
        if (OBJ.indexOf(s) !== -1) return 'nesne';
        if (SUBJ.indexOf(s) !== -1) return 'ozne';
        return null;
      }
      var AREA_LABEL = { ozne: 'Özne Zamirleri', nesne: 'Nesne Zamirleri', 'iyelik-sifat': 'İyelik Sıfatları', 'iyelik-zamir': 'İyelik Zamirleri' };

      // ---- V. Modül ilerlemesi ----
      var totals = { mcq: quiz.length, gap: practice.length, apply: pronounRelated ? 5 : 0, match: pronounRelated ? 6 : 0, guided: 0 };
      var doneC = { mcq: 0, gap: 0, apply: 0, match: 0, guided: 0 };
      var results = []; // {area, ok}

      // ---- ★ Rehberli Biçim Dersi: FORM SINIFLANDIRICISI ----
      // Anlatım (slides) ve MCQ'ları olumlu/olumsuz/soru biçimlerine ayırır.
      // Pragmatik sezgisel: kusursuz olması gerekmez, makul olması yeterlidir.
      var QSTR = ['soru', 'question', '?'];                      // soru sinyalleri
      var AUXS = ['do ', 'does ', 'did ', 'is ', 'are ', 'am ', 'was ', 'were ', 'can ', 'could ', 'will ', 'would ', 'shall ', 'should ', 'may ', 'might ', 'must ', 'have ', 'has ', 'had ', 'who ', 'what ', 'where ', 'when ', 'why ', 'how '];
      var NEGW = ['olumsuz', 'negativ', 'olumsuzluk', "don't", "doesn't", "didn't", "isn't", "aren't", 'never', 'not'];
      function normT(s) { return String(s == null ? '' : s).toLocaleLowerCase('tr'); }
      function hasQuest(t) { return t.indexOf('?') !== -1; }
      function startAux(t) { for (var i = 0; i < AUXS.length; i++) { if (t.indexOf(AUXS[i]) === 0) return true; } return false; }
      function hasNegWord(t) { for (var i = 0; i < NEGW.length; i++) { if (t.indexOf(NEGW[i]) !== -1) return true; } return false; }
      // slayt biçimi: başlık + gövde
      function slideForm(h, b) {
        var t = normT((h || '') + ' ' + (b || ''));
        if (hasQuest(t)) return 'question';
        for (var i = 0; i < QSTR.length; i++) { if (t.indexOf(QSTR[i]) !== -1 && QSTR[i] !== '?') return 'question'; }
        if (hasNegWord(t)) return 'negative';
        return 'positive';
      }
      // MCQ biçimi: soru kökü + cevaplar (yanlış seçeneğin sinyal oluşturmasını önlemek
      // için doğru cevaba öncelik verilir; çeldiriciler ikincil toplu sinyal olarak kullanılır)
      function mcqForm(qq) {
        if (!qq) return 'positive';
        var q = normT(qq.q);
        if (hasQuest(q)) return 'question';
        if (startAux(q)) return 'question';
        if (q.indexOf('soru') !== -1) return 'question';
        var opts = qq.options || [];
        var ans = (typeof qq.a === 'number' && opts[qq.a]) ? normT(opts[qq.a]) : '';
        // doğru cevap olumsuzluk taşıyor mu?
        if (hasNegWord(ans)) return 'negative';
        // ya da seçeneklerin en az 2'si olumsuz (olumsuzluk seçimli bir soru)
        var negCnt = 0;
        for (var i = 0; i < opts.length; i++) { if (hasNegWord(normT(opts[i]))) negCnt++; }
        if (negCnt >= 2) return 'negative';
        return 'positive';
      }
      // biçim başına ayrıştır + 4 aşamalı adım listesi kur
      function buildGuided() {
        if (!quiz || !quiz.length) return null;
        var byForm = { positive: { slides: [], mcqs: [] }, negative: { slides: [], mcqs: [] }, question: { slides: [], mcqs: [] } };
        (slides || []).forEach(function (s) { var f = slideForm(s.h, s.b); byForm[f].slides.push(s); });
        quiz.forEach(function (qq) { var f = mcqForm(qq); byForm[f].mcqs.push(qq); });
        var allSlides = (slides || []).slice();
        var FORMDEF = [
          { key: 'positive', label: 'Olumlu', emoji: '\u{1F535}', color: '#0d9488' },
          { key: 'negative', label: 'Olumsuz', emoji: '\u{1F534}', color: '#e11d48' },
          { key: 'question', label: 'Soru', emoji: '\u{1F7E3}', color: '#7c3aed' }
        ];
        var stages = [];
        FORMDEF.forEach(function (fd) {
          var own = byForm[fd.key];
          var mc = own.mcqs.slice(0, 4);              // biçim kontrolü: en fazla 4 soru
          if (!own.slides.length && !mc.length) return; // biçim içeriği yok → aşama atla
          stages.push({ key: fd.key, label: fd.label, emoji: fd.emoji, color: fd.color, slides: own.slides.length ? own.slides : allSlides, mcqs: mc });
        });
        stages.push({ key: 'mixed', label: 'Karışık', emoji: '\u{1F9E9}', color: '#f59e0b', slides: allSlides, mcqs: shuffle(quiz.slice()).slice(0, 8) });
        var guidedCount = 0;
        stages.forEach(function (s) { guidedCount += s.mcqs.length; });
        return { stages: stages, guidedCount: guidedCount };
      }
      var guidedData = buildGuided();
      if (guidedData) { totals.guided = guidedData.guidedCount; }

      var grandTotal = totals.mcq + totals.gap + totals.apply + totals.match + (totals.guided || 0);

      function updProgress() {
        var answered = doneC.mcq + doneC.gap + doneC.apply + doneC.match + doneC.guided;
        var pct = grandTotal ? Math.round((answered / grandTotal) * 100) : 0;
        var fill = document.getElementById('gramFillEnd');
        var pctEl = document.getElementById('gramPct');
        var sub = document.getElementById('gramProgSub');
        if (fill) fill.style.width = pct + '%';
        if (pctEl) pctEl.textContent = '%' + pct;
        if (sub) sub.textContent = answered + ' / ' + grandTotal + ' etkileşim tamamlandı';
      }
      updProgress();

      // ---- Sihirbaz (Stepper) durum makinesi: tek adım görünür ----
      var stepOrder = (function () {
        var list = [];
        qsa('.wizard-step-btn').forEach(function (b) { if (b.getAttribute('data-hidden') !== '1') list.push(b.getAttribute('data-step')); });
        return list;
      })();
      var currentStep = 0;
      var stepEls = {};    // key -> section
      var stepBtns = {};   // key -> nav button
      qsa('.wizard-step').forEach(function (s) { stepEls[s.getAttribute('data-step')] = s; });
      qsa('.wizard-step-btn').forEach(function (b) { stepBtns[b.getAttribute('data-step')] = b; });
      var doneSteps = { lesson: true };

      function showStep(key, focusTop) {
        var idx = stepOrder.indexOf(key);
        if (idx < 0) return;
        currentStep = idx;
        qsa('.wizard-step').forEach(function (s) {
          s.classList.toggle('is-active', s.getAttribute('data-step') === key);
        });
        qsa('.wizard-step-btn').forEach(function (b) {
          var k = b.getAttribute('data-step');
          b.classList.toggle('on', k === key);
          b.classList.toggle('done', !!doneSteps[k]);
          b.setAttribute('aria-current', k === key ? 'step' : 'false');
        });
        if (focusTop) {
          var nav = document.getElementById('wizardNav');
          if (nav) nav.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
      function markDone(key) { doneSteps[key] = true; }
      function wizNext() { go(currentStep + 1); }
      function wizPrev() { go(currentStep - 1); }
      function go(idx) {
        if (idx < 0 || idx >= stepOrder.length) return;
        showStep(stepOrder[idx], true);
      }
      qsa('.wizard-step-btn').forEach(function (b) {
        b.addEventListener('click', function () { showStep(b.getAttribute('data-step'), true); });
      });
      qsa('.wizard-step').forEach(function (s) {
        var key = s.getAttribute('data-step');
        var foot = document.createElement('div');
        foot.className = 'wizard-foot';
        foot.innerHTML =
          (stepOrder.indexOf(key) > 0
            ? '<button type="button" class="btn ghost" data-wprev>← Önceki</button>'
            : '<span></span>') +
          '<button type="button" class="btn primary" data-wnext>' +
          (key === 'review' ? '🎉 Bitir' : 'Devam →') + '</button>';
        s.appendChild(foot);
      });
      qsa('[data-wprev]').forEach(function (b) {
        b.addEventListener('click', function () { wizPrev(); });
      });
      qsa('[data-wnext]').forEach(function (b) {
        b.addEventListener('click', function () {
          var cur = stepOrder[currentStep];
          markDone(cur);
          if (cur === 'review') { showAnalysis(); return; }
          wizNext();
        });
      });
      function showAnalysis() {
        buildAnalysis();
        var a = document.getElementById('analysis');
        if (a) a.style.display = '';
        saveProgress();
      }
      var resultsBtn = document.getElementById('resultsBtn');
      if (resultsBtn) resultsBtn.addEventListener('click', showAnalysis);

      showStep(stepOrder[0], false);

      // ---- I. Sekmeler + kaydırma (slayt görüntüleyici kaldırıldı;
      //      sadece matris vurgusu için setTab korunur) ----
      var itemsAll = qsa('#slideItems [data-slide]');
      var posEl = document.getElementById('slidePos');
      var tabEmpty = document.getElementById('tabEmpty');
      var cur = 0;
      var visibleEls = itemsAll.slice();

      function show(i) {
        if (!visibleEls.length) return;
        if (i < 0) i = 0; if (i >= visibleEls.length) i = visibleEls.length - 1;
        cur = i;
        visibleEls.forEach(function (it, idx) { it.style.display = idx === cur ? '' : 'none'; });
        if (posEl) posEl.textContent = (cur + 1) + ' / ' + visibleEls.length;
      }

      var tabBar = document.getElementById('tabBar');
      if (tabBar) {
        qsa('.gram-tab', tabBar).forEach(function (tab) {
          tab.addEventListener('click', function () {
            setTab(tab.getAttribute('data-tab'));
          });
        });
      }

      function setTab(k) {
        var mc = document.getElementById('matrixCard');
        if (mc) mc.setAttribute('data-emph', k);
        if (itemsAll.length) {
          visibleEls = itemsAll.filter(function (it) {
            if (k === 'all') return true;
            return (it.getAttribute('data-cat') || 'genel') === k;
          });
          if (tabEmpty) tabEmpty.style.display = (k !== 'all' && visibleEls.length === 0) ? '' : 'none';
          if (visibleEls.length) cur = 0; show(cur);
        }
      }

      var prev = document.getElementById('prevSlide');
      var next = document.getElementById('nextSlide');
      if (prev) prev.addEventListener('click', function () { show(cur - 1); });
      if (next) next.addEventListener('click', function () { show(cur + 1); });

      // --- Enrich the static slide viewer bodies into structured tables/cards ---
      (function () {
        qsa('#slideItems [data-slide] .body').forEach(function (el) {
          el.innerHTML = richBody(el.textContent);
        });
      })();

      // ---- ortak eşleştirme motoru (Uygulama + Eşleştirme) ----
      function buildPair(cfg) {
        // cfg: {left, right, done, si, fn}
        var leftBox = document.getElementById(cfg.left);
        var rightBox = document.getElementById(cfg.right);
        var fb = document.getElementById(cfg.fb);
        var pairs = cfg.pairs;
        var sel = null;
        var n = pairs.length;
        var doneN = 0;
        var leftItems = [];
        var rightItems = [];
        var i;

        // Left column keeps pair order; RIGHT column is SCRAMBLED so the two
        // columns are NOT positionally aligned (otherwise students match rows).
        var rightOrder = shuffle(pairs.slice());

        for (i = 0; i < n; i++) {
          var p = pairs[i];
          var li = document.createElement('button');
          li.type = 'button';
          li.className = 'gram-match__item';
          li.dataset.id = p.en;
          li.textContent = cfg.leftLabel(p);
          leftItems.push({ btn: li, p: p });
          leftBox.appendChild(li);
          li.addEventListener('click', (function (it) {
            return function () {
              if (it.btn.disabled) return;
              leftItems.forEach(function (x) { x.btn.classList.remove('sel'); });
              it.btn.classList.add('sel');
              sel = it;
            };
          })(leftItems[i]));

          // right column from the scrambled order
          var rp = rightOrder[i];
          var ri = document.createElement('button');
          ri.type = 'button';
          ri.className = 'gram-match__item';
          ri.dataset.id = rp.en;
          ri.textContent = cfg.rightLabel(rp);
          rightItems.push({ btn: ri, p: rp });
          rightBox.appendChild(ri);
          (function (it) {
            ri.addEventListener('click', function () {
              if (it.btn.disabled) return;
              if (!sel) { flash(fb, 'Önce soldan birini seç 👈'); return; }
              tryMatch(sel, it);
            });
          })(rightItems[rightItems.length - 1]);
        }

        function tryMatch(l, r) {
          if (l.p.en !== r.p.en) {
            l.btn.classList.remove('sel');
            l.btn.classList.add('no');
            r.btn.classList.add('no');
            var ll = l, rr = r;
            setTimeout(function () { ll.btn.classList.remove('no'); rr.btn.classList.remove('no'); l.btn.classList.remove('sel'); }, 400);
            flash(fb, 'Olmadı 🤏 — ' + (rr.p.ic || '') + ' ' + rr.p.tr + ' ile başka bir yeri dene.');
            sel = null;
            return;
          }
          l.btn.disabled = true;
          r.btn.disabled = true;
          l.btn.classList.add('ok');
          r.btn.classList.add('ok');
          l.btn.classList.remove('sel');
          doneN++;
          results.push({ area: areaOf(l.p.en), ok: true });
          if (cfg.onPair) cfg.onPair();
          if (doneN === n) {
            sel = null;
            flash(fb, cfg.doneMsg, true);
            if (cfg.onDone) cfg.onDone();
          } else {
            flash(fb, null, false, '');
          }
        }

        function flash(el, msg, ok, empty) {
          if (el) {
            el.textContent = msg || '';
            el.style.color = ok ? 'var(--success)' : (empty === '' ? '' : 'var(--teal-dark)');
          }
        }
        return {};
      }

      // ---- II. Satır içi Uygulama (yalnızca zamir/iyelik ünitesinde) ----
      var applyToggle = document.getElementById('applyToggle');
      var applyStarted = false;
      if (applyToggle) applyToggle.addEventListener('click', function () {
        var body = document.getElementById('applyBody');
        var open = body.style.display !== 'none';
        body.style.display = open ? 'none' : '';
        if (!open && !applyStarted) {
          applyStarted = true;
          var chosen = shuffle(pairs.slice()).slice(0, 5);
          buildPair({
            left: 'applyL', right: 'applyR', fb: 'applyFb', pairs: chosen,
            leftLabel: function (p) { return p.tr; },
            rightLabel: function (p) { return p.en; },
            onPair: function () { doneC.apply++; updProgress(); },
            onDone: function () { doneC.apply = totals.apply; updProgress(); fbOk('applyFb', 'Süper! 5/5 eşleştirdin 🎉 Zamirler gitgide oturuyor.'); }
          });
        }
      });
      function fbOk(id, msg) { var el = document.getElementById(id); if (el) { el.textContent = msg; el.style.color = 'var(--success)'; } }

      // ---- III. MCQ (Neden? açıklamalı) ----
      var quizBox = document.getElementById('quizBox');
      if (quizBox) {
        quizBox.addEventListener('click', function (e) {
          var why = e.target.closest('[data-why]');
          if (why) {
            var box = why.parentNode.querySelector('[data-whybox]');
            if (box) { box.style.display = box.style.display === 'none' ? '' : 'none'; }
            return;
          }
          var btn = e.target.closest('.option');
          if (!btn || btn.disabled) return;
          var q = btn.closest('.quiz-q');
          if (!q) return;
          var reveal = q.querySelector('[data-reveal]');
          var opts = q.querySelectorAll('.option');
          var isCorrect = btn.getAttribute('data-correct') === '1';
          var idx = parseInt(q.getAttribute('data-idx') || '0', 10);
          var qq = quiz[idx];
          var ansIdx = qq ? qq.a : -1;
          var answer = qq ? qq.options[qq.a] : '';
          opts.forEach(function (o) { o.disabled = true; });
          q.querySelectorAll('.option[data-correct="1"]').forEach(function (o) { o.classList.add('correct'); });
          results.push({ area: areaOf(answer), ok: isCorrect });
          doneC.mcq++; updProgress();
          if (isCorrect) {
            if (reveal) { reveal.textContent = '✓ Doğru! Harikasın! 🎉'; reveal.className = 'reveal ok'; }
          } else {
            btn.classList.add('wrong');
            if (reveal) { reveal.textContent = 'Tekrar gözden geçir 💪 — doğru cevap yukarıda yeşil. Neden? ile öğren.'; reveal.className = 'reveal try'; }
          }
          var whyBtn = q.querySelector('[data-why]');
          var whyB = q.querySelector('[data-whybox]');
          if (whyBtn) whyBtn.style.display = '';
          if (whyB) whyB.textContent = explain(qq, ansIdx);
          if (qq && qq.options[qq.a] !== undefined && qq.options[qq.a] !== null && qq.q) { /* noop guard */ }

          if (doneC.mcq >= total) saveProgress();
        });
      }

      function explain(qq, ansIdx) {
        // Önce seçeneğe özel "neden yanlış/doğru" notu (varsa) göster
        if (qq && Array.isArray(qq.why) && ansIdx >= 0 && ansIdx < qq.why.length && qq.why[ansIdx]) {
          return qq.why[ansIdx] + ' 💡';
        }
        var word = qq && qq.options ? qq.options[ansIdx >= 0 ? ansIdx : (qq.a || 0)] : '';
        var s = String(word).toLowerCase();
        // yakın gerçek not: unit.mistakes 'n' alanlarında eşleştir, yoksa genel nazik not
        for (var i = 0; i < mistakes.length; i++) {
          if (String(mistakes[i].n || '').toLowerCase().indexOf(s) !== -1) return mistakes[i].n + ' 🙌';
        }
        for (var j = 0; j < mistakes.length; j++) {
          if (String(mistakes[j].r || '').toLowerCase().indexOf(s) !== -1) return mistakes[j].n + ' 💡';
        }
        return 'Doğru cevap: ' + word + '. Konu anlatımındaki karşılaştırma tablosunda bu biçimi tekrar bulabilirsin 💚';
      }

      // ---- III. Boşluğu Doldur (sürükle & bırak) ----
      function startGap() {
        qsa('#gapBox .gram-gap').forEach(function (g) {
          var slot = g.querySelector('[data-slot]');
          var chipBtns = g.querySelectorAll('.gram-chip');
          var ans = (g.getAttribute('data-ans') || '').toLowerCase();
          var hint = g.getAttribute('data-hint') || '';

          function tryChip(chip) {
            if (chip.disabled) return;
            var val = chip.getAttribute('data-val');
            if (String(val).toLowerCase() === ans) {
              slot.textContent = val;
              slot.classList.remove('no'); slot.classList.add('ok', 'filled');
              chip.disabled = true; chip.classList.add('okchip');
              chipBtns.forEach(function (c) { if (!c.classList.contains('okchip')) { c.disabled = true; c.style.opacity = 0.45; } });
              var fb = g.querySelector('[data-gf]');
              if (fb) { fb.textContent = '✓ Doğru! ' + (hint ? '💡 ' + hint + '.' : 'Harikasın!'); fb.className = 'gram-gap__fb ok'; }
              results.push({ area: areaOf(val), ok: true });
              doneC.gap++; updProgress();
              if (doneC.gap >= totals.gap) saveProgressFromPractice();
            } else {
              chip.classList.add('no');
              var c = chip;
              setTimeout(function () { c.classList.remove('no'); }, 400);
              var fb2 = g.querySelector('[data-gf]');
              if (fb2) { fb2.textContent = 'Hmm, tam değil 🤔 — ' + (hint ? 'İpucu: ' + hint : 'ipucuna bak'); fb2.className = 'gram-gap__fb no'; }
            }
          }

          chipBtns.forEach(function (chip, i) {
            chip.addEventListener('click', function () { tryChip(chip); });
            chip.addEventListener('dragstart', function (e) {
              e.dataTransfer.setData('text/plain', 'v' + i);
              chip.classList.add('dragging');
            });
            chip.addEventListener('dragend', function () { chip.classList.remove('dragging'); });
          });
          slot.addEventListener('dragover', function (e) { e.preventDefault(); });
          slot.addEventListener('drop', function (e) {
            e.preventDefault();
            // basit: ilk boş çipi dene
            for (var k = 0; k < chipBtns.length; k++) { if (!chipBtns[k].disabled) { tryChip(chipBtns[k]); break; } }
          });
          slot.addEventListener('click', function () {
            for (var k = 0; k < chipBtns.length; k++) { if (!chipBtns[k].disabled) { tryChip(chipBtns[k]); break; } }
          });
        });
      }
      startGap();

      // ---- III. Eşleştirme (ikidilli; yalnızca zamir/iyelik ünitesinde) ----
      var MATCH_DONE = false;
      var matchBox = document.getElementById('matchL');
      if (pronounRelated && matchBox) {
        var chosenMatch = shuffle(pairs.slice()).slice(0, 6);
        buildPair({
          left: 'matchL', right: 'matchR', fb: 'matchFb', pairs: chosenMatch,
          leftLabel: function (p) { return (p.ic || '') + ' ' + p.en; },
          rightLabel: function (p) { return p.tr; },
          onPair: function () { doneC.match++; updProgress(); },
          onDone: function () { doneC.match = totals.match; MATCH_DONE = true; updProgress(); var el = document.getElementById('matchFb'); if (el) { el.textContent = 'Harikasın! Tüm zamirleri eşleştirdin 🧲🎉'; el.style.color = 'var(--success)'; } saveProgressFromPractice(); }
        });
      }

      // ---- IV. Karmakarışık Kelime (harf oyunu) — HER ünitede çalışır ----
      function esc(s) {
        var d = document.createElement('div'); d.textContent = s == null ? '' : String(s); return d.innerHTML;
      }

      // ---- Teacher-style structured slide renderer ----
      // Parses a plain slide body into: intro text (gdef), an optional
      // conjugation TABLE (rows from "X / Y ... → form" or "... → ..."),
      // and EXAMPLE sentence cards (lines starting '>' ). Examples may carry a
      // trailing "/TL: ..." hint and multiple sentences separated by '/'.
      function richBody(b) {
        if (!b) return '';
        var lines = String(b).split('\n');
        var out = [];
        var rows = [];     // conjugation table rows
        var exs = [];      // example cards
        function flushTable() {
          if (!rows.length) return;
          out.push('<table class="gconj"><tbody>' + rows.join('') + '</tbody></table>');
          rows = [];
        }
        function flushEx() {
          if (!exs.length) return;
          out.push('<div class="gexamples">' + exs.join('') + '</div>');
          exs = [];
        }
        function escHole(s) {
          return esc(s).replace(/\*\*(.*?)\*\*/g, '<b>$1</b>');
        }
        for (var i = 0; i < lines.length; i++) {
          var ln = lines[i].replace(/\r/g, '').trim();
          if (!ln) continue;
          // example line
          if (ln.charAt(0) === '>') {
            var body = ln.slice(1).trim();
            // "I / he / she / it → was"  => conjugation row
            var arrow = body.indexOf('→');
            if (arrow > -1) {
              flushEx();
              var left = body.slice(0, arrow).trim();
              var right = body.slice(arrow + 1).trim();
              var rightNoHint = right.split('/')[0].trim();
              rows.push('<tr><td>' + escHole(left) + '</td><td class="gform">' + escHole(rightNoHint) + '</td></tr>');
              continue;
            }
            // plain example sentence(s); allow multi via ' / ' but keep simple
            flushTable();
            // split on ' / ' only when it's clearly separate sentences ending with period
            var parts = body.split(' / ');
            for (var p = 0; p < parts.length; p++) {
              var seg = parts[p].trim().replace(/^["']|["']$/g, '');
              if (seg) exs.push('<span class="gex">💬 <b>' + escHole(seg) + '</b></span>');
            }
            continue;
          }
          // plain explanation text
          flushTable(); flushEx();
          out.push('<p class="gdef">' + escHole(ln) + '</p>');
        }
        flushTable(); flushEx();
        return out.join('');
      }
      var jumbleWordPool = (function () {
        var set = {}, out = [];
        // word (lowercase) -> example sentence tip (stem with blank filled)
        var tips = {};
        function fillTip(w, q) {
          if (!w || !q) return;
          var k = w.toLowerCase();
          if (tips[k] || q.indexOf('___') === -1) return;
          tips[k] = q.replace('___', w).replace(/^\s*[A-Za-z]/, function (m) { return m; });
        }
        function add(w) {
          w = (w || '').trim();
          if (!w) return;
          if (!/^[A-Za-z'’\-]{3,}$/.test(w)) return;
          var k = w.toLowerCase();
          if (!set[k]) { set[k] = 1; out.push(w); }
        }
        // practice (gap) correct answers with their sentence stems
        (practice || []).forEach(function (p) {
          (p.a || []).forEach(function (aw) {
            add(aw);
            fillTip(aw, p.q);
          });
        });
        // MCQ correct answers with their stems
        (quiz || []).forEach(function (q) {
          if (q && q.options && typeof q.a === 'number') {
            add(q.options[q.a]);
            fillTip(q.options[q.a], q.q);
          }
          (q.options || []).forEach(add);
        });
        jumbleTips = tips;
        return out;
      })().slice(0, 10);

      var jumbleHint = document.getElementById('jumbleHint');
      var jumbleWord = document.getElementById('jumbleWord');
      var jumbleLetters = document.getElementById('jumbleLetters');
      var jumbleFb = document.getElementById('jumbleFb');
      var curWord = null, picked = [];

      function shuffleString(s) {
        var arr = s.split('');
        for (var i = arr.length - 1; i > 0; i--) {
          var j = Math.floor(Math.random() * (i + 1));
          var t = arr[i]; arr[i] = arr[j]; arr[j] = t;
        }
        return arr.join('');
      }
      function renderJumble() {
        picked = [];
        curWord = jumbleWordPool[Math.floor(Math.random() * jumbleWordPool.length)];
        if (!curWord) { jumbleFb.textContent = 'Bu ünitede tıklanacak kelime yok.'; return; }
        var tip = (jumbleTips || {})[curWord.toLowerCase()];
        jumbleHint.innerHTML =
          'Bu ünitenin kelimelerinden biri: <b>' + curWord.length + ' harf</b>' +
          (tip ? '<div class="jumble-tip">💡 İpucu (cümle): <em>' + esc(tip) + '</em></div>' : '');
        var scrambled = shuffleString(curWord);
        var letters = '';
        for (var i = 0; i < scrambled.length; i++) {
          letters += '<button type="button" class="jub" data-li="' + i + '">' + esc(scrambled.charAt(i)) + '</button>';
        }
        jumbleLetters.innerHTML = letters;
        jumbleWord.innerHTML = '<span class="jub used" style="width:auto;padding:0 14px;">?</span>';
        jumbleFb.textContent = '';
        var bs = jumbleLetters.querySelectorAll('.jub');
        for (var i = 0; i < bs.length; i++) {
          bs[i].addEventListener('click', function () {
            if (this.classList.contains('used')) return;
            this.classList.add('used');
            var c = this.textContent;
            picked.push(c);
            // rebuild progress in word row
            var build = '';
            for (var p = 0; p < picked.length; p++) {
              build += '<span class="jub" style="pointer-events:none;">' + esc(picked[p]) + '</span>';
            }
            for (var r = picked.length; r < curWord.length; r++) {
              build += '<span class="jub used" style="width:auto;padding:0 12px;color:transparent;">_</span>';
            }
            jumbleWord.innerHTML = build;
            if (picked.length === curWord.length) {
              var attempt = picked.join('');
              var ok = attempt.toLowerCase() === curWord.toLowerCase();
              jumbleFb.style.color = ok ? 'var(--success)' : 'var(--danger)';
              jumbleFb.textContent = ok ? '✓ Doğru! Kelime: ' + curWord : '✗ Yanlış — doğrusu: ' + curWord + '. Yeniden dene 🔀';
              if (ok) { doneC.match++; updProgress(); saveProgressFromPractice(); }
            }
          });
        }
      }
      var jShuffle = document.getElementById('jumbleShuffle');
      var jNext = document.getElementById('jumbleNext');
      if (jShuffle && jNext && jumbleWordPool.length) {
        jShuffle.addEventListener('click', renderJumble);
        jNext.addEventListener('click', renderJumble);
        renderJumble();
      }

      // ---- ★ VIII. Rehberli Biçim Dersi — akış kontrolü (anlatım → kontrol → karışık) ----
      var guidedCard = document.getElementById('guidedCard');
      var guidedStepsEl = document.getElementById('guidedSteps');
      var G = null;
      function canGo(i) { return i === 0 || G.done[i - 1] === true; }
      function goStage(i) {
        if (!G || i < 0 || i >= G.stages.length || !canGo(i)) return;
        G.cur = i; G.phase = 'lecture'; G.slide = 0; G.ai = 0; G.mixOk = 0;
        renderGuidedPills();
        renderGuidedPanel();
      }
      function renderGuidedPills() {
        if (!guidedStepsEl) return;
        guidedStepsEl.innerHTML = '';
        G.stages.forEach(function (st, i) {
          var b = document.createElement('button');
          b.type = 'button';
          b.className = 'guided-pill';
          b.style.setProperty('--gc', st.color);
          var done = G.done[i] === true;
          b.classList.toggle('on', i === G.cur);
          b.classList.toggle('done', done);
          b.classList.toggle('locked', !canGo(i) && i !== G.cur);
          b.disabled = !canGo(i) && i !== G.cur;
          b.textContent = st.emoji + ' ' + st.label;
          b.addEventListener('click', function () { goStage(i); });
          guidedStepsEl.appendChild(b);
        });
      }
      function stageTitle(st) {
        return '<div class="guided-stage-title" style="background:' + st.color + ';">' + st.emoji + ' ' + (st.key === 'mixed' ? 'Karışık Sınav' : 'Anlatım · ' + st.label) + '</div>';
      }
      function renderGuidedPanel() {
        var panel = document.getElementById('guidedPanel');
        if (!panel) return;
        if (G.phase === 'lecture') renderLecture();
        else if (G.phase === 'check') renderCheck();
        else renderStageDone();
      }
      // a) ANLATIM aşaması: o biçimin slaytlarını tek tek göster
      function renderLecture() {
        var panel = document.getElementById('guidedPanel');
        var st = G.stages[G.cur];
        var html = stageTitle(st);
        html += '<div class="guided-slides" id="guidedSlides">';
        st.slides.forEach(function (s, i) {
          html += '<div class="guided-slide" data-gslide="' + i + '" style="' + (i === G.slide ? '' : 'display:none;') + '">';
          html += '<span class="guided-slide__badge" style="background:' + st.color + ';">' + st.emoji + ' ' + st.label + '</span>';
          html += '<h3>' + esc(s.h || '') + '</h3><div class="body">' + richBody(s.b || '') + '</div>';
          html += '</div>';
        });
        html += '</div>';
        if (st.slides.length > 1) {
          html += '<div class="guided-nav">' +
            '<button type="button" class="btn ghost" data-gprev>← Önceki</button>' +
            '<span class="muted">' + (G.slide + 1) + ' / ' + st.slides.length + '</span>' +
            '<button type="button" class="btn primary" data-gnext>Sonraki →</button></div>';
        }
        html += '<button type="button" class="btn primary guided-confirm" id="guidedConfirm">' + (st.key === 'mixed' ? '🧩 Sınava geç' : '✓ Anladım — Kontrole geç') + '</button>';
        panel.innerHTML = html;
        var pv = qs('[data-gprev]', panel), nx = qs('[data-gnext]', panel);
        if (pv) pv.addEventListener('click', function () { G.slide = Math.max(0, G.slide - 1); renderGuidedPanel(); });
        if (nx) nx.addEventListener('click', function () { G.slide = Math.min(st.slides.length - 1, G.slide + 1); renderGuidedPanel(); });
        var conf = document.getElementById('guidedConfirm');
        if (conf) conf.addEventListener('click', function () { G.phase = 'check'; G.ai = 0; if (st.key === 'mixed') G.mixOk = 0; renderGuidedPanel(); });
      }
      // b) KONTROL aşaması: o biçimin anında geri bildirimli 2-4 sorusu
      function renderCheck() {
        var panel = document.getElementById('guidedPanel');
        var st = G.stages[G.cur];
        var mcqs = st.mcqs;
        if (!mcqs.length) {
          panel.innerHTML = stageTitle(st) +
            '<div class="guided-note">Bu biçim için ayrı kontrol sorusu yok; anlatımı okudun. Devam et. 🚀</div>' +
            '<button type="button" class="btn primary guided-confirm" id="guidedConfirm">✓ Anladım — devam</button>';
          var c = document.getElementById('guidedConfirm');
          if (c) c.addEventListener('click', completeStage);
          return;
        }
        var ii = Math.min(G.ai, mcqs.length - 1);
        var qq = mcqs[ii];
        var html = stageTitle(st);
        html += '<div class="guided-qtip">' + (st.key === 'mixed'
          ? '🧩 Karışık deneme — tüm biçimlerden karışık ' + mcqs.length + ' soru.'
          : 'Bu biçimi kavradın mı? ' + mcqs.length + ' kısa soruyla kontrol edelim.') + '</div>';
        html += '<div class="guided-q card">' +
          '<div class="gq-q"><span class="gq-num" style="color:' + st.color + ';">' + st.emoji + ' Soru ' + (ii + 1) + ' / ' + mcqs.length + '</span><div style="margin-top:4px;">' + esc(qq.q) + '</div></div>' +
          '<div class="gq-opts">';
        qq.options.forEach(function (opt, oi) {
          html += '<button type="button" class="option" data-correct="' + (oi === qq.a ? '1' : '0') + '">' + String.fromCharCode(65 + oi) + ') ' + esc(opt) + '</button>';
        });
        html += '</div><div class="gq-fb" id="guidedFb"></div></div>';
        html += '<div class="guided-next-row"><button type="button" class="btn primary" id="guidedNextQ" style="display:none;">' +
          (ii + 1 >= mcqs.length ? (st.key === 'mixed' ? '🧩 Sınavı Bitir' : '✓ Bu biçimi kavradın') : 'Sonraki soru →') + '</button></div>';
        panel.innerHTML = html;
        qsa('.gq-opts .option', panel).forEach(function (b) {
          b.addEventListener('click', function () {
            if (b.disabled) return;
            var q = qs('.guided-q', panel);
            var fb = qs('#guidedFb', panel);
            var opts = qsa('.option', q);
            opts.forEach(function (o) { o.disabled = true; });
            qsa('[data-correct="1"]', q).forEach(function (o) { o.classList.add('correct'); });
            var correct = b.getAttribute('data-correct') === '1';
            if (!correct) b.classList.add('wrong');
            var qq2 = mcqs[ii];
            results.push({ area: areaOf(qq2.options[qq2.a]), ok: correct });
            doneC.guided++; updProgress();
            if (st.key === 'mixed') { if (correct) G.mixOk++; }
            if (correct) { fb.textContent = '✓ Doğru! Harikasın! 🎉'; fb.className = 'gq-fb ok'; }
            else { fb.textContent = '✗ Olmadı — doğru cevap: ' + qq2.options[qq2.a] + '. ' + explain(qq2, qq2.a); fb.className = 'gq-fb no'; }
            var nx2 = document.getElementById('guidedNextQ'); if (nx2) nx2.style.display = '';
          });
        });
        var nxt = document.getElementById('guidedNextQ');
        if (nxt) nxt.addEventListener('click', function () {
          G.ai++;
          if (G.ai >= mcqs.length) { completeStage(); } else { renderGuidedPanel(); }
        });
      }
      function completeStage() {
        G.done[G.cur] = true;
        G.phase = 'done';
        renderGuidedPills();
        renderGuidedPanel();
        if (G.stages[G.cur].key === 'mixed') { saveProgressFromPractice(); saveGuidedProgress(); }
      }
      // c) AŞAMA SONU: özet + sıradaki biçime / derin alıştırmalara geçiş
      function renderStageDone() {
        var panel = document.getElementById('guidedPanel');
        var st = G.stages[G.cur];
        var last = G.cur === G.stages.length - 1;
        var html = stageTitle(st);
        html += '<div class="guided-done">';
        if (st.key === 'mixed') {
          html += '<div class="guided-score">🧩 Skorun: ' + G.mixOk + ' / ' + st.mcqs.length + '</div>';
          html += '<div class="guided-done__msg">🎉 Karışık sınavı tamamladın — rehberli ders bitti!</div>';
        } else {
          html += '<div class="guided-done__msg">✓ Bu biçimi kavradın — Sıradaki biçime geç →</div>';
        }
        html += '</div>';
        if (!last) {
          var nst = G.stages[G.cur + 1];
          html += '<button type="button" class="btn primary guided-confirm" id="guidedNextStage">' + nst.emoji + ' ' + nst.label + ' →</button>';
        }
        if (last) {
          html += '<div class="guided-deep">' +
            '<div style="font-weight:800;font-size:1.05rem;margin-bottom:6px;">💪 Şimdi daha derin alıştırmalar</div>' +
            '<p class="muted" style="margin:0 0 10px;">Anlatım ve rehberli kontrol bitti. Aşağıdaki adımlarda tam test, boşluk doldurma ve eşleştirme ile kalıcılaştır.</p>' +
            '<button type="button" class="btn primary" id="guidedDeep">📈 Derin alıştırmalara geç →</button>' +
            '<button type="button" class="btn ghost" id="guidedReplay">🔁 Rehberli dersi tekrar izle</button></div>';
        }
        panel.innerHTML = html;
        var nsb = document.getElementById('guidedNextStage');
        if (nsb) nsb.addEventListener('click', function () { goStage(G.cur + 1); });
        var deep = document.getElementById('guidedDeep');
        if (deep) deep.addEventListener('click', function () {
          var target = quiz.length ? 'mcq' : (practice.length ? 'gap' : 'match');
          showStep(target, true);
        });
        var rep = document.getElementById('guidedReplay');
        if (rep) rep.addEventListener('click', function () { G.done = {}; G.cur = 0; goStage(0); });
      }
      function saveGuidedProgress() {
        try {
          fetch('/dashboard/progress', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ module: 'grammar', payload: { level: level, unit: unitId, title: unitTitle, guided: true, correct: (doneC.guided || 0), total: (totals.guided || 1) } })
          }).catch(function () {});
        } catch (e) {}
      }
      function initGuided() {
        if (!guidedCard || !guidedData) return;
        G = { stages: guidedData.stages, cur: 0, phase: 'lecture', slide: 0, ai: 0, done: {}, mixOk: 0 };
        guidedCard.style.display = '';
        renderGuidedPills();
        renderGuidedPanel();
      }

      // ---- V. Sonuç / analiz + Uygulama Listesi ----
      document.getElementById('resultsBtn').addEventListener('click', function () {
        buildAnalysis();
        var a = document.getElementById('analysis');
        a.style.display = '';
        a.scrollIntoView({ behavior: 'smooth', block: 'near' });
        saveProgress();
      });

      function buildAnalysis() {
        var byArea = {};
        Object.keys(AREA_LABEL).forEach(function (k) { byArea[k] = { tried: 0, ok: 0 }; });
        results.forEach(function (r) {
          if (r.area && byArea[r.area]) { byArea[r.area].tried++; if (r.ok) byArea[r.area].ok++; }
        });
        // un-addressed alanlar (o konu test edilmedi) "nötr" olarak listede
        var bars = document.getElementById('anaBars');
        bars.innerHTML = '';
        var best = null, bestScore = -1, weak = null, weakScore = 2;
        Object.keys(AREA_LABEL).forEach(function (k) {
          var d = byArea[k];
          var score = d.tried ? (d.ok / d.tried) : 0;
          var pct = d.tried ? Math.round((d.ok / d.tried) * 100) : 0;
          var row = document.createElement('div');
          row.className = 'gram-bar__row';
          var lab = document.createElement('span'); lab.className = 'gram-bar__lab'; lab.textContent = AREA_LABEL[k];
          var tr = document.createElement('span'); tr.className = 'gram-bar__track';
          var fl = document.createElement('span'); fl.className = 'gram-bar__fill'; fl.style.width = pct + '%';
          tr.appendChild(fl);
          var nu = document.createElement('span'); nu.className = 'gram-bar__num'; nu.textContent = d.tried ? d.ok + '/' + d.tried : '—';
          row.appendChild(lab); row.appendChild(tr); row.appendChild(nu);
          bars.appendChild(row);
          if (d.tried) {
            if (score > bestScore) { bestScore = score; best = k; }
            if (score < weakScore && d.tried >= 1) { weakScore = score; weak = k; }
          }
        });
        // hiçbir alan test edilmediyse en zayıf olarak genel öneri
        var already = Object.keys(byArea).some(function (k) { return byArea[k].tried > 0; });
        var msgEl = document.getElementById('anaMsg');
        if (!already) {
          msgEl.innerHTML = pronounRelated
            ? '<strong>Zamirlerine güzel başladın!</strong> 📘 Biraz etkileşim tamamladıktan sonra burada konuya göre güçlü ve zayıf yönlerini göreceksin.'
            : '<strong>Konuda güzel bir başlangıç yaptın!</strong> 📘 Alıştırmaları tamamladıkça ilerlemen burada izlenebilir.';
        } else {
          var parts = [];
          parts.push(pronounRelated ? '<strong>Zamirlerini güçlendirdin!</strong> 🎉' : '<strong>Çalışmayı tamamladın!</strong> 🎉');
          if (best) parts.push('En iyi konun: <strong>' + AREA_LABEL[best] + '</strong>.');
          var weakLabel = weak ? AREA_LABEL[weak] : 'İyelik biçimleri';
          if (pronounRelated) {
            parts.push('<strong>' + weakLabel + '</strong> üzerinde biraz daha pratik yapabilirsin. Aşağıdaki <em>Uygulama Listesi</em>den ilgili konuyu tekrar açabilirsin.');
          } else {
            parts.push('Aynı ünitedeki alıştırmaları tekrar çözerek kalıcılaştırabilirsin.');
          }
          msgEl.innerHTML = parts.join(' ');
        }
      }

      // ---- Uygulama Listesi: sekmeye git + kaydır ----
      qsa('[data-gotab]').forEach(function (b) {
        b.addEventListener('click', function () {
          setTab(b.getAttribute('data-gotab'));
          var box = document.getElementById('slideBox');
          if (box) box.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });

      // ---- tekrar başlat ----
      document.getElementById('retryBtn').addEventListener('click', function () {
        results = [];
        doneC.mcq = doneC.gap = doneC.apply = doneC.match = doneC.guided = 0;
        updProgress();
        setTab('all');
        // boşlukları sıfırla
        qsa('#gapBox .gram-gap').forEach(function (g) {
          var slot = g.querySelector('[data-slot]');
          slot.textContent = '?'; slot.className = 'gram-slot';
          qsa('.gram-chip', g).forEach(function (c) { c.disabled = false; c.classList.remove('okchip', 'no'); c.style.opacity = ''; });
          var fb = g.querySelector('[data-gf]'); if (fb) { fb.textContent = ''; fb.className = 'gram-gap__fb'; }
        });
        if (quizBox) {
          qsa('.quiz-q', quizBox).forEach(function (q) {
            qsa('.option', q).forEach(function (o) { o.disabled = false; o.classList.remove('correct', 'wrong'); });
            var r = q.querySelector('[data-reveal]'); if (r) { r.textContent = ''; r.className = 'reveal'; }
            var wb = q.querySelector('[data-why]'); if (wb) wb.style.display = 'none';
            var whyB = q.querySelector('[data-whybox]'); if (whyB) { whyB.style.display = 'none'; whyB.textContent = ''; }
          });
        }
        document.getElementById('analysis').style.display = 'none';
        if (tracker) tracker.reset();
      });

      // eşleştirme yuvalarını yeniden kurmak için basit tutucu
      var tracker = { reset: function () { window.location.reload(); } };

      // ---- saveProgress (mevcut /dashboard/progress) ----
      function saveProgress() {
        try {
          fetch('/dashboard/progress', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ module: 'grammar', payload: { level: level, unit: unitId, title: unitTitle, correct: quiz.length ? doneC.mcq : 0, total: quiz.length } })
          }).catch(function () {});
        } catch (e) {}
      }
      function saveProgressFromPractice() {
        // boşluk/eşleştirme bittiğinde de kayıt edilir (etkileşim derinliği korunur)
        try {
          fetch('/dashboard/progress', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ module: 'grammar', payload: { level: level, unit: unitId, title: unitTitle, correct: doneC.gap, total: totals.gap > 0 ? totals.gap : 1 } })
          }).catch(function () {});
        } catch (e) {}
      }

      // başlangıç durumu
      initGuided();
      setTab('all');
    })();
  </script>
</AppLayout>