---
// Languago — Dilbilgisi Ünitesi (derin öğrenme etkileşimi)
// Auth/SSR/guard/saveProgress korunur. Tüm içerik mevcut ünite verisinden
// (slides / mistakes / practice / MCQ) türetilir. Vanilla JS, teal+orange.
import AppLayout from '../../../../layouts/AppLayout.astro';
import { getSessionUser } from '../../../../lib/auth';
import { pageCookieSource } from '../../../../lib/supabase';
import { GRAMMAR_LEVELS, loadGrammar, loadGrammarMcq, exportSuffix, levelTitle } from '../../../../lib/study';

const user = await getSessionUser(pageCookieSource(Astro));
if (!user) return Astro.redirect('/signin');

const level = Astro.params.level ?? '';
const unitId = Astro.params.unit ?? '';
const meta = GRAMMAR_LEVELS[level as keyof typeof GRAMMAR_LEVELS];
if (!meta) return Astro.redirect('/dashboard/dilbilgisi');

const mod = await loadGrammar(level);
const grammar = mod ? mod[`GRAMMAR_${exportSuffix(level)}`] : null;
const mcqMod = await loadGrammarMcq(level);
const mcqGroups: Record<string, { q: string; options: string[]; a: number }[] | undefined> =
  mcqMod ? mcqMod[`GRAMMAR_MCQ_${exportSuffix(level)}`] : null;

const unit = grammar?.units?.find((u: any) => u.id === unitId);
if (!unit) return Astro.redirect(`/dashboard/dilbilgisi/${level}`);

const slides: { h: string; b: string }[] = unit.slides ?? [];
const mistakes: { w: string; r: string; n: string }[] = unit.mistakes ?? [];
const practice: { q: string; hint: string; a: string[] }[] = unit.practice ?? [];
const quiz: { q: string; options: string[]; a: number }[] = (mcqGroups && mcqGroups[unitId]) || [];
const total = quiz.length;

// --- sekme kategorisi: slayt başlığından türetilir (genel ünitelerde zarifçe boşalır) ---
function normTR(s: string): string {
  // Türkçe yerelinde küçült (İ→ı) sonra ince/düz ı-i ayrımını birleştir.
  return String(s).toLocaleLowerCase('tr').replace(/ı/g, 'i');
}
function slideCat(h: string): string {
  const t = normTR(h);
  if (t.includes('nesne')) return 'nesne';
  if (t.includes('iyelik') && t.includes('sifat')) return 'iyelik-sifat';
  if (t.includes('iyelik') && t.includes('zamir')) return 'iyelik-zamir';
  if (t.includes('ozne') || t.includes('zamir')) return 'ozne';
  return 'genel';
}

const TABS = [
  { k: 'all', label: 'Tümü' },
  { k: 'ozne', label: 'Özne Zamirleri' },
  { k: 'nesne', label: 'Nesne Zamirleri' },
  { k: 'iyelik-sifat', label: 'İyelik Sıfatları' },
  { k: 'iyelik-zamir', label: 'İyelik Zamirleri' },
];

// A1 iyelik/zamir karşılaştırma matrisi (öğrenme amaçlı statik haritadır).
const MATRIX = [
  { tr: 'Ben', subj: 'I', obj: 'me', sa: 'my', sz: 'mine' },
  { tr: 'Sen', subj: 'You', obj: 'you', sa: 'your', sz: 'yours' },
  { tr: 'O (erkek)', subj: 'He', obj: 'him', sa: 'his', sz: 'his' },
  { tr: 'O (kadın)', subj: 'She', obj: 'her', sa: 'her', sz: 'hers' },
  { tr: 'O (nesne)', subj: 'It', obj: 'it', sa: 'its', sz: '—' },
  { tr: 'Biz', subj: 'We', obj: 'us', sa: 'our', sz: 'ours' },
  { tr: 'Onlar', subj: 'They', obj: 'them', sa: 'their', sz: 'theirs' },
];

// Uygulama / Eşleştirme için ikidilli mini havuz.
const PAIRS = [
  { en: 'I', tr: 'Ben', ic: '🙋' },
  { en: 'you', tr: 'Sen', ic: '🫵' },
  { en: 'he', tr: 'O (erkek)', ic: '👦' },
  { en: 'She', tr: 'O (kadın)', ic: '👩' },
  { en: 'my', tr: 'Benim', ic: '👤' },
  { en: 'your', tr: 'Senin', ic: '🫱' },
  { en: 'his', tr: 'Onun (erkek)', ic: '🧑' },
  { en: 'her', tr: 'Onun (kadın)', ic: '👩‍🦰' },
  { en: 'our', tr: 'Bizim', ic: '👥' },
  { en: 'their', tr: 'Onların', ic: '🧑‍🤝‍🧑' },
];

// Boşluk doldurma çipleri: doğru cevap + havuzdan çeldiriciler.
function shuffleArr<T>(arr: T[]): T[] {
  const a = arr.slice();
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}
const pool: string[] = Array.from(new Set([
  ...practice.flatMap((p) => (p.a || []) as string[]),
  ...quiz.flatMap((q) => q.options),
]));
const gapChips: string[][] = practice.map((p) => {
  const correct = (p.a && p.a[0]) || '';
  const others = pool.filter(
    (x) => String(x).toLowerCase() !== correct.toLowerCase() &&
      !(p.a || []).some((aa) => aa.toLowerCase() === String(x).toLowerCase())
  );
  return shuffleArr([correct, ...others.slice(0, 3)]);
});

const interactCount = quiz.length + practice.length + 5 + 6; // MCQ+boşluk+uygulama+eşleştirme

// --- Konu uygunluk algılayıcı: zamir/iyelik ünitesi mi? ---
// Aynı şablon tüm ünitelerde çalışır; ancak karşılaştırma matrisi, İyelik
// sekmeleri ve zamir eşleştirme etkinlikleri YALNIZCA zamir/iyelik konularına
// aittir. Aksi hâlde (ör. To Be, Artikeller) bir öğretmen bu tabloyu göstermez.
function isPronounUnit(): boolean {
  // Yalnızca başlık + slayt başlıklarına bakılır (gövde değil): gövde örnek
  // cümleleri 'me/him/her/my/them' gibi kelimeleri her konuda içerebilir ve
  // yanlış eşleşme üretir. Karar güvenilir sinyale (başlık) dayanır.
  const hay = [unit.title, unit.short, ...(unit.slides ?? []).map((s: any) => s.h)]
    .join(' ')
    .toLocaleLowerCase('tr');
  const markers = ['zamir', 'iyelik', 'pronoun', 'possessive', 'personal pron',
    'object pron', 'subject pron', 'benim', 'senin', 'onun', 'bizim', 'sizin',
    'mine,', 'yours,', 'his,', 'hers,', 'ours,', 'theirs,', 'sahip', 'iyelik zamiri'];
  return markers.some((m) => hay.includes(m));
}
const pronounRelated = isPronounUnit();
// Zamirle ilgisiz ünitelerde sekmeler 'Tümü' dışındaki kategorileri gereksiz kılar.
const TABS_ACTIVE = pronounRelated
  ? TABS
  : TABS.filter((t) => t.k === 'all');
---

<AppLayout title={`${unit.title} — ${levelTitle(level)} · Languago`} description={meta.subtitle}>
  <main class="study gram">
    <nav class="crumb">
      <a class="back" href="/dashboard">Öğrenci Paneli</a>
      <span class="sep">›</span>
      <a class="lnk" href="/dashboard/dilbilgisi">Dilbilgisi</a>
      <span class="sep">›</span>
      <a class="lnk" href={`/dashboard/dilbilgisi/${level}`}>{levelTitle(level)}</a>
      <span class="sep">›</span>
      <span class="cur">{unit.title}</span>
    </nav>
    <h1 style={`color:${meta.color};`}>{unit.title}</h1>
    <p class="muted">{unit.short} · {slides.length} slayt{interactCount ? ` · ${interactCount} etkileşimli alıştırma` : ''}</p>
    <div class="barline"></div>

    <!-- V. Modül düzeyi ilerleme göstergesi -->
    <div class="gram-progress card">
      <div class="gram-progress__head"><span>💧 İlerleme</span><strong id="gramPct">%0</strong></div>
      <div class="pbar-track"><div class="pbar-fill gram-progress__fill" id="gramFillEnd"></div></div>
      <div class="gram-progress__sub" id="gramProgSub">Etkileşimleri tamamladıkça ilerlemen dolar.</div>
    </div>

    <!-- Adımlı Sihirbaz (Stepper): tek seferde tek adım görünür -->
    <nav class="wizard-nav" id="wizardNav" aria-label="Ders adımları">
      {[
        { key: 'lesson', label: '📘 Ders' },
        { key: 'mcq', label: '🧩 Test' },
        { key: 'gap', label: '✍️ Boşluk' },
        { key: 'match', label: '🧲 Eşleştirme' },
        { key: 'review', label: '📊 Sonuç' },
      ].map((s) => (
        <button type="button" class="wizard-step-btn" data-step={s.key}
          data-hidden={s.hidden ? '1' : '0'}
          {s.hidden ? 'hidden' : ''}>{s.label}</button>
      ))}
    </nav>

    <!-- ADIM 1 · Ders -->
    <section class="wizard-step" data-step="lesson">
    <!-- ★ REHBERLİ BİÇİM DERSİ — biçim biçim öğreten ana yöntem (ilkel öğrenme yolu) -->
    <div class="guided card" id="guidedCard" style="display:none;">
      <div class="guided__head">
        <div class="guided__title">🎯 Rehberli Biçim Dersi</div>
        <p class="muted">Konuyu <strong>biçim biçim</strong> öğren: önce anlatımı oku, hemen mini-kontrole geç, sonra sıradaki biçime geç. Biçimleri bitirince <strong>karışık sınav</strong> seni bekliyor. 🚀</p>
      </div>
      <div class="guided__steps" id="guidedSteps" role="tablist" aria-label="Biçim adımları"></div>
      <div class="guided__panel" id="guidedPanel"></div>
    </div>
      <div class="lesson-layout">
        <div class="lesson-col">
    <!-- Karşılaştırmalı renk kodlu zamir matrisi (yalnızca zamir/iyelik ünitesinde) -->
    {pronounRelated && (
    <div class="gram-matrix card" id="matrixCard" data-emph="all">
      <h3 style="margin-bottom:2px;">🔎 Karşılaştırma Tablosu</h3>
      <p class="muted">Dört biçimi aynı kişiyle yan yana gör. Bir hücreye gelince <strong>satırın tüm biçimleri</strong> vurgulanır.</p>
      <div class="gram-matrix__wrap">
        <table class="gram-matrix__t">
          <thead>
            <tr>
              <th class="gm-person">Kişi</th>
              <th class="gm-sub">Özne <small>Zamirleri</small></th>
              <th class="gm-obj">Nesne <small>Zamirleri</small></th>
              <th class="gm-sa">İyelik <small>Sıfatı</small></th>
              <th class="gm-sz">İyelik <small>Zamiri</small></th>
            </tr>
          </thead>
          <tbody>
            {MATRIX.map((r) => (
              <tr>
                <td class="gm-person">{r.tr}</td>
                <td class="gm-sub">{r.subj}</td>
                <td class="gm-obj">{r.obj}</td>
                <td class="gm-sa">{r.sa}</td>
                <td class="gm-sz">{r.sz}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="gram-matrix__legend">
        <span class="gm-legend gm-l-sub">Özne</span>
        <span class="gm-legend gm-l-obj">Nesne</span>
        <span class="gm-legend gm-l-sa">İyelik Sıfatı</span>
        <span class="gm-legend gm-l-sz">İyelik Zamiri</span>
      </div>
    </div>
    )}
    {!pronounRelated && (
      <p class="muted" style="margin-top:18px;">Bu ünitede tablo kategorilerine ayrılmış özel bir konu yok — yukarıdaki rehberli anlatımı okuyup alıştırmaları çözerek ilerle. 💪</p>
    )}
    </div><!-- /lesson-col: karşılaştırma -->
      </div><!-- /lesson-layout -->

    <!-- Hızlı Uygulama (zamir eşleştirme — yalnızca zamir/iyelik ünitesinde) -->
    {pronounRelated && (
    <div class="gram-apply card" id="applyCard">
      <button type="button" id="applyToggle" class="btn primary">⚡ Hızlı Uygulama (30 sn)</button>
      <div id="applyBody" class="gram-apply__body" style="display:none;">
        <p class="muted">İngilizce biçimi Türkçe karşılığıyla eşleştir: önce <strong>soldan</strong> birini, sonra <strong>sağdan</strong> karşılığını seç.</p>
        <div class="gram-match">
          <div class="gram-match__col" id="applyL"></div>
          <div class="gram-match__col" id="applyR"></div>
        </div>
        <div class="gram-match__fb" id="applyFb"></div>
      </div>
    </div>
    )}
    </section>

    <!-- ADIM 2 · Test (Çoktan Seçmeli) -->
    <section class="wizard-step" data-step="mcq">
    <!-- III. Çeşitlendirilmiş Pekiştirme -->
    <h2 style="font-size:1.2rem;margin-top:34px;">🧩 Pekiştirme Testi</h2>

    {total > 0 && (
      <>
        <div class="pbar">
          <div class="pbar-track"><div class="pbar-fill" id="gramFill" data-total={total}></div></div>
          <span class="pbar-label" id="gramPbar">0 / {total} soru</span>
        </div>
        <div class="gram-qtip card">
          Her soru için <strong>anında</strong> geri bildirim alırsın; yanlışta <strong>Neden?</strong> ile açıklamayı gör.
        </div>
        <div id="quizBox">
          {quiz.map((qq, i) => (
            <div class="quiz-q" data-idx={i} data-total={total}>
              <div class="qq">{i + 1}. {qq.q}</div>
              {qq.options.map((opt, oi) => (
                <button type="button" class="option" data-correct={oi === qq.a ? '1' : '0'}>{String.fromCharCode(65 + oi)}) {opt}</button>
              ))}
              <div class="reveal" data-reveal></div>
              <button type="button" class="gram-why" data-why style="display:none;">💡 Neden?</button>
              <div class="gram-whybox" data-whybox style="display:none;"></div>
            </div>
          ))}
        </div>
      </>
    )}
    </section>

    <!-- ADIM 3 · Boşluk Doldurma -->
    <section class="wizard-step" data-step="gap">
    {practice.length > 0 && (
      <>
        <h3 style="margin-top:30px;">✍️ Boşluğu Doldur <span class="muted" style="font-weight:500;">(çipi tıkla ya da boşluğa sürükle)</span></h3>
        <div id="gapBox">
          {practice.map((p, i) => {
            const parts = p.q.split('___');
            return (
              <div class="gram-gap" data-ans={(p.a && p.a[0]) || ''} data-hint={p.hint || ''} data-idx={i}>
                <div class="gram-gap__q">
                  {parts.length > 1 ? (
                    <>
                      {parts[0]}<span class="gram-slot" data-slot role="button">?</span>{parts[1]}
                    </>
                  ) : (
                    <>{p.q}<span class="gram-slot" data-slot role="button">?</span></>
                  )}
                </div>
                <div class="gram-gap__hint muted">💡 {p.hint || 'İpucu yok'}</div>
                <div class="gram-chips">
                  {(gapChips[i] || []).map((c) => (
                    <button type="button" class="gram-chip" draggable="true" data-val={c}>{c}</button>
                  ))}
                </div>
                <div class="gram-gap__fb" data-gf></div>
              </div>
            );
          })}
        </div>
      </>
    )}
    </section>

    <!-- ADIM 4 · Eşleştirme / Kelime Karmakarışık -->
    <section class="wizard-step" data-step="match">
      <div class="gram-jumble card">
        <h3 style="margin:0 0 4px;">🔄 Karmakarışık Kelime</h3>
        <p class="muted">Harfleri karıştırılmış kelimeyi doğru sırayla kur: harflere tıkla ve kelimeyi yaz.</p>
        <div class="gram-jumble__hint" id="jumbleHint"></div>
        <div class="gram-jumble__word" id="jumbleWord"></div>
        <div class="gram-jumble__letters" id="jumbleLetters"></div>
        <div class="gram-jumble__fb" id="jumbleFb"></div>
        <div class="btn-row" style="margin-top:14px;">
          <button type="button" class="btn ghost" id="jumbleShuffle">🔀 Harfleri Karıştır</button>
          <button type="button" class="btn primary" id="jumbleNext">Yeni Kelime →</button>
        </div>
      </div>

      {pronounRelated && (
      <>
    <h3 style="margin-top:24px;">🧲 Zamir Eşleştirme</h3>
    <div class="gram-matchcard card">
      <p class="muted">Zamirleri karşılıklarıyla eşleştir: soldan birini seç, sağdan eşini bul.</p>
      <div class="gram-match">
        <div class="gram-match__col" id="matchL"></div>
        <div class="gram-match__col" id="matchR"></div>
      </div>
      <div class="gram-match__fb" id="matchFb"></div>
    </div>
      </>
      )}
    </section>

    <!-- ADIM 5 · Sonuç / Performans Analizi -->
    <section class="wizard-step" data-step="review">
    <button type="button" id="resultsBtn" class="btn primary" style="margin-top:30px;">📊 Sonuçlarımı Gör</button>
    <div class="gram-analysis card" id="analysis" style="display:none;">
      <h3>💪 Performans Analizi</h3>
      <p id="anaMsg" class="gram-analysis__msg"></p>
      <div class="gram-analysis__bars" id="anaBars"></div>
      <div class="gram-revlist" id="revList">
        <div class="gram-revlist__title">📚 Uygulama Listesi — gözden geçir</div>
        {pronounRelated && (
        <>
        <button type="button" class="gram-rev gram-rev--ozne" data-gotab="ozne">Özne zamirlerini gözden geçir →</button>
        <button type="button" class="gram-rev gram-rev--nesne" data-gotab="nesne">Nesne zamirlerini gözden geçir →</button>
        <button type="button" class="gram-rev gram-rev--sa" data-gotab="iyelik-sifat">İyelik sıfatlarını gözden geçir →</button>
        <button type="button" class="gram-rev gram-rev--sz" data-gotab="iyelik-zamir">İyelik zamirlerini gözden geçir →</button>
        </>
        )}
      </div>
      <button type="button" id="retryBtn" class="btn ghost">🔁 Alıştırmaları tekrar başlat</button>
    </div>
    </section>
  </main>

  <style is:global>
    /* ---- Languago grammar deep-learning module ---- */
    .wizard-nav { display: flex; flex-wrap: wrap; gap: 8px; margin: 6px 0 18px; }
    .wizard-step-btn {
      border: 1px solid var(--line); background: var(--bg); color: var(--ink-soft);
      border-radius: 999px; padding: 8px 15px; font-weight: 700; font-size: 0.85rem;
      cursor: pointer; transition: all 0.15s; font-family: inherit;
    }
    .wizard-step-btn:hover:not(:disabled) { border-color: var(--teal); color: var(--teal-dark); }
    .wizard-step-btn.on { background: var(--teal); border-color: var(--teal); color: #fff; box-shadow: 0 8px 18px -10px rgba(13,148,136,0.7); }
    .wizard-step-btn.done::after { content: ' ✓'; opacity: 0.9; }
    .wizard-step { display: none; }
    .wizard-step.is-active { display: block; animation: wizardSlide .35s ease; }
    .wizard-step:focus { outline: none; }
    @keyframes wizardSlide { from { opacity: 0; transform: translateX(14px); } to { opacity: 1; transform: none; } }
    /* Ders adımı: açıklama solda, karşılaştırma tablosu sağda (geniş ekranda) */
    .lesson-layout { display: grid; gap: 22px; }
    @media (min-width: 960px) { .lesson-layout { grid-template-columns: minmax(0,1fr) minmax(0,1fr); align-items: start; } }
    .lesson-col:last-child .gram-matrix { margin-top: 0; }
    .wizard-foot { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-top: 26px; padding-top: 16px; border-top: 1px solid var(--line); flex-wrap: wrap; }

    .gram-progress { margin: 4px 0 22px; }
    .gram-progress__head { display: flex; align-items: center; justify-content: space-between; font-size: 0.95rem; margin-bottom: 10px; }
    .gram-progress__sub { font-size: 0.82rem; color: var(--ink-soft); margin-top: 8px; }
    .gram-progress__fill { background: linear-gradient(90deg, var(--teal), var(--brand)); }

    .gram-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin: 4px 0 16px; }
    .gram-tab {
      border: 1px solid var(--line); background: var(--bg); color: var(--ink-soft);
      border-radius: 999px; padding: 8px 16px; font-weight: 700; font-size: 0.88rem;
      cursor: pointer; transition: all 0.15s; font-family: inherit;
    }
    .gram-tab:hover { border-color: var(--teal); color: var(--teal-dark); }
    .gram-tab.on { background: var(--teal); border-color: var(--teal); color: #fff; box-shadow: 0 8px 18px -10px rgba(13,148,136,0.7); }
    .gram-tab.done::after { content: '✓'; margin-left: 6px; color: inherit; opacity: 0.85; }
    .gram-empty { background: var(--teal-soft); border-radius: 10px; padding: 12px 14px; color: var(--teal-dark); font-size: 0.92rem; margin-bottom: 14px; }

    .gram-matrix { margin-top: 22px; }
    .gram-matrix__wrap { overflow-x: auto; border-radius: 12px; border: 1px solid var(--line); }
    .gram-matrix__t { width: 100%; border-collapse: collapse; min-width: 560px; text-align: center; }
    .gram-matrix__t th { padding: 12px 10px; font-size: 0.88rem; color: #fff; }
    .gram-matrix__t th small { display: block; font-weight: 500; opacity: 0.9; }
    .gram-matrix__t td { padding: 13px 10px; border-top: 1px solid var(--line); font-weight: 700; font-size: 1.05rem; }
    th.gm-sub, td.gm-sub { background: var(--teal-soft); color: var(--teal-dark); }
    th.gm-obj, td.gm-obj { background: #99f6e4; color: #0f766e; }
    th.gm-sa,  td.gm-sa  { background: #fef3c7; color: #b45309; }
    th.gm-sz,  td.gm-sz  { background: #fde68a; color: #92400e; }
    th.gm-person, td.gm-person { background: var(--bg-soft); color: var(--ink); }
    th.gm-sub { background: var(--teal); }
    th.gm-obj { background: #0d9488; }
    th.gm-sa  { background: var(--brand); }
    th.gm-sz  { background: #d97706; }
    .gram-matrix__t tbody tr { transition: transform 0.1s; }
    /* satır üzerine gelince tüm biçimler vurgulanır */
    .gram-matrix__t tbody tr:hover td { box-shadow: inset 0 0 0 2.5px var(--teal); }
    .gram-matrix__t tbody tr:hover td.gm-person { box-shadow: inset 0 0 0 2.5px var(--teal-dark); color: var(--teal-dark); }
    /* sekmeye göre ilgili sütunu vurgula */
