---
// No per-request data: served from the CDN, no function cold start in class.
export const prerender = true;
import GameLayout from '../../layouts/GameLayout.astro';
import '../../classroom/styles/kelime-sehri.css';
---
<GameLayout
  title="Kelime Şehri — Sınıf İçi İngilizce Oyunu | Languago"
  description="Monopoly tarzı sınıf oyunu: takımlar zar atar, konu sokaklarındaki yerleri soruları bilerek alır, rakibin yerinde kira sorusu cevaplar. Bütün takımlar her soruya kartla katılır. A1–B2 yetişkin ve 7–14 yaş grupları için."
>
  <div class="cr" id="kelime-sehri" data-skin="studio">
    <noscript><p style="padding:24px">Bu oyun için JavaScript gerekli.</p></noscript>
  </div>
</GameLayout>

<script>
  import { mountKelimeSehri } from '../../classroom/games/kelime-sehri/app.mjs';
  const root = document.getElementById('kelime-sehri');
  if (root) mountKelimeSehri(root, { dataBase: '/sinif-oyunlari/paket', mascot: '/logo/kommo-512.png' });
</script>
