---
// /sinif-oyunlari: the classroom games hub, on the site layout. Static,
// prerendered and served from the CDN. The games themselves keep their own
// full-screen board layout.
export const prerender = true;
import SiteLayout from '../../layouts/SiteLayout.astro';
import { GAMES, GAME_ICONS } from '../../classroom/catalog.mjs';

const live = GAMES.filter((g) => g.status === 'live');
const soon = GAMES.filter((g) => g.status !== 'live');
const facts = ['A1–B2 yetişkin', 'A1–B2 genç (7–14 yaş)', 'Üç görünüm: Oyun Parkı, Arena, Stüdyo', 'Klavye ve sunum kumandası', 'Yarım kalan oyun kaldığı yerden devam eder'];
const teams = (g: any) => (g.teams === 'tüm sınıf' ? 'tüm sınıf' : `${g.teams} takım`);
---

<SiteLayout
  canonical={`${Astro.site?.origin || 'https://www.languago.site'}/sinif-oyunlari`}
  title="Sınıf Oyunları — İngilizce Derslerinde Projektörle Oynanan Oyunlar | Languago"
  description="İngilizce öğretmenleri için projektör ve akıllı tahtada oynanan sınıf oyunları. Hazır konular veya kendi içeriğiniz; A1–B2 yetişkin ve 7–14 yaş grupları."
>
  <div class="gh">
    <header class="gh-head">
      <span class="gh-eyebrow">Öğretmenler için · ücretsiz · tarayıcıda</span>
      <h1>Sınıf Oyunları</h1>
      <p>Oyunu projektörde veya akıllı tahtada açın, sınıfı takımlara ayırın ve oynayın. Her oyun hazır bir konuyla ya da sizin yazdığınız içerikle çalışır. Öğrencilerin telefona ihtiyacı yoktur.</p>
      <ul class="gh-facts" aria-label="Özellikler">{facts.map((f) => <li>{f}</li>)}</ul>
    </header>

    <section aria-labelledby="gh-live">
      <h2 id="gh-live" class="gh-h2">Şimdi oynanabilir</h2>
      <div class="gh-grid">
        {live.map((g) => (
          <a class="gh-card gh-card--live" href={`/sinif-oyunlari/${g.slug}`}>
            <span class="gh-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={GAME_ICONS[g.icon]} /></span>
            <span class="gh-body">
              <span class="gh-name">{g.name}</span>
              <span class="gh-like">{g.like}</span>
              <span class="gh-pitch">{g.pitch}</span>
              <span class="gh-chips"><span>{g.minutes} dk</span><span>{teams(g)}</span><span>enerji: {g.energy}</span></span>
            </span>
            <span class="gh-go">Oyna <span class="arrow">→</span></span>
          </a>
        ))}
      </div>
    </section>

    {soon.length > 0 && (
      <section aria-labelledby="gh-soon">
        <h2 id="gh-soon" class="gh-h2">Yakında</h2>
        <div class="gh-grid">
          {soon.map((g) => (
            <div class="gh-card" aria-label={`${g.name}, yakında`}>
              <span class="gh-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={GAME_ICONS[g.icon]} /></span>
              <span class="gh-body">
                <span class="gh-name">{g.name}</span>
                <span class="gh-like">{g.like}</span>
                <span class="gh-pitch">{g.pitch}</span>
                <span class="gh-chips"><span>{g.minutes} dk</span><span>{teams(g)}</span><span>enerji: {g.energy}</span></span>
              </span>
              <span class="gh-soon">Yakında</span>
            </div>
          ))}
        </div>
      </section>
    )}

    <aside class="gh-note">
      <p>Oyunları derste kullandınız mı? Hangi oyunu ya da konuyu eklememizi istersiniz?</p>
      <a class="btn btn-ghost" href="/iletisim?konu=icerik">Bize yazın</a>
    </aside>
  </div>
</SiteLayout>

<style>
  .gh { width: min(var(--max), calc(100% - 32px)); margin: 0 auto; padding: clamp(32px, 6vw, 72px) 0 80px; display: grid; gap: clamp(28px, 4vw, 44px); }
  .gh-head { max-width: 720px; display: grid; gap: 12px; }
  .gh-eyebrow { font-weight: 800; font-size: 13px; letter-spacing: .08em; text-transform: uppercase; color: var(--teal-deep); }
  .gh-head h1 { font-size: clamp(34px, 5vw, 56px); letter-spacing: -.025em; line-height: 1.05; margin: 0; }
  .gh-head p { font-size: 18px; color: var(--muted); margin: 0; line-height: 1.55; }
  .gh-facts { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; margin: 6px 0 0; }
  .gh-facts li { border: 1px solid var(--line); border-radius: 99px; padding: 6px 12px; background: var(--surface); color: var(--ink); font-size: 13.5px; font-weight: 700; }
  .gh-h2 { margin: 0 0 16px; font-size: 22px; }
  .gh-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 16px; }
  .gh-card { position: relative; display: grid; grid-template-columns: auto 1fr; gap: 14px; padding: 20px; border-radius: var(--r-lg); border: 1px solid var(--line); background: var(--sunk); color: var(--ink); text-decoration: none; min-height: 160px; }
  .gh-card--live { background: var(--surface); border: 1.5px solid var(--teal); box-shadow: var(--shadow); transition: transform .15s, box-shadow .15s; }
  .gh-card--live:hover { transform: translateY(-2px); box-shadow: var(--shadow-lg); }
  .gh-card--live:focus-visible { outline: 3px solid var(--orange); outline-offset: 3px; }
  .gh-icon { width: 52px; height: 52px; border-radius: 14px; display: grid; place-items: center; background: var(--teal-soft); color: var(--teal-deep); }
  .gh-card--live .gh-icon { background: var(--teal); color: #fff; }
  .gh-icon svg { width: 28px; height: 28px; }
  .gh-body { display: grid; gap: 4px; align-content: start; padding-right: 64px; }
  .gh-name { font-weight: 800; font-size: 18px; }
  .gh-like { font-size: 13px; font-weight: 700; color: var(--orange-deep); }
  .gh-pitch { color: var(--muted); font-size: 15px; line-height: 1.5; }
  .gh-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .gh-chips span { font-size: 12px; font-weight: 700; color: var(--ink); background: var(--sunk); border: 1px solid var(--line); border-radius: 99px; padding: 3px 9px; }
  .gh-go { position: absolute; right: 18px; top: 18px; font-weight: 800; color: var(--teal-deep); }
  .gh-soon { position: absolute; right: 16px; top: 16px; font-size: 12px; font-weight: 800; color: var(--orange-deep); background: var(--orange-soft); border-radius: 99px; padding: 4px 10px; }
  .gh-note { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px; padding: 20px 24px; border-radius: var(--r-lg); background: var(--surface); border: 1px solid var(--line); }
  .gh-note p { margin: 0; color: var(--muted); }
  @media (max-width: 520px) { .gh-body { padding-right: 0; } .gh-go, .gh-soon { position: static; grid-column: 1 / -1; justify-self: start; } }
</style>
