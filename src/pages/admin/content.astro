---
// /admin/content: site settings and blog posts (admins only), on the app
// layout. Saving and deleting go through /api/admin/settings and /api/admin/posts.
import AppShell from '../../layouts/AppShell.astro';
import '../../styles/timetable.css';
import { loadAppSession } from '../../lib/app-session';
import { createSupabaseClient, pageCookieSource } from '../../lib/supabase';
import { authorizeAdmin } from '../../lib/admin';
import { shortDate } from '../../lib/teacher';

export const prerender = false;
const loaded = await loadAppSession(Astro);
if ('redirect' in loaded) return Astro.redirect(loaded.redirect.replace('next=/app', 'next=/admin/content'));
const session = loaded;
const auth = await authorizeAdmin(pageCookieSource(Astro));

type SettingRow = { key: string; value: string; updated_at: string | null };
type PostRow = { id: string; slug: string; title: string; summary: string | null; body: string | null; cover_url: string | null; published: boolean; author: string | null; created_at: string; updated_at: string | null };

let settings: SettingRow[] = [];
let posts: PostRow[] = [];
if (auth.ok) {
  try {
    const supabase = createSupabaseClient(pageCookieSource(Astro));
    if (!supabase) throw new Error('no_supabase');
    const [sRes, pRes] = await Promise.all([
      supabase.from('site_settings').select('key, value, updated_at').order('key'),
      supabase.from('blog_posts').select('id, slug, title, summary, body, cover_url, published, author, created_at, updated_at').order('created_at', { ascending: false }),
    ]);
    settings = (sRes.data ?? []) as SettingRow[];
    posts = (pRes.data ?? []) as PostRow[];
  } catch {
    // keep the empty lists; the page still renders
  }
}
---

<AppShell session={session} title="Site içeriği — Languago" current="/admin/content">
  {auth.ok ? (
    <>
      <div class="page-head"><div><h1>Site içeriği</h1><p>Site ayarları ve blog yazıları. Bu sayfa yalnızca yöneticilere açıktır.</p></div></div>

      <section class="panel" aria-labelledby="settings-heading">
        <h2 id="settings-heading">Site ayarları</h2>
        <p class="muted ac-note">Site genelinde kullanılan metin ve ayarları ekleyin, güncelleyin veya silin.</p>
        <form id="setting-form" class="form-grid" novalidate>
          <label class="fld">Anahtar (key)<input id="set-key" type="text" placeholder="örn. hero_title" maxlength="200" required /></label>
          <label class="fld">Değer (value)<input id="set-value" type="text" placeholder="Değer…" required /></label>
          <div class="ac-actions"><button class="btn btn-primary btn-sm" type="submit">Kaydet</button><span id="setting-msg" class="msg" role="status"></span></div>
        </form>
        <div id="settings-list" class="ac-list">
          {settings.length ? settings.map((s) => (
            <div class="ac-row" data-setting-key={s.key}>
              <div class="ac-body">
                <b>{s.key}</b>
                <span class="ac-val">{s.value || '—'}</span>
                <small>Son güncelleme: {shortDate(s.updated_at)}</small>
              </div>
              <div class="ac-btns">
                <button class="btn btn-ghost btn-sm" type="button" data-action="edit-setting">Düzenle</button>
                <button class="btn btn-ghost btn-sm ac-del" type="button" data-action="delete-setting">Sil</button>
              </div>
            </div>
          )) : <p class="muted ac-empty">Henüz ayar yok. İlk ayarı yukarıdaki formla ekleyin.</p>}
        </div>
      </section>

      <section class="panel" aria-labelledby="blog-heading">
        <h2 id="blog-heading">Blog yazıları</h2>
        <p class="muted ac-note">Yayındaki yazılar <a href="/blog">/blog</a> sayfasında herkese görünür; taslaklar yalnızca burada görünür.</p>
        <form id="post-form" class="ac-form" novalidate>
          <input id="post-id" type="hidden" name="id" />
          <label class="fld">Başlık<input id="post-title" type="text" maxlength="160" placeholder="Yazının başlığı…" required /></label>
          <div class="form-grid">
            <label class="fld">Adres (slug)<input id="post-slug" type="text" maxlength="200" placeholder="ornek-blog-yazisi" /><small>Boş bırakırsanız başlıktan üretilir.</small></label>
            <label class="fld">Yazar<input id="post-author" type="text" maxlength="120" placeholder="örn. Languago Ekibi" /></label>
          </div>
          <label class="fld">Özet<textarea id="post-summary" rows="2" placeholder="Arama motorlarında ve /blog listesinde görünen kısa özet…"></textarea></label>
          <label class="fld">Kapak görseli adresi (isteğe bağlı)<input id="post-cover" type="text" maxlength="500" placeholder="https://…/gorsel.png" /></label>
          <label class="fld">İçerik<textarea id="post-body" rows="10" placeholder="Yazının tam metni…"></textarea></label>
          <label class="ac-check"><input id="post-published" type="checkbox" /><span>Yayınla (herkese göster)</span></label>
          <div class="ac-actions">
            <button class="btn btn-primary btn-sm" type="submit" id="post-submit-btn">Yazıyı kaydet</button>
            <button class="btn btn-ghost btn-sm" type="button" id="post-cancel-btn" hidden>Formu temizle</button>
            <span id="post-msg" class="msg" role="status"></span>
          </div>
        </form>
        <div id="posts-list" class="ac-list">
          {posts.length ? posts.map((p) => (
            <div class="ac-row" data-post-id={p.id}>
              <div class="ac-body">
                <span class="ac-title"><b>{p.title}</b><span class={`badge ${p.published ? 'confirmed' : 'requested'}`}>{p.published ? 'Yayında' : 'Taslak'}</span></span>
                <span class="ac-val">/{p.slug}</span>
                <small>{(p.summary && `${p.summary} · `) || ''}Yazar: {p.author || '—'} · {shortDate(p.created_at)}</small>
              </div>
              <div class="ac-btns">
                {p.published && <a class="btn btn-ghost btn-sm" href={`/blog/${p.slug}`}>Görüntüle</a>}
                <button class="btn btn-ghost btn-sm" type="button" data-action="edit-post">Düzenle</button>
                <button class="btn btn-ghost btn-sm ac-del" type="button" data-action="delete-post">Sil</button>
              </div>
            </div>
          )) : <p class="muted ac-empty">Henüz blog yazısı yok. İlk yazıyı yukarıdaki formla oluşturun.</p>}
        </div>
      </section>
    </>
  ) : (
    <section class="panel ac-locked">
      <h1>Bu sayfa yalnızca yöneticilere açık</h1>
      <p class="muted">Hesabınızın bu sayfayı görme yetkisi yok.</p>
      <a class="btn btn-primary btn-sm" href="/app">Ana sayfaya dön</a>
    </section>
  )}
</AppShell>

<style>
  .ac-note { font-size: 14.5px; margin: 0; }
  .ac-form { display: grid; gap: 12px; }
  .ac-actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; align-self: end; }
  .ac-check { display: inline-flex; align-items: center; gap: 10px; font-weight: 700; cursor: pointer; }
  .ac-check input { width: 20px; height: 20px; accent-color: #14b8a6; }
  .ac-list { display: grid; gap: 10px; }
  .ac-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 16px; border-radius: 14px; border: 1px solid rgba(255, 255, 255, .08); background: rgba(0, 0, 0, .18); }
  .ac-body { display: grid; gap: 4px; min-width: 0; flex: 1 1 260px; }
  .ac-title { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .ac-val { color: var(--ink-2); overflow-wrap: anywhere; }
  .ac-body small { color: var(--muted); }
  .ac-btns { display: flex; flex-wrap: wrap; gap: 8px; }
  .ac-del:hover { color: #fca5a5; border-color: rgba(248, 113, 113, .4); }
  .ac-empty { margin: 0; }
  .ac-locked { text-align: center; justify-items: center; padding: 40px 24px; }
</style>

<script is:inline>
  (function () {
    function el(id) { return document.getElementById(id); }
    function api(path, method, body) {
      return fetch(path, { method: method, headers: { 'Content-Type': 'application/json' }, body: body ? JSON.stringify(body) : undefined }).then(function (r) { return r.json(); });
    }
    function readErr(res) {
      if (res && res.error) {
        var f = res.error.fields;
        if (f) for (var k in f) if (Object.prototype.hasOwnProperty.call(f, k) && f[k] && f[k][0]) return f[k][0];
        if (res.error.message) return res.error.message;
      }
      return 'Bir hata oluştu.';
    }
    function say(node, text, ok) { node.textContent = text; node.style.color = ok ? '#5eead4' : '#fca5a5'; }

    // ---- Settings ----
    var settingForm = el('setting-form');
    var settingMsg = el('setting-msg');
    if (settingForm && settingMsg) {
      settingForm.addEventListener('submit', function (e) {
        e.preventDefault();
        var key = el('set-key').value.trim();
        if (!key) return say(settingMsg, 'Anahtar gerekli.');
        api('/api/admin/settings', 'POST', { key: key, value: el('set-value').value }).then(function (res) {
          if (res && res.ok) { say(settingMsg, 'Ayar kaydedildi.', true); setTimeout(function () { location.reload(); }, 700); }
          else say(settingMsg, readErr(res));
        }).catch(function () { say(settingMsg, 'Bağlantı hatası.'); });
      });
      el('settings-list').addEventListener('click', function (ev) {
        var btn = ev.target.closest('[data-action]');
        if (!btn) return;
        var row = btn.closest('[data-setting-key]');
        var key = row && row.getAttribute('data-setting-key');
        if (!key) return;
        if (btn.getAttribute('data-action') === 'delete-setting') {
          if (!confirm('"' + key + '" ayarı silinecek. Emin misiniz?')) return;
          api('/api/admin/settings', 'DELETE', { key: key }).then(function (res) {
            if (res && res.ok) location.reload(); else say(settingMsg, readErr(res));
          });
        } else {
          el('set-key').value = key;
          var v = row.querySelector('.ac-val');
          el('set-value').value = v && v.textContent.trim() !== '—' ? v.textContent.trim() : '';
          settingForm.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    }

    // ---- Posts ----
    var postForm = el('post-form');
    var postMsg = el('post-msg');
    var submitBtn = el('post-submit-btn');
    var cancelBtn = el('post-cancel-btn');
    function loadPost(p) {
      el('post-id').value = p.id;
      el('post-title').value = p.title;
      el('post-slug').value = p.slug;
      el('post-summary').value = p.summary || '';
      el('post-author').value = p.author || '';
      el('post-cover').value = p.cover_url || '';
      el('post-body').value = p.body || '';
      el('post-published').checked = !!p.published;
      submitBtn.textContent = 'Değişiklikleri kaydet';
      cancelBtn.hidden = false;
      postForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    if (postForm && postMsg) {
      postForm.addEventListener('submit', function (e) {
        e.preventDefault();
        var title = el('post-title').value.trim();
        if (!title) return say(postMsg, 'Başlık gerekli.');
        var label = submitBtn.textContent;
        submitBtn.disabled = true; submitBtn.textContent = 'Kaydediliyor…'; postMsg.textContent = '';
        api('/api/admin/posts', 'POST', {
          id: el('post-id').value || undefined, title: title, slug: el('post-slug').value.trim(),
          summary: el('post-summary').value.trim(), body: el('post-body').value, cover_url: el('post-cover').value.trim(),
          published: el('post-published').checked, author: el('post-author').value.trim(),
        }).then(function (res) {
          if (res && res.ok) { say(postMsg, 'Yazı kaydedildi.', true); setTimeout(function () { location.reload(); }, 700); }
          else say(postMsg, readErr(res));
        }).catch(function () { say(postMsg, 'Bağlantı hatası.'); })
          .finally(function () { submitBtn.disabled = false; submitBtn.textContent = label; });
      });
      cancelBtn.addEventListener('click', function () {
        postForm.reset(); el('post-id').value = '';
        submitBtn.textContent = 'Yazıyı kaydet'; cancelBtn.hidden = true;
      });
      el('posts-list').addEventListener('click', function (ev) {
        var btn = ev.target.closest('[data-action]');
        if (!btn) return;
        var row = btn.closest('[data-post-id]');
        var id = row && row.getAttribute('data-post-id');
        if (!id) return;
        if (btn.getAttribute('data-action') === 'delete-post') {
          if (!confirm('Bu blog yazısı silinecek. Emin misiniz?')) return;
          api('/api/admin/posts', 'DELETE', { id: id }).then(function (res) {
            if (res && res.ok) location.reload(); else say(postMsg, readErr(res));
          });
        } else {
          api('/api/admin/posts', 'GET').then(function (res) {
            var list = res && res.ok && res.posts ? res.posts : [];
            var p = list.filter(function (x) { return x.id === id; })[0];
            if (p) loadPost(p); else say(postMsg, 'Yazı bulunamadı.');
          });
        }
      });
    }
  })();
</script>
