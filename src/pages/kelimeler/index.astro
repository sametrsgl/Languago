---
// /kelimeler: the public word lists, one per CEFR level.
import SiteLayout from '../../layouts/SiteLayout.astro';
import { WORD_LEVELS } from '../../lib/word-pages';
export const prerender = true;
const total = WORD_LEVELS.reduce((t, l) => t + l.cards.length, 0);
---

<SiteLayout
  title="İngilizce Kelime Listeleri: A1, A2, B1 (Türkçe Anlamlı, Örnek Cümleli) | Languago"
  description={`Seviyenize göre ${total.toLocaleString('tr-TR')} İngilizce kelime: Türkçe anlamları, basit İngilizce açıklamaları ve örnek cümleleriyle A1, A2 ve B1 kelime listeleri.`}
>
  <div class="wl">
    <header class="wl-head">
      <span class="wl-eyebrow">Ücretsiz · seviyeye göre</span>
      <h1>İngilizce kelime listeleri</h1>
      <p>Her seviyede bilmeniz gereken kelimeler; Türkçe anlamı, basit bir İngilizce açıklaması ve gerçek hayattan bir örnek cümleyle. Hangi seviyeden başlayacağınızı bilmiyorsanız önce ücretsiz seviye testini çözün.</p>
      <div class="wl-cta"><a class="btn btn-accent" href="/seviye-testi">Seviyemi öğren <span class="arrow">→</span></a></div>
    </header>
    <div class="wl-levels">
      {WORD_LEVELS.map((l) => (
        <a class="wl-card" href={`/kelimeler/${l.slug}`}>
          <span class="wl-level">{l.level}</span>
          <span class="wl-name">{l.name} seviye</span>
          <span class="wl-count">{l.cards.length} kelime</span>
          <span class="wl-intro">{l.intro}</span>
          <span class="wl-go">Listeyi aç <span class="arrow">→</span></span>
        </a>
      ))}
    </div>
  </div>
</SiteLayout>

<style>
  .wl { width: min(var(--max), calc(100% - 32px)); margin: 0 auto; padding: clamp(32px, 6vw, 72px) 0 80px; display: grid; gap: clamp(28px, 4vw, 44px); }
  .wl-head { max-width: 720px; display: grid; gap: 12px; }
  .wl-eyebrow { font-weight: 800; font-size: 13px; letter-spacing: .08em; text-transform: uppercase; color: var(--teal-deep); }
  .wl-head h1 { font-size: clamp(34px, 5vw, 56px); letter-spacing: -.025em; line-height: 1.05; margin: 0; }
  .wl-head p { font-size: 18px; color: var(--muted); margin: 0; line-height: 1.55; }
  .wl-cta { margin-top: 6px; }
  .wl-levels { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 16px; }
  .wl-card { display: grid; gap: 6px; align-content: start; padding: 24px; border-radius: var(--r-lg); background: var(--surface); border: 1px solid var(--line); color: var(--ink); text-decoration: none; transition: transform .15s, border-color .15s; }
  .wl-card:hover { transform: translateY(-2px); border-color: var(--teal); }
  .wl-card:focus-visible { outline: 3px solid var(--orange); outline-offset: 3px; }
  .wl-level { font-size: 40px; font-weight: 800; letter-spacing: -.03em; color: var(--teal-deep); line-height: 1; }
  .wl-name { font-weight: 800; font-size: 18px; }
  .wl-count { font-size: 14px; font-weight: 700; color: var(--orange-deep); }
  .wl-intro { color: var(--muted); line-height: 1.55; font-size: 15px; }
  .wl-go { margin-top: 6px; font-weight: 800; color: var(--teal-deep); }
</style>
