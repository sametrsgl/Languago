---
// /kelimeler/a1, /a2, /b1: one level's words, A–Z, with the Turkish meaning,
// a simple English explanation and an example sentence. Static pages.
import SiteLayout from '../../layouts/SiteLayout.astro';
import { WORD_LEVELS, byLetter, posTr } from '../../lib/word-pages';
export const prerender = true;

export function getStaticPaths() {
  return WORD_LEVELS.map((l) => ({ params: { seviye: l.slug } }));
}
const lv = WORD_LEVELS.find((l) => l.slug === Astro.params.seviye)!;
const groups = byLetter(lv.cards);
const others = WORD_LEVELS.filter((l) => l.slug !== lv.slug);
const sample = lv.cards.slice(0, 6).map((c) => c.word).join(', ');
---

<SiteLayout
  title={`${lv.level} İngilizce Kelime Listesi: ${lv.cards.length} Kelime, Türkçe Anlamları ve Örnek Cümleler | Languago`}
  description={`${lv.level} (${lv.name.toLocaleLowerCase('tr-TR')}) seviye ${lv.cards.length} İngilizce kelime: Türkçe anlamı, basit İngilizce açıklaması ve örnek cümlesiyle. ${sample}…`}
>
  <div class="wl">
    <nav class="wl-crumbs" aria-label="Sayfa yolu"><a href="/kelimeler">Kelime listeleri</a> <span aria-hidden="true">›</span> {lv.level}</nav>
    <header class="wl-head">
      <span class="wl-eyebrow">{lv.level} · {lv.name} seviye · {lv.cards.length} kelime</span>
      <h1>{lv.level} İngilizce kelime listesi</h1>
      <p>{lv.intro} Her kelimenin yanında Türkçe anlamı, basit bir İngilizce açıklaması ve örnek bir cümle var.</p>
    </header>

    <div class="wl-tools">
      <label class="wl-search"><span class="sr">Kelime ara</span><input type="search" placeholder="Kelime ya da Türkçe anlam arayın…" data-search autocomplete="off" /></label>
      <nav class="wl-letters" aria-label="Harfe git">{groups.map((g) => <a href={`#harf-${g.letter}`}>{g.letter}</a>)}</nav>
    </div>
    <p class="wl-none" data-none hidden>Bu listede eşleşen kelime yok.</p>

    <div class="wl-list">
      {groups.map((g) => (
        <section class="wl-group" id={`harf-${g.letter}`} data-group>
          <h2>{g.letter}</h2>
          <ul>{g.cards.map((c) => (
            <li class="wl-item" data-text={`${c.word} ${c.tr}`.toLocaleLowerCase('tr-TR')}>
              <div class="wl-top">
                <b class="wl-word" lang="en">{c.word}</b>
                <span class="wl-pos">{posTr(c.pos)}</span>
                <button class="wl-say" type="button" data-say={c.word} aria-label={`${c.word} kelimesini dinle`} hidden>▶</button>
                <span class="wl-tr">{c.tr}</span>
              </div>
              <p class="wl-en" lang="en">{c.en}</p>
              <p class="wl-ex" lang="en">“{c.ex}”</p>
            </li>
          ))}</ul>
        </section>
      ))}
    </div>

    <aside class="wl-next">
      <div>
        <h2>Bu kelimelerin kaçını biliyorsunuz?</h2>
        <p>Ücretsiz hesap açın; kelime analizi bildiklerinizi ayırır, öğrenme yolunuz her gün 13 yeni kelimeyi kartlar ve tekrarla öğretir.</p>
      </div>
      <div class="wl-next-cta">
        <a class="btn btn-accent" href="/signup">Ücretsiz başla <span class="arrow">→</span></a>
        <a class="btn btn-ghost" href="/seviye-testi">Önce seviye testi</a>
      </div>
    </aside>

    <nav class="wl-other" aria-label="Diğer seviyeler">
      {others.map((o) => <a href={`/kelimeler/${o.slug}`}><b>{o.level}</b> {o.name} seviye · {o.cards.length} kelime →</a>)}
    </nav>
  </div>
</SiteLayout>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-search]');
  const none = document.querySelector<HTMLElement>('[data-none]');
  const items = [...document.querySelectorAll<HTMLElement>('.wl-item')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')];
  input?.addEventListener('input', () => {
    const q = input.value.trim().toLocaleLowerCase('tr-TR');
    let shown = 0;
    for (const it of items) { const hit = !q || (it.dataset.text || '').includes(q); it.hidden = !hit; if (hit) shown++; }
    for (const g of groups) g.hidden = !g.querySelector('.wl-item:not([hidden])');
    if (none) none.hidden = shown > 0;
  });
  // Listen buttons appear only when the device has an English voice (never read English with a Turkish voice).
  const synth = window.speechSynthesis;
  const pickVoice = () => synth?.getVoices().find((v) => /^en[-_](GB|US)/i.test(v.lang)) || synth?.getVoices().find((v) => /^en\b/i.test(v.lang));
  const arm = () => {
    const voice = pickVoice();
    if (!voice) return;
    document.querySelectorAll<HTMLButtonElement>('[data-say]').forEach((b) => {
      b.hidden = false;
      b.onclick = () => { synth.cancel(); const u = new SpeechSynthesisUtterance(b.dataset.say || ''); u.voice = voice; u.lang = voice.lang; u.rate = 0.9; synth.speak(u); };
    });
  };
  if (synth) { arm(); synth.addEventListener?.('voiceschanged', arm); }
</script>

<style>
  .wl { width: min(var(--max), calc(100% - 32px)); margin: 0 auto; padding: clamp(28px, 5vw, 56px) 0 80px; display: grid; gap: 26px; }
  .wl-crumbs { font-size: 14px; color: var(--muted); }
  .wl-crumbs a { color: var(--teal-deep); }
  .wl-head { max-width: 760px; display: grid; gap: 12px; }
  .wl-eyebrow { font-weight: 800; font-size: 13px; letter-spacing: .08em; text-transform: uppercase; color: var(--teal-deep); }
  .wl-head h1 { font-size: clamp(32px, 5vw, 52px); letter-spacing: -.025em; line-height: 1.05; margin: 0; }
  .wl-head p { font-size: 17.5px; color: var(--muted); margin: 0; line-height: 1.6; }
  .wl-tools { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 5; display: grid; gap: 10px; padding: 12px 0; background: var(--paper); }
  .wl-search input { width: 100%; min-height: 48px; padding: 10px 16px; border-radius: 14px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); font: inherit; font-size: 16px; }
  .wl-search input:focus { outline: 2px solid var(--teal); outline-offset: 1px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .wl-letters { display: flex; flex-wrap: wrap; gap: 4px; }
  .wl-letters a { min-width: 32px; padding: 4px 6px; text-align: center; border-radius: 8px; font-weight: 800; font-size: 14px; color: var(--teal-deep); text-decoration: none; background: var(--surface); border: 1px solid var(--line); }
  .wl-none { margin: 0; color: var(--muted); }
  @media (max-width: 700px) { .wl-tools { position: static; } .wl-group { scroll-margin-top: 20px; } }
  .wl-list { display: grid; gap: 28px; }
  .wl-group { scroll-margin-top: 150px; display: grid; gap: 10px; }
  .wl-group h2 { margin: 0; font-size: 26px; color: var(--teal-deep); }
  .wl-group ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 10px; }
  .wl-item { display: grid; gap: 4px; padding: 14px 16px; border-radius: var(--r); background: var(--surface); border: 1px solid var(--line); min-width: 0; }
  .wl-top { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; }
  .wl-word { font-size: 18px; }
  .wl-pos { font-size: 12px; font-weight: 700; color: var(--muted); }
  .wl-tr { flex-basis: 100%; font-weight: 700; color: var(--orange-deep); }
  .wl-say { width: 26px; height: 26px; border-radius: 50%; border: 1px solid var(--line); background: var(--sunk); color: var(--teal-deep); font-size: 11px; cursor: pointer; align-self: center; }
  .wl-en, .wl-ex { margin: 0; font-size: 14.5px; line-height: 1.5; }
  .wl-en { color: var(--muted); }
  .wl-ex { font-style: italic; }
  .wl-next { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px; padding: 24px; border-radius: var(--r-lg); background: var(--surface); border: 1.5px solid var(--teal); }
  .wl-next h2 { margin: 0 0 6px; font-size: 22px; }
  .wl-next p { margin: 0; color: var(--muted); max-width: 60ch; }
  .wl-next-cta { display: flex; flex-wrap: wrap; gap: 10px; }
  .wl-other { display: flex; flex-wrap: wrap; gap: 10px 22px; }
  .wl-other a { color: var(--teal-deep); font-weight: 700; text-decoration: none; }
</style>
