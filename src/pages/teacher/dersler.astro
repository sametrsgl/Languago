---
import Layout from '../../layouts/Layout.astro';
import TeacherNav from '../../components/TeacherNav.astro';
import { createSupabaseClient, pageCookieSource } from '../../lib/supabase';
import { authorizeTeacher, shortDate } from '../../lib/teacher';

const auth = await authorizeTeacher(pageCookieSource(Astro));
if (!auth.ok && auth.reason !== 'forbidden') {
  return Astro.redirect('/signin');
}

type LessonRow = {
  id: string;
  title: string;
  starts_at: string;
  room_token: string;
  class_id: string | null;
  created_at: string;
};
type ClassRow = { id: string; class_name: string };

let lessons: LessonRow[] = [];
let classes: ClassRow[] = [];
let classNameById = new Map<string, string>();

if (auth.ok) {
  try {
    const supabase = createSupabaseClient(pageCookieSource(Astro));
    if (!supabase) throw new Error('no_supabase');

    const [lessonRes, classRes] = await Promise.all([
      supabase
        .from('lessons')
        .select('id, title, starts_at, room_token, class_id, created_at')
        .order('starts_at', { ascending: false }),
      supabase.from('class_roster').select('id, class_name').order('class_name'),
    ]);

    lessons = (lessonRes.data ?? []) as LessonRow[];
    classes = (classRes.data ?? []) as ClassRow[];
    for (const c of classes) classNameById.set(c.id, c.class_name);
  } catch {
    // Keep empty defaults; the page still renders a friendly state.
  }
}
---

<Layout
  title="Canlı Dersler — Öğretmen Paneli · Languago"
  description="Languago canlı video derslerini oluştur ve yönet; öğrencilerinle birebir görüşme odasına bağlan."
>
  {
    auth.ok ? (
      <main class="study teacher">
        <TeacherNav path={Astro.url.pathname} />

        <h1>Canlı Dersler 🎥</h1>
        <p class="muted">
          Kendi Languago video odanda (Jitsi) çevrimiçi ders yap. Oluşturduğun her ders için
          güvenli, tahmin edilemez bir oda anahtarı üretilir. Dersi başlat ve öğrencilerinle
          ekran paylaşımlı canlı görüşmeye geç.
        </p>
        <div class="barline"></div>

        <div class="panel" style="background:var(--bg-soft);">
          <h2 style="font-size:1.15rem;">Yeni Canlı Ders Oluştur</h2>
          <form id="lesson-form" class="class-form">
            <input
              id="lesson-title"
              type="text"
              name="title"
              placeholder="Örn. 8. Sınıf — Kelime Tekrarı"
              maxlength="120"
              required
            />
            <label class="field-label" for="lesson-time">Ders zamanı</label>
            <input id="lesson-time" name="starts_at" type="datetime-local" required />
            <label class="field-label" for="lesson-class">Sınıf (isteğe bağlı)</label>
            <select id="lesson-class" name="class_id">
              <option value="">— Sınıf seçilmedi —</option>
              {classes.map((c) => (
                <option value={c.id}>{c.class_name}</option>
              ))}
            </select>
            <button class="btn primary" type="submit">Dersi Oluştur</button>
          </form>
          <p id="lesson-msg" class="class-msg" role="status"></p>
        </div>

        <h2 style="margin-top:32px;">Derslerin</h2>
        {
          lessons.length ? (
            <div class="wrap-table">
              <table class="tbl">
                <thead>
                  <tr>
                    <th>Ders</th>
                    <th>Zaman</th>
                    <th>Sınıf</th>
                    <th>Oda</th>
                  </tr>
                </thead>
                <tbody>
                  {lessons.map((l) => (
                    <tr>
                      <td>
                        <strong>{l.title}</strong>
                        <div class="muted small">Oluşturulma: {shortDate(l.created_at)}</div>
                      </td>
                      <td>{shortDate(l.starts_at)}</td>
                      <td>
                        {l.class_id ? classNameById.get(l.class_id) ?? '—' : <span class="muted">Genel</span>}
                      </td>
                      <td>
                        <a class="btn primary sm" href={`/ders/${l.room_token}`}>
                          Derse Başla →
                        </a>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <div class="panel" style="background:var(--bg-soft);">
              <p class="empty" style="margin:0;">
                Henüz oluşturulmuş bir canlı ders yok. Yukarıdaki formla ilk dersini planla.
              </p>
            </div>
          )
        }
      </main>
    ) : (
      <main class="study">
        <div class="panel" style="text-align:center;padding:40px 24px;">
          <div style="font-size:2.4rem;">🔒</div>
          <h1>Yetkisiz Erişim</h1>
          <p class="muted">
            Bu sayfa yalnızca öğretmen hesaplarına açıktır.
          </p>
          <div class="btn-row" style="justify-content:center;">
            <a class="btn" href="/dashboard">Öğrenci Paneline Dön</a>
          </div>
        </div>
      </main>
    )
  }
</Layout>

<style>
  .field-label {
    display: block;
    margin: 12px 0 4px;
    font-size: 0.9rem;
    color: #60676d;
  }
  .class-form input,
  .class-form select {
    width: 100%;
    max-width: 420px;
    margin-top: 8px;
  }
  .class-form select {
    display: block;
  }
  .btn.sm {
    padding: 8px 16px;
    font-size: 0.9rem;
  }
</style>

<script is:inline>
  (function () {
    var form = document.getElementById('lesson-form');
    var msg = document.getElementById('lesson-msg');
    var titleInput = document.getElementById('lesson-title');
    var timeInput = document.getElementById('lesson-time');
    var classSelect = document.getElementById('lesson-class');
    if (!form || !msg || !titleInput || !timeInput || !classSelect) return;

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var title = titleInput.value.trim();
      var starts_at = timeInput.value;
      var class_id = classSelect.value || null;
      if (!title) {
        msg.textContent = 'Lütfen bir ders başlığı yaz.';
        msg.className = 'class-msg err';
        return;
      }
      if (!starts_at) {
        msg.textContent = 'Lütfen bir ders zamanı seç.';
        msg.className = 'class-msg err';
        return;
      }
      var btn = form.querySelector('button');
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Oluşturuluyor…';
      }
      msg.textContent = '';
      msg.className = 'class-msg';

      fetch('/api/teacher/lessons', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title: title, starts_at: starts_at, class_id: class_id }),
      })
        .then(function (r) { return r.json(); })
        .then(function (res) {
          if (res && res.ok && res.lesson) {
            msg.textContent = 'Ders oluşturuldu. Odaya bağlanılıyor…';
            msg.className = 'class-msg ok';
            window.location.href = '/ders/' + res.lesson.room_token;
          } else {
            var m = (res && res.error && (res.error.message || (res.error.fields && res.error.fields.title && res.error.fields.title[0]))) || 'Bir hata oluştu.';
            msg.textContent = m;
            msg.className = 'class-msg err';
          }
        })
        .catch(function () {
          msg.textContent = 'Bağlantı hatası. Tekrar dene.';
          msg.className = 'class-msg err';
        })
        .finally(function () {
          if (btn) {
            btn.disabled = false;
            btn.textContent = 'Dersi Oluştur';
          }
        });
    });
  })();
</script>