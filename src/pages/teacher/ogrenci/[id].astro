---
import AppLayout from '../../../layouts/AppLayout.astro';
import TeacherNav from '../../../components/TeacherNav.astro';
import { createSupabaseClient, pageCookieSource } from '../../../lib/supabase';
import {
  authorizeTeacher,
  MODULES,
  moduleSummary,
  shortDate,
  levelLabel,
} from '../../../lib/teacher';

const auth = await authorizeTeacher(pageCookieSource(Astro));
if (!auth.ok && auth.reason !== 'forbidden') {
  return Astro.redirect('/signin');
}

const id = Astro.params.id ?? '';

type Entry = { payload?: Record<string, unknown>; updated_at?: string };
type Student = {
  student_id: string;
  full_name: string | null;
  email: string;
  level: string | null;
  created_at: string;
  progress: Record<string, Entry>;
};

let student: Student | null = null;

if (auth.ok && id) {
  try {
    const supabase = createSupabaseClient(pageCookieSource(Astro));
    if (supabase) {
      const { data } = await supabase.rpc('get_teacher_students', {
        p_teacher: auth.userId,
      });
      const rows = (data ?? []) as Student[];
      student = rows.find((r) => r.student_id === id) ?? null;
    }
  } catch {
    student = null;
  }
}
---

<AppLayout
  title={
    student
      ? `${student.full_name || student.email} — Öğrenci Profili · Languago`
      : 'Öğrenci — Öğretmen Paneli · Languago'
  }
  description="Languago öğrenci profil sayfası."
>
  {
    auth.ok ? (
      <main class="study teacher">
        <TeacherNav path={Astro.url.pathname} />
        <a class="back" href="/teacher/ogrenciler">← Öğrenciler</a>
        <div class="page-head">
          <span class="page-eyebrow">Öğretmen Paneli</span>
          <h1>Öğrenci Profili 🧑‍🎓</h1>
          <p class="page-sub">
            Bu öğrencinin genel bilgileri ve modül bazında çalışma ilerlemesi tek sayfada.
          </p>
          <div class="barline"></div>
        </div>

        <section class="dash-section" aria-labelledby="ogrenci-bilgi-heading">
          <header class="section-head">
            <h2 id="ogrenci-bilgi-heading">
              Öğrenci Bilgileri <span class="section-head__icon">🧑‍🎓</span>
            </h2>
            <p class="muted">Genel bilgiler, seviye ve kayıt tarihi.</p>
          </header>
          {
            student ? (
              <div class="panel" style="background:var(--bg-soft);">
                <h2 style="font-size:1.4rem;">{student.full_name || '—'}</h2>
                <p class="muted">
                  <strong>{student.email}</strong> · Seviye{' '}
                  <span class="badge" style="background:var(--teal-dark);">
                    {levelLabel(student.level)}
                  </span>
                  {' '}· Kayıt: {shortDate(student.created_at)}
                </p>
              </div>
            ) : (
              <div class="empty-state">
                <div class="es-ico">🤷</div>
                <h3>Öğrenci Bulunamadı</h3>
                <p>Bu öğrencinin kaydı bulunamadı ya da erişim yetkin yok.</p>
                <div class="btn-row">
                  <a class="btn" href="/teacher/ogrenciler">Öğrencilere Dön</a>
                </div>
              </div>
            )
          }
        </section>

        {
          student && (
            <section class="dash-section" aria-labelledby="modul-ilerleme-heading">
              <header class="section-head">
                <h2 id="modul-ilerleme-heading">
                  Modül İlerlemeleri <span class="section-head__icon">📈</span>
                </h2>
                <p class="muted">
                  Bu öğrencinin her modüldeki durumu ve son çalışma tarihi.
                </p>
              </header>
              <div class="wrap-table">
                <table class="tbl">
                  <thead>
                    <tr>
                      <th>Modül</th>
                      <th>Durum</th>
                      <th>Son Çalışma</th>
                    </tr>
                  </thead>
                  <tbody>
                    {
                      MODULES.map((m) => {
                        const entry = student!.progress?.[m.key] as
                          | Entry
                          | undefined;
                        const sum = moduleSummary(entry);
                        return (
                          <tr>
                            <td>
                              {m.emoji} {m.label}
                            </td>
                            <td>
                              {sum ? (
                                <span class="badge" style="background:var(--success);">
                                  {sum}
                                </span>
                              ) : (
                                <span class="muted">Başlanmadı</span>
                              )}
                            </td>
                            <td class="muted">
                              {entry?.updated_at
                                ? shortDate(entry.updated_at)
                                : '—'}
                            </td>
                          </tr>
                        );
                      })
                    }
                  </tbody>
                </table>
              </div>
            </section>
          )
        }
      </main>
    ) : (
      <main class="study">
        <div class="panel" style="text-align:center;padding:40px 24px;">
          <div style="font-size:2.4rem;">🔒</div>
          <h1>Yetkisiz Erişim</h1>
          <p class="muted">Bu sayfa yalnızca öğretmen hesaplarına açıktır.</p>
          <div class="btn-row" style="justify-content:center;">
            <a class="btn" href="/dashboard">Öğrenci Paneline Dön</a>
          </div>
        </div>
      </main>
    )
  }
</AppLayout>