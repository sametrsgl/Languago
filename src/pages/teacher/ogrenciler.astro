---
import AppLayout from '../../layouts/AppLayout.astro';
import TeacherNav from '../../components/TeacherNav.astro';
import { createSupabaseClient, pageCookieSource } from '../../lib/supabase';
import {
  authorizeTeacher,
  MODULES,
  moduleSummary,
  shortDate,
  levelLabel,
} from '../../lib/teacher';

const auth = await authorizeTeacher(pageCookieSource(Astro));
if (!auth.ok && auth.reason !== 'forbidden') {
  return Astro.redirect('/signin');
}

type Entry = { payload?: Record<string, unknown>; updated_at?: string };
type Student = {
  student_id: string;
  full_name: string | null;
  email: string;
  level: string | null;
  created_at: string;
  progress: Record<string, Entry>;
};

let students: Student[] = [];

if (auth.ok) {
  try {
    const supabase = createSupabaseClient(pageCookieSource(Astro));
    if (supabase) {
      const { data } = await supabase.rpc('get_teacher_students', {
        p_teacher: auth.userId,
      });
      students = ((data ?? []) as Student[]).sort((a, b) =>
        (a.full_name || a.email).localeCompare(b.full_name || b.email, 'tr')
      );
    }
  } catch {
    students = [];
  }
}
---

<AppLayout
  title="Öğrenciler + İlerleme — Öğretmen Paneli · Languago"
  description="Languago öğrenci listesi ve modül bazında çalışma ilerlemeleri."
>
  {
    auth.ok ? (
      <main class="study teacher">
        <TeacherNav path={Astro.url.pathname} />

        <h1>Öğrenciler 🧑‍🎓</h1>
        <p class="muted">
          Rolü öğrenci olan tüm hesaplar ve her modüldeki son çalışma durumları burada listelenir.
        </p>
        <div class="barline"></div>

        {
          students.length ? (
            <div class="wrap-table">
              <table class="tbl">
                <thead>
                  <tr>
                    <th>Öğrenci</th>
                    <th>Seviye</th>
                    <th>İlerleme</th>
                    <th>Kayıt</th>
                  </tr>
                </thead>
                <tbody>
                  {
                    students.map((s) => (
                      <tr>
                        <td>
                          <a
                            class="btn-link"
                            href={`/teacher/ogrenci/${s.student_id}`}
                          >
                            {s.full_name || '—'}
                          </a>
                          <div class="muted small">{s.email}</div>
                        </td>
                        <td>
                          <span class="badge" style="background:var(--teal-dark);">
                            {levelLabel(s.level)}
                          </span>
                        </td>
                        <td>
                          <div class="mods">
                            {
                              MODULES.map((m) => {
                                const entry = s.progress?.[m.key] as
                                  | Entry
                                  | undefined;
                                const sum = moduleSummary(entry);
                                return (
                                  <span
                                    class:list={[
                                      'mod',
                                      { on: Boolean(sum) },
                                    ]}
                                    title={`${m.label}${sum ? ' · ' + sum : ''}${
                                      entry?.updated_at
                                        ? ' · ' + shortDate(entry.updated_at)
                                        : ''
                                    }`}
                                  >
                                    {m.emoji}
                                    <small>{sum ?? '—'}</small>
                                  </span>
                                );
                              })
                            }
                          </div>
                        </td>
                        <td class="muted">{shortDate(s.created_at)}</td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
          ) : (
            <div class="panel" style="background:var(--bg-soft);">
              <p class="empty" style="margin:0;">
                Henüz rolü öğrenci olan bir hesap bulunmuyor. Öğrenciler{' '}
                <a href="/signup">kayıt formu</a> ile geldikçe burada görünmeye başlar.
              </p>
            </div>
          )
        }
      </main>
    ) : (
      <main class="study">
        <div class="panel" style="text-align:center;padding:40px 24px;">
          <div style="font-size:2.4rem;">🔒</div>
          <h1>Yetkisiz Erişim</h1>
          <p class="muted">
            Bu sayfa yalnızca öğretmen hesaplarına açıktır.
          </p>
          <div class="btn-row" style="justify-content:center;">
            <a class="btn" href="/dashboard">Öğrenci Paneline Dön</a>
          </div>
        </div>
      </main>
    )
  }
</AppLayout>