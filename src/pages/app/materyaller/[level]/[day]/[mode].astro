---
// One path day as slides (sunum) for screen sharing or as a printable
// worksheet with an answer key (yazdir). Teachers only.
import { loadAppSession } from '../../../../../lib/app-session';
import { getDay, getSyllabus } from '../../../../../lib/path-content';
import MaterialView from '../../../../../components/MaterialView.astro';

export const prerender = false;
const loaded = await loadAppSession(Astro);
if ('redirect' in loaded) return Astro.redirect(loaded.redirect);
const session = loaded;
if (session.role !== 'teacher' && session.role !== 'admin') return Astro.redirect('/app');
const level = String(Astro.params.level || '').toUpperCase();
const dayNo = Number(Astro.params.day);
const mode = Astro.params.mode === 'yazdir' ? 'print' : 'slides';
const d = await getDay(level, dayNo);
if (!d) return Astro.redirect('/app/materyaller');
const topic = (await getSyllabus(level)).find((t) => t.id === d.topic) || null;
---
<MaterialView d={d} topic={topic} level={level} seed={dayNo} label={`Gün ${dayNo}`} mode={mode} back="/app/materyaller" />
