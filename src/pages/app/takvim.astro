---
// /app/takvim: the teacher's week, requests to answer, weekly hours, closed
// days, Google Calendar (automatic Meet links), "add a lesson" and "start now".
import AppShell from '../../layouts/AppShell.astro';
import '../../styles/timetable.css';
import { loadAppSession } from '../../lib/app-session';
import { createSupabaseClient, pageCookieSource } from '../../lib/supabase';
import { loadTeacher, demoTeacher, whoOf, type TeacherData } from '../../lib/timetable-data';
import { googleReady } from '../../lib/google';
import { lessonTitle } from '../../lib/lessons-server';
import { WEEKDAYS, WEEKDAYS_SHORT, LESSON_LENGTHS, hm, localParts, fromLocal, shortDay, timeOf, whenLabel, joinUrl, googleCalendarLink } from '../../lib/timetable';

export const prerender = false;
const loaded = await loadAppSession(Astro);
if ('redirect' in loaded) return Astro.redirect(loaded.redirect.replace('next=/app', 'next=/app/takvim'));
const session = loaded;
if (session.role !== 'teacher' && session.role !== 'admin') return Astro.redirect('/app/derslerim');

const weekOffset = Math.max(-8, Math.min(12, Number(Astro.url.searchParams.get('hafta')) || 0));
let d: TeacherData;
if (session.demo) d = demoTeacher(weekOffset);
else {
  const sb = createSupabaseClient(pageCookieSource(Astro));
  d = await loadTeacher(sb, session.userId, weekOffset);
}
const gReady = session.demo || googleReady();
const flash = ({
  bagli: ['Google Takvim bağlandı. Onayladığınız derslere Meet bağlantısı otomatik eklenecek.', ''],
  iptal: ['Google bağlantısı yapılmadı.', 'warn'],
  izin: ['Takvim izni verilmedi. Bağlarken “Google Takvim etkinlikleri” kutusunu işaretleyin.', 'warn'],
  hata: ['Google bağlantısı kurulamadı. Lütfen tekrar deneyin.', 'warn'],
  kurulmadi: ['Otomatik Meet bağlantısı henüz açılmadı. Bu arada kendi Meet bağlantınızı ekleyebilirsiniz.', 'warn'],
} as Record<string, [string, string]>)[Astro.url.searchParams.get('google') || ''];

// week grid geometry
const now = Date.now();
const today = localParts(now).day;
const days = Array.from({ length: 7 }, (_, i) => d.weekStartDay + i);
const mins: number[] = [];
for (const h of d.hours) mins.push(h.startMin, h.endMin);
for (const a of d.week) { const s = localParts(Date.parse(a.starts_at)).minute; mins.push(s, s + (Date.parse(a.ends_at) - Date.parse(a.starts_at)) / 60_000); }
let startH = mins.length ? Math.floor(Math.min(...mins) / 60) : 9;
let endH = mins.length ? Math.ceil(Math.max(...mins) / 60) : 21;
startH = Math.max(0, Math.min(startH - 1, 9)); endH = Math.min(24, Math.max(endH + 1, startH + 10));
const H = 56;
const y = (minute: number) => ((minute - startH * 60) / 60) * H;
const hoursList = Array.from({ length: endH - startH }, (_, i) => startH + i);
const dayStartMs = (day: number) => fromLocal(day, 0);
const clip = (day: number, s: number, e: number) => {
  const a = Math.max(s, dayStartMs(day) + startH * 3_600_000), b = Math.min(e, dayStartMs(day) + endH * 3_600_000);
  return b > a ? { top: y((a - dayStartMs(day)) / 60_000), h: ((b - a) / 3_600_000) * H } : null;
};
const weekLabel = `${shortDay(days[0])} – ${shortDay(days[6])}`;
const q = (o: number) => `?hafta=${o}${session.demo ? '&demo=ogretmen' : ''}`;
const who = (a: any) => whoOf(a, d.students, d.classes);
const evData = (a: any) => JSON.stringify({
  id: a.id, who: who(a), title: lessonTitle(a), when: whenLabel(a.starts_at), status: a.status, note: a.note || '',
  join: joinUrl(a), cal: googleCalendarLink(`${lessonTitle(a)} · Languago`, a.starts_at, a.ends_at, joinUrl(a)),
  past: Date.parse(a.starts_at) <= now,
});
const hoursByDay = WEEKDAYS.map((_, wd) => d.hours.filter((h) => h.weekday === wd));
const minutesOf = (a: any) => Math.round((Date.parse(a.ends_at) - Date.parse(a.starts_at)) / 60_000);
const todayIso = new Date(fromLocal(today, 12 * 60)).toISOString().slice(0, 10);
---

<AppShell session={session} title="Takvim — Languago" current="/app/takvim">
  <div class="page-head">
    <div><h1>Takvim</h1><p>Haftalık saatlerinizi belirleyin; öğrencileriniz boş saatlerden ders ister, siz onaylayınca ders kesinleşir.</p></div>
    <div class="actions">
      <button class="btn btn-ghost btn-sm" type="button" data-open="add">+ Ders ekle</button>
      <button class="btn btn-accent btn-sm" type="button" data-open="now">Şimdi ders başlat</button>
    </div>
  </div>
  {session.demo && <span class="demo-flag">Önizleme: örnek verilerle (yalnızca bu bilgisayarda)</span>}
  {flash && <p class:list={['flash', flash[1]]} role="status">{flash[0]}</p>}

  {d.requests.length > 0 && (
    <section class="panel" aria-labelledby="req-title">
      <div class="panel-head"><h2 id="req-title">Onay bekleyen istekler <span class="badge requested">{d.requests.length}</span></h2></div>
      <div class="requests">
        {d.requests.map((a) => (
          <div class="req">
            <div><b>{who(a)}</b><small>{whenLabel(a.starts_at)} · {minutesOf(a)} dk</small>{a.note && <q>{a.note}</q>}</div>
            <div class="acts">
              <button class="btn btn-primary btn-sm" type="button" data-decide={a.id} data-accept="1">Onayla</button>
              <button class="btn btn-ghost btn-sm" type="button" data-decide={a.id} data-accept="0">Uygun değil</button>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="panel" aria-labelledby="week-title">
    <div class="panel-head">
      <h2 id="week-title">Hafta</h2>
      <div class="week-nav"><a href={q(weekOffset - 1)} aria-label="Önceki hafta">‹</a><span>{weekLabel}</span><a href={q(weekOffset + 1)} aria-label="Sonraki hafta">›</a></div>
    </div>
    <div class="legend"><span><i class="l-open"></i>Ders saatleriniz</span><span><i class="l-ok"></i>Birebir ders</span><span><i class="l-group"></i>Grup dersi</span><span><i class="l-req"></i>Onay bekliyor</span><span><i class="l-off"></i>Kapalı</span></div>
    <div class="week-wrap">
      <div class="week" style={`--h:${H}px`}>
        <div class="corner"></div>
        {days.map((day, i) => <div class:list={['dh', { today: day === today }]}>{WEEKDAYS_SHORT[i]}<small>{shortDay(day)}</small></div>)}
        <div class="gut" style={`height:${(endH - startH) * H}px`}>{hoursList.slice(1).map((h, i) => <span style={`top:${(i + 1) * H}px`}>{hm(h * 60)}</span>)}</div>
        {days.map((day, i) => (
          <div class:list={['col', { today: day === today }]} style={`height:${(endH - startH) * H}px`}>
            {hoursByDay[i].map((h) => <div class="open" style={`top:${y(h.startMin)}px;height:${((h.endMin - h.startMin) / 60) * H}px`}></div>)}
            {d.blocks.map((b) => { const c = clip(day, Date.parse(b.startsAt), Date.parse(b.endsAt)); return c && <div class="off" style={`top:${c.top}px;height:${c.h}px`}><span>{b.note || 'Kapalı'}</span></div>; })}
            {d.week.map((a) => {
              if (localParts(Date.parse(a.starts_at)).day !== day) return null;
              const c = clip(day, Date.parse(a.starts_at), Date.parse(a.ends_at));
              return c && <button type="button" class:list={['ev', { req: a.status === 'requested', group: a.kind === 'group', instant: a.kind === 'instant' }]} style={`top:${c.top + 1}px;height:${Math.max(c.h - 2, 22)}px`} data-ev={evData(a)}><b>{who(a)}</b>{timeOf(a.starts_at)}–{timeOf(a.ends_at)}</button>;
            })}
            {day === today && localParts(now).minute >= startH * 60 && localParts(now).minute <= endH * 60 && <div class="now" style={`top:${y(localParts(now).minute)}px`}></div>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="grid">
    <section class="panel col-8" aria-labelledby="hours-title">
      <div class="panel-head"><h2 id="hours-title">Ders saatlerim</h2></div>
      <p class="muted" style="font-size:14px">Öğrencileriniz yalnızca bu saatlerdeki boş yerlerden ders isteyebilir (Türkiye saati).</p>
      <form id="settings" class="hours" novalidate>
        {WEEKDAYS.map((name, wd) => (
          <div class:list={['hrow', { closed: hoursByDay[wd].length === 0 }]} data-wd={wd}>
            <label><input type="checkbox" checked={hoursByDay[wd].length > 0} data-day-on />{name}</label>
            <div class="ranges">
              {(hoursByDay[wd].length ? hoursByDay[wd] : [{ startMin: 17 * 60, endMin: 21 * 60 }]).map((h) => (
                <span class="range"><input type="time" step="900" value={hm(h.startMin)} aria-label={`${name} başlangıç`} />–<input type="time" step="900" value={hm(h.endMin === 1440 ? 1439 : h.endMin)} aria-label={`${name} bitiş`} /><button type="button" data-del-range aria-label="Aralığı sil">×</button></span>
              ))}
              <button type="button" class="add-range" data-add-range>+ aralık</button>
            </div>
          </div>
        ))}
        <div class="form-grid">
          <label class="fld">Ders süresi<select name="lessonMin">{LESSON_LENGTHS.map((m) => <option value={m} selected={m === d.settings.lessonMin}>{m} dakika</option>)}</select></label>
          <label class="fld">En az ne kadar önceden?<select name="noticeHours">{[0, 2, 6, 12, 24, 48].map((h) => <option value={h} selected={h === d.settings.noticeHours}>{h === 0 ? 'Son dakikaya kadar' : `${h} saat önce`}</option>)}</select></label>
          <label class="fld">En fazla ne kadar ileriye?<select name="windowDays">{[7, 14, 21, 30, 60].map((n) => <option value={n} selected={n === d.settings.windowDays}>{n} gün</option>)}</select></label>
        </div>
        <div class="row" style="display:flex;gap:12px;align-items:center;flex-wrap:wrap">
          <button class="btn btn-primary btn-sm" type="submit">Kaydet</button><span class="msg" data-msg aria-live="polite"></span>
        </div>
      </form>
    </section>

    <div class="col-4" style="display:grid;gap:18px;align-content:start">
      <section class="panel" aria-labelledby="g-title">
        <div class="google">
          <span class="g"><svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#00832d" d="M27.5 24 31.6 28.7 37 32.2l1-8.1-1-7.9-5.6 3z"/><path fill="#0066da" d="M4 31.4V38c0 1.5 1.2 2.7 2.7 2.7h6.6l1.4-5-1.4-4.3-4.5-1.4z"/><path fill="#e94235" d="M13.3 7.3 4 16.6l4.8 1.4 4.5-1.4 1.3-4.3z"/><path fill="#2684fc" d="M13.3 16.6H4v14.8h9.3z"/><path fill="#00ac47" d="M41.5 11.4 37 15.9v16.3l4.5 4.6c.7.5 1.5 0 1.5-.8V12.2c0-.9-.9-1.4-1.5-.8M27.5 24v7.4H13.3v9.3h21c1.5 0 2.7-1.2 2.7-2.7v-5.8z"/><path fill="#ffba00" d="M34.3 7.3h-21v9.3h14.2V24l9.5-7.9V10c0-1.5-1.2-2.7-2.7-2.7"/></svg></span>
          <div style="display:grid;gap:10px">
            <h2 id="g-title">Google Meet</h2>
            {d.google ? (
              <>
                <span class="status-dot">Bağlı: {d.google.email || 'Google hesabınız'}</span>
                <p class="muted" style="font-size:14px">Onayladığınız her ders Google Takviminize eklenir, Meet bağlantısı otomatik oluşur ve öğrenciye davet gider.</p>
                <button class="btn btn-ghost btn-sm" type="button" data-google-off style="justify-self:start">Bağlantıyı kaldır</button>
              </>
            ) : gReady ? (
              <>
                <p class="muted" style="font-size:14px">Google Takviminizi bağlayın: her ders için Meet bağlantısı otomatik oluşsun, ders takviminize eklensin.</p>
                <a class="btn btn-primary btn-sm" href="/api/google/connect" style="justify-self:start">Google Takvim’i bağla</a>
              </>
            ) : (
              <p class="muted" style="font-size:14px">Otomatik Meet bağlantısı yakında. Şimdilik kendi Meet bağlantınızı aşağıya ekleyin; yoksa dersler Languago’nun görüntülü ders odasında yapılır.</p>
            )}
            <label class="fld">Kendi Meet bağlantınız <small>(Google bağlı değilken kullanılır)</small>
              <input form="settings" name="meetLink" type="url" inputmode="url" placeholder="https://meet.google.com/abc-defg-hij" value={d.settings.meetLink || ''} />
            </label>
          </div>
        </div>
      </section>

      <section class="panel" aria-labelledby="off-title">
        <h2 id="off-title">Kapalı günler</h2>
        <form id="blocks" class="form-grid" novalidate>
          <label class="fld">İlk gün<input type="date" name="from" min={todayIso} required /></label>
          <label class="fld">Son gün<input type="date" name="to" min={todayIso} /></label>
          <label class="fld" style="grid-column:1/-1">Not <small>(yalnızca siz görürsünüz)</small><input name="note" maxlength="120" placeholder="Tatil, sınav haftası…" /></label>
          <div style="display:flex;gap:12px;align-items:center;grid-column:1/-1"><button class="btn btn-ghost btn-sm" type="submit">Kapat</button><span class="msg" data-msg aria-live="polite"></span></div>
        </form>
        {d.blocks.length > 0 && <div class="chips">{d.blocks.map((b) => (
          <span class="chip-x">{shortDay(localParts(Date.parse(b.startsAt)).day)}{localParts(Date.parse(b.endsAt) - 1).day !== localParts(Date.parse(b.startsAt)).day && ` – ${shortDay(localParts(Date.parse(b.endsAt) - 1).day)}`}{b.note && ` · ${b.note}`}<button type="button" data-unblock={b.id} aria-label="Kaldır">×</button></span>
        ))}</div>}
      </section>

      <section class="panel" aria-labelledby="codes-title">
        <h2 id="codes-title">Sınıf kodları</h2>
        {d.classes.length ? (
          <>
            <p class="muted" style="font-size:14px">Öğrencileriniz bu kodla sınıfınıza katılır ve takviminizden ders isteyebilir.</p>
            <div class="chips">{d.classes.map((c) => <span class="chip-x" style="padding-right:12px"><b style="font-family:ui-monospace,monospace;letter-spacing:.08em">{c.code}</b> {c.name}</span>)}</div>
          </>
        ) : <p class="muted" style="font-size:14px">Önce bir sınıf oluşturun; öğrencileriniz sınıf koduyla katılınca takviminizden ders isteyebilir. <a href="/teacher/siniflar" style="color:#5eead4">Sınıf oluştur →</a></p>}
      </section>
    </div>
  </div>

  <dialog class="sheet" id="dlg-add" aria-labelledby="add-title">
    <form id="add" method="dialog" novalidate>
      <h2 id="add-title">Ders ekle</h2>
      <label class="fld">Kiminle?<select name="target" required>
        <option value="">Seçin</option>
        {d.students.length > 0 && <optgroup label="Öğrenciler">{d.students.map((s) => <option value={`student:${s.id}`}>{s.name}</option>)}</optgroup>}
        {d.classes.length > 0 && <optgroup label="Sınıflar">{d.classes.map((c) => <option value={`class:${c.id}`}>{c.name}</option>)}</optgroup>}
      </select></label>
      <div class="form-grid">
        <label class="fld">Tarih<input type="date" name="date" min={todayIso} value={todayIso} required /></label>
        <label class="fld">Saat<input type="time" name="time" step="300" value="18:00" required /></label>
        <label class="fld">Süre<select name="minutes">{LESSON_LENGTHS.map((m) => <option value={m} selected={m === d.settings.lessonMin}>{m} dk</option>)}</select></label>
      </div>
      <label class="fld">Başlık <small>(isteğe bağlı)</small><input name="title" maxlength="120" placeholder="Ör. IELTS konuşma pratiği" /></label>
      <p class="muted" style="font-size:13.5px">Ders hemen kesinleşir; öğrenciye e-posta ve bildirim gider.</p>
      <span class="msg" data-msg aria-live="polite"></span>
      <div class="row"><button class="btn btn-ghost btn-sm" value="cancel" formnovalidate>Vazgeç</button><button class="btn btn-primary btn-sm" type="submit" value="ok">Dersi ekle</button></div>
    </form>
  </dialog>

  <dialog class="sheet" id="dlg-now" aria-labelledby="now-title">
    <form id="now" method="dialog" novalidate>
      <h2 id="now-title">Şimdi ders başlat</h2>
      <p class="muted" style="font-size:14px">Ders hemen başlar ve Meet bağlantısı yeni sekmede açılır. Seçtiğiniz öğrenci ya da sınıfa bağlantı gönderilir.</p>
      <label class="fld">Kimi çağıralım?<select name="target">
        <option value="">Kimseyi (bağlantıyı ben paylaşırım)</option>
        {d.students.length > 0 && <optgroup label="Öğrenciler">{d.students.map((s) => <option value={`student:${s.id}`}>{s.name}</option>)}</optgroup>}
        {d.classes.length > 0 && <optgroup label="Sınıflar">{d.classes.map((c) => <option value={`class:${c.id}`}>{c.name}</option>)}</optgroup>}
      </select></label>
      <label class="fld">Süre<select name="minutes">{[30, 45, 60, 90].map((m) => <option value={m} selected={m === 60}>{m} dk</option>)}</select></label>
      <span class="msg" data-msg aria-live="polite"></span>
      <div class="row"><button class="btn btn-ghost btn-sm" value="cancel" formnovalidate>Vazgeç</button><button class="btn btn-accent btn-sm" type="submit" value="ok">Başlat</button></div>
    </form>
  </dialog>

  <dialog class="sheet" id="dlg-ev" aria-labelledby="ev-title">
    <div class="body">
      <h2 id="ev-title"></h2>
      <p data-f="when" style="font-weight:700"></p>
      <p><span class="badge" data-f="status"></span></p>
      <p class="muted" data-f="note" style="font-style:italic"></p>
      <span class="msg" data-msg aria-live="polite"></span>
      <div class="row">
        <button class="btn btn-ghost btn-sm" type="button" data-cancel-ev>Dersi iptal et</button>
        <a class="btn btn-ghost btn-sm" data-f="cal" target="_blank" rel="noopener">Takvime ekle</a>
        <a class="btn btn-primary btn-sm" data-f="join" target="_blank" rel="noopener">Derse katıl</a>
      </div>
    </div>
  </dialog>

  <script is:inline define:vars={{ demo: session.demo, labels: { requested: 'Onay bekliyor', confirmed: 'Onaylandı' } }}>
    (function () {
      var post = function (url, body) {
        if (demo) return Promise.resolve({ ok: false, error: 'Önizlemede kaydedilmez.' });
        return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
          .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
          .catch(function () { return { ok: false, error: 'Bağlantı sorunu. Tekrar deneyin.' }; });
      };
      var say = function (root, text, ok) { var m = root.querySelector('[data-msg]'); if (m) { m.textContent = text || ''; m.classList.toggle('ok', !!ok); } };
      var reload = function () { setTimeout(function () { location.reload(); }, 500); };

      // phones: the week scrolls sideways; start at today
      var wrap = document.querySelector('.week-wrap'), todayCol = document.querySelector('.week .col.today');
      if (wrap && todayCol && wrap.scrollWidth > wrap.clientWidth) wrap.scrollLeft = todayCol.offsetLeft - 44;

      // requests
      document.querySelectorAll('[data-decide]').forEach(function (b) {
        b.addEventListener('click', function () {
          var row = b.closest('.req'); row.querySelectorAll('button').forEach(function (x) { x.disabled = true; });
          post('/api/timetable/decide', { id: b.dataset.decide, accept: b.dataset.accept === '1' }).then(function (r) {
            if (r.ok) { row.style.opacity = '.4'; reload(); } else { alert(r.error || 'Olmadı.'); row.querySelectorAll('button').forEach(function (x) { x.disabled = false; }); }
          });
        });
      });

      // weekly hours editor
      var settings = document.getElementById('settings');
      var rangeHtml = '<input type="time" step="900" value="17:00" />–<input type="time" step="900" value="21:00" /><button type="button" data-del-range aria-label="Aralığı sil">×</button>';
      settings.addEventListener('click', function (e) {
        var t = e.target;
        if (t.matches('[data-add-range]')) { var s = document.createElement('span'); s.className = 'range'; s.innerHTML = rangeHtml; t.before(s); }
        if (t.matches('[data-del-range]')) { var row = t.closest('.hrow'); t.parentElement.remove(); if (!row.querySelector('.range')) { row.querySelector('[data-day-on]').checked = false; row.classList.add('closed'); var s2 = document.createElement('span'); s2.className = 'range'; s2.innerHTML = rangeHtml; row.querySelector('[data-add-range]').before(s2); } }
      });
      settings.addEventListener('change', function (e) { if (e.target.matches('[data-day-on]')) e.target.closest('.hrow').classList.toggle('closed', !e.target.checked); });
      settings.addEventListener('submit', function (e) {
        e.preventDefault();
        var hours = [];
        settings.querySelectorAll('.hrow').forEach(function (row) {
          if (!row.querySelector('[data-day-on]').checked) return;
          row.querySelectorAll('.range').forEach(function (r) {
            var i = r.querySelectorAll('input'); var end = i[1].value === '23:59' ? '24:00' : i[1].value;
            if (i[0].value && end) hours.push({ weekday: Number(row.dataset.wd), start: i[0].value, end: end });
          });
        });
        var f = new FormData(settings);
        var link = document.querySelector('input[name="meetLink"]');
        say(settings, 'Kaydediliyor…', true);
        post('/api/timetable/settings', { hours: hours, lessonMin: Number(f.get('lessonMin')), noticeHours: Number(f.get('noticeHours')), windowDays: Number(f.get('windowDays')), meetLink: link ? link.value : '' })
          .then(function (r) { if (r.ok) { say(settings, 'Kaydedildi.', true); reload(); } else say(settings, r.error || 'Kaydedilemedi.'); });
      });

      // closed days
      var blocks = document.getElementById('blocks');
      blocks.addEventListener('submit', function (e) {
        e.preventDefault(); var f = new FormData(blocks);
        if (!f.get('from')) return say(blocks, 'İlk günü seçin.');
        post('/api/timetable/blocks', { from: f.get('from'), to: f.get('to') || f.get('from'), note: f.get('note') })
          .then(function (r) { if (r.ok) reload(); else say(blocks, r.error || 'Kaydedilemedi.'); });
      });
      document.querySelectorAll('[data-unblock]').forEach(function (b) {
        b.addEventListener('click', function () { post('/api/timetable/blocks', { remove: b.dataset.unblock }).then(function (r) { if (r.ok) reload(); }); });
      });

      // google
      var off = document.querySelector('[data-google-off]');
      if (off) off.addEventListener('click', function () {
        if (!confirm('Google Takvim bağlantısı kaldırılsın mı? Sonraki derslere Meet bağlantısı otomatik eklenmez.')) return;
        post('/api/google/disconnect', {}).then(function (r) { if (r.ok) location.href = '/app/takvim'; });
      });

      // dialogs
      var open = function (id) { var d = document.getElementById(id); if (d && d.showModal) d.showModal(); };
      document.querySelectorAll('[data-open]').forEach(function (b) { b.addEventListener('click', function () { open('dlg-' + b.dataset.open); }); });
      var add = document.getElementById('add');
      add.addEventListener('submit', function (e) {
        if (e.submitter && e.submitter.value === 'cancel') return;
        e.preventDefault(); var f = new FormData(add);
        if (!f.get('target')) return say(add, 'Bir öğrenci ya da sınıf seçin.');
        say(add, 'Ekleniyor…', true);
        post('/api/timetable/add', { target: f.get('target'), date: f.get('date'), time: f.get('time'), minutes: Number(f.get('minutes')), title: f.get('title') })
          .then(function (r) { if (r.ok) { say(add, 'Ders eklendi.', true); reload(); } else say(add, r.error || 'Eklenemedi.'); });
      });
      var nowF = document.getElementById('now');
      nowF.addEventListener('submit', function (e) {
        if (e.submitter && e.submitter.value === 'cancel') return;
        e.preventDefault(); var f = new FormData(nowF);
        // Open the tab now (inside the click) so the browser does not block it.
        var tab = demo ? null : window.open('about:blank', '_blank');
        say(nowF, 'Ders hazırlanıyor…', true);
        post('/api/timetable/now', { target: f.get('target') || '', minutes: Number(f.get('minutes')) }).then(function (r) {
          if (r.ok && r.url) { if (tab) tab.location.href = r.url; else location.href = r.url; say(nowF, 'Ders başladı.', true); reload(); }
          else { if (tab) tab.close(); say(nowF, r.error || 'Başlatılamadı.'); }
        });
      });

      // lesson details
      var ev = document.getElementById('dlg-ev'); var current = null;
      document.querySelectorAll('[data-ev]').forEach(function (b) {
        b.addEventListener('click', function () {
          var a = JSON.parse(b.dataset.ev); current = a;
          ev.querySelector('#ev-title').textContent = a.who + ' · ' + a.title;
          ev.querySelector('[data-f="when"]').textContent = a.when;
          var st = ev.querySelector('[data-f="status"]'); st.textContent = labels[a.status] || a.status; st.className = 'badge ' + a.status;
          ev.querySelector('[data-f="note"]').textContent = a.note ? '“' + a.note + '”' : '';
          ev.querySelector('[data-f="join"]').href = a.join; ev.querySelector('[data-f="join"]').hidden = a.status !== 'confirmed';
          ev.querySelector('[data-f="cal"]').href = a.cal; ev.querySelector('[data-f="cal"]').hidden = a.status !== 'confirmed';
          ev.querySelector('[data-cancel-ev]').hidden = a.past;
          say(ev, ''); ev.showModal();
        });
      });
      ev.addEventListener('click', function (e) { if (e.target === ev) ev.close(); });
      ev.querySelector('[data-cancel-ev]').addEventListener('click', function () {
        if (!current || !confirm('Bu ders iptal edilsin mi? Öğrenciye haber verilir.')) return;
        post('/api/timetable/cancel', { id: current.id }).then(function (r) { if (r.ok) reload(); else say(ev, r.error || 'İptal edilemedi.'); });
      });
    })();
  </script>
</AppShell>
