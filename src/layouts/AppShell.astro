---
// Languago 2.0 app shell (/app): sidebar on desktop, tab bar on phones, menus
// by role. Screens that are not rebuilt yet link to the working old pages.
import '../styles/site.css';
import '../styles/site-dark.css';
import '../styles/app.css';
import type { AppSession } from '../lib/app-session';

interface Props { session: AppSession; title: string; current: string }
const { session, title, current } = Astro.props;
const teacher = session.role === 'teacher' || session.role === 'admin';
const demo = session.demo ? `?demo=${teacher ? 'ogretmen' : 'ogrenci'}` : '';

const I = {
  home: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11 12 4l9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>',
  path: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="5" cy="19" r="2"/><circle cx="19" cy="5" r="2"/><path d="M7 19h6a4 4 0 0 0 0-8h-2a4 4 0 0 1 0-8h6"/></svg>',
  practice: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v3M12 18v3M3 12h3M18 12h3"/><circle cx="12" cy="12" r="5"/></svg>',
  lessons: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>',
  me: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>',
  students: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4.5a3.5 3.5 0 0 1 0 7M21.5 20a6.5 6.5 0 0 0-4-6"/></svg>',
  classes: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>',
  materials: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h10l6 6v10a1 1 0 0 1-1 1H4z"/><path d="M14 4v6h6"/></svg>',
  games: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="7" width="19" height="11" rx="5"/><path d="M7 11v3M5.5 12.5h3M15.5 12h.01M18 13.5h.01"/></svg>',
  bell: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 8 3 8H3s3-1 3-8M10 21h4"/></svg>',
};
type Item = { href: string; label: string; icon: string; soon?: boolean };
const items: Item[] = teacher
  ? [
      { href: `/app${demo}`, label: 'Bugün', icon: I.home },
      { href: '/teacher/takvim', label: 'Takvim', icon: I.lessons },
      { href: '/teacher/ogrenciler', label: 'Öğrenciler', icon: I.students },
      { href: '/teacher/siniflar', label: 'Sınıflar', icon: I.classes },
      { href: '/teacher/materyal', label: 'Materyaller', icon: I.materials },
      { href: '/sinif-oyunlari', label: 'Sınıf oyunları', icon: I.games },
    ]
  : [
      { href: `/app${demo}`, label: 'Bugün', icon: I.home },
      { href: '/dashboard/yol', label: 'Yolum', icon: I.path },
      { href: '/dashboard/gunluk', label: 'Pratik', icon: I.practice },
      { href: '/dashboard/birebir', label: 'Derslerim', icon: I.lessons },
      { href: '/dashboard', label: 'Ben', icon: I.me },
    ];
const isCurrent = (href: string) => (href.split('?')[0] === current ? 'page' : undefined);
const initial = (session.firstName || '?').charAt(0).toLocaleUpperCase('tr-TR');
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#071110" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="lg dark">
    <svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs><linearGradient id="ringGrad" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#5eead4" /><stop offset="1" stop-color="#14b8a6" /></linearGradient></defs></svg>
    <div class="app">
      <aside class="side" aria-label="Uygulama menüsü">
        <a class="brand" href={`/app${demo}`}><img src="/brand/logo-mark.svg" alt="" width="34" height="34" />languago</a>
        <nav>
          {items.map((it) => <a class="nav" href={it.href} aria-current={isCurrent(it.href)}><Fragment set:html={it.icon} />{it.label}</a>)}
        </nav>
        <div class="me">
          <span class="avatar" aria-hidden="true">{initial}</span>
          <span><b>{session.firstName}</b><small>{teacher ? 'Öğretmen' : 'Öğrenci'}</small></span>
          <a href="/api/auth/signout" data-signout>Çıkış</a>
        </div>
      </aside>
      <main class="main" id="main">
        <slot />
      </main>
      <nav class="tabbar" aria-label="Alt menü">
        {items.slice(0, 5).map((it) => <a href={it.href} aria-current={isCurrent(it.href)}><Fragment set:html={it.icon} />{it.label}</a>)}
      </nav>
    </div>
    <script is:inline>
      (function () {
        document.querySelectorAll('[data-signout]').forEach(function (a) {
          a.addEventListener('click', function (e) {
            e.preventDefault();
            fetch('/api/auth/signout', { method: 'POST' }).catch(function () {}).then(function () { window.location.href = '/'; });
          });
        });
      })();
      (function () {
        // A soft light follows the pointer or finger inside panels.
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var move = function (x, y, t) {
          var p = t && t.closest ? t.closest('.panel') : null;
          if (!p) return;
          var r = p.getBoundingClientRect();
          p.style.setProperty('--mx', ((x - r.left) / r.width * 100) + '%');
          p.style.setProperty('--my', ((y - r.top) / r.height * 100) + '%');
        };
        window.addEventListener('pointermove', function (e) { move(e.clientX, e.clientY, e.target); }, { passive: true });
        window.addEventListener('touchmove', function (e) { var t = e.touches[0]; if (t) move(t.clientX, t.clientY, document.elementFromPoint(t.clientX, t.clientY)); }, { passive: true });
        // Fill progress rings after the first paint.
        requestAnimationFrame(function () { requestAnimationFrame(function () {
          document.querySelectorAll('.ring .v').forEach(function (c) { c.style.setProperty('--off', c.getAttribute('data-off')); });
        }); });
      })();
    </script>
  </body>
</html>
