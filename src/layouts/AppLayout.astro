---
// Languago app shell for signed-in areas (/dashboard/* and /teacher/*).
// Unlike the public Layout (marketing nav: Ana Sayfa/İndir/Kayıt Ol/Giriş Yap),
// this renders a slim app header: a brand link into the app and a user menu
// (signed-in user's name/email + "Çıkış Yap"). No marketing links.
//
// The signed-in user is read server-side (guarded). If the session cannot be
// resolved (e.g. build/prerender without cookies), the menu simply falls back
// to the sign-out button without a name/email.
interface Props {
  title: string;
  description?: string;
  /** Fully-qualified page URL (e.g. "https://www.languago.site/..."). */
  canonical?: string;
  image?: string;
}

import '../styles/global.css';
import { createSupabaseClient, pageCookieSource } from '../lib/supabase';

const {
  title,
  description = 'Languago ile İngilizce öğrenin: kelime, dil bilgisi, okuma ve sınıf içi oyunlar.',
  canonical,
  image,
} = Astro.props;

const siteUrl = Astro.site?.origin || 'https://www.languago.site';
const path = Astro.url.pathname;
const pageUrl = canonical || `${siteUrl}${path}`;
const ogImage = image || `${siteUrl}/og-cover.png`;

let userName: string | null = null;
let userEmail: string | null = null;
const supabase = createSupabaseClient(pageCookieSource(Astro));
if (supabase) {
  try {
    const { data } = await supabase.auth.getUser();
    const u = data.user;
    if (u) {
      userEmail = u.email ?? null;
      userName =
        (u.user_metadata?.full_name as string | undefined) || userEmail;
    }
  } catch {
    // Ignore — fall back to a menu without identity.
  }
}

const displayName = userName ?? userEmail ?? null;
const initial = displayName ? displayName.trim().charAt(0).toUpperCase() : 'H';
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- SEO -->
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={pageUrl} />
    <meta name="theme-color" content="#0d9488" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🐟</text></svg>" />

    <!-- PWA (manifest metadatas only; SW is registered on the public landing) -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Languago" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Languago" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="576" />
    <meta property="og:image:alt" content="Languago — İngilizce öğrenmenin oyunlu yolu" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <slot name="head" />
  </head>
  <body>
    <header class="app-header">
      <div class="container app-bar">
        <a class="brand" href="/dashboard">
          <img class="brand-mark" src="/mascot.png" alt="Kommo — Languago maskotu" width="40" height="40" /> Languago
          <small>panel</small>
        </a>

        <div class="user-menu">
          <!-- Notification bell: rendered server-side but hydrated client-side.
               If /api/notifications is unreachable (no Supabase, no session)
               the #notif-bell container is hidden by JS — guarded, no noise. -->
          <div class="notif-bell" id="notif-bell" hidden>
            <button
              type="button"
              class="notif-bell__btn"
              id="notif-bell-btn"
              aria-haspopup="true"
              aria-expanded="false"
              aria-label="Bildirimler"
            >
              <span class="notif-bell__icon" aria-hidden="true">🔔</span>
              <span class="notif-bell__badge" id="notif-bell-badge" hidden>0</span>
            </button>
            <div class="notif-panel" id="notif-panel" hidden>
              <div class="notif-panel__head">
                <span class="notif-panel__title">Bildirimler</span>
                <button type="button" class="notif-panel__all" id="notif-bell-all" hidden>
                  Tümünü oku
                </button>
              </div>
              <div class="notif-panel__body" id="notif-panel-body">
                <div class="notif-panel__empty">
                  📭 Henüz bildirimin yok.
                  <span>Yeni bir şey olduğunda burada göreceksin.</span>
                </div>
              </div>
              <div class="notif-panel__foot">
                <a href="/dashboard/bildirimler">Tüm bildirimler →</a>
              </div>
            </div>
          </div>
          {
            displayName && (
              <span class="user-chip" title={userEmail ?? displayName}>
                <span class="user-avatar">{initial}</span>
                <span class="user-id">
                  <span class="user-name">{displayName}</span>
                  {userEmail && <span class="user-email">{userEmail}</span>}
                </span>
              </span>
            )
          }
          <form id="app-signout-form" class="signout-form">
            <button class="btn ghost signout-btn" type="submit">Çıkış Yap</button>
          </form>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="app-footer">
      <div class="container">
        <span>© {new Date().getFullYear()} Languago</span>
        <a class="foot-link" href="/dashboard">Öğrenci Paneli</a>
      </div>
    </footer>
  </body>
</html>

<script is:inline>
  (function () {
    function relativeTime(iso) {
      if (!iso) return '';
      var created = new Date(iso);
      if (Number.isNaN(created.getTime())) return '';
      var s = Math.round((Date.now() - created.getTime()) / 1000);
      if (s < 60) return 'az önce';
      var m = Math.floor(s / 60);
      if (m < 60) return m + ' dk önce';
      var h = Math.floor(m / 60);
      if (h < 24) return h + ' sa önce';
      var d = Math.floor(h / 24);
      if (d === 1) return 'dün';
      if (d < 7) return d + ' gün önce';
      return created.toLocaleDateString('tr-TR', { day: 'numeric', month: 'short' });
    }

    function el(tag, cls) {
      var node = document.createElement(tag);
      if (cls) node.className = cls;
      return node;
    }

    var bell = document.getElementById('notif-bell');
    var btn = document.getElementById('notif-bell-btn');
    var badge = document.getElementById('notif-bell-badge');
    var panel = document.getElementById('notif-panel');
    var body = document.getElementById('notif-panel-body');
    var allBtn = document.getElementById('notif-bell-all');
    if (!bell || !btn || !badge || !panel || !body) return;

    var list = [];

    function setUnread(n) {
      if (n > 0) {
        badge.textContent = n > 9 ? '9+' : String(n);
        badge.hidden = false;
      } else {
        badge.hidden = true;
      }
    }

    function renderEmpty() {
      body.classList.add('has-empty');
      var empty = el('div', 'notif-panel__empty');
      empty.appendChild(el('span')).textContent = '📭';
      var line = el('span');
      line.textContent = 'Henüz bildirimin yok. Yeni bir şey olduğunda burada göreceksin.';
      empty.appendChild(line);
      body.appendChild(empty);
      allBtn.hidden = true;
    }

    function render(items) {
      body.classList.remove('has-empty');
      body.innerHTML = '';
      if (!items.length) {
        renderEmpty();
        return;
      }
      var unread = items.filter(function (i) { return !i.is_read; }).length;
      allBtn.hidden = unread === 0;
      items.forEach(function (n) {
        var row = el('button', 'notif-item' + (n.is_read ? '' : ' is-unread'));
        row.type = 'button';
        row.setAttribute('data-id', n.id);
        var dot = el('span', 'notif-item__dot');
        var text = el('span', 'notif-item__text');
        var title = el('span', 'notif-item__title');
        title.textContent = n.title || 'Bildirim';
        text.appendChild(title);
        if (n.body) {
          var bodyNode = el('span', 'notif-item__body');
          bodyNode.textContent = n.body;
          text.appendChild(bodyNode);
        }
        var time = el('span', 'notif-item__time');
        time.textContent = relativeTime(n.created_at);
        row.appendChild(dot);
        row.appendChild(text);
        row.appendChild(time);
        row.addEventListener('click', function () {
          markOne(n, row);
        });
        body.appendChild(row);
      });
      setUnread(unread);
    }

    function markOne(n, row) {
      // Fail soft: never block navigation on a failed read-mark.
      fetch('/api/notifications', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: n.id }),
      }).catch(function () { /* best-effort */ });

      row.classList.remove('is-unread');
      var remaining = list.filter(function (i) { return !i.is_read; }).length - 1;
      list = list.map(function (i) { return i.id === n.id ? Object.assign({}, i, { is_read: true }) : i; });
      setUnread(remaining);
      allBtn.hidden = remaining === 0;

      if (n.href) {
        window.location.href = n.href;
        return;
      }
      // No link: keep the dropdown open so the user can read the rest.
      panel.hidden = false;
    }

    function markAllRead() {
      fetch('/api/notifications', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ all: true }),
      }).catch(function () {});
      list = list.map(function (i) { return Object.assign({}, i, { is_read: true }); });
      setUnread(0);
      allBtn.hidden = true;
      var rows = body.querySelectorAll('.notif-item');
      for (var i = 0; i < rows.length; i++) rows[i].classList.remove('is-unread');
    }

    function openBell() {
      var open = !panel.hidden;
      panel.hidden = open;
      btn.setAttribute('aria-expanded', open ? 'false' : 'true');
    }

    btn.addEventListener('click', openBell);
    allBtn.addEventListener('click', markAllRead);

    document.addEventListener('click', function (e) {
      if (!bell.contains(e.target)) {
        if (!panel.hidden) {
          panel.hidden = true;
          btn.setAttribute('aria-expanded', 'false');
        }
      }
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !panel.hidden) {
        panel.hidden = true;
        btn.setAttribute('aria-expanded', 'false');
      }
    });

    // Hydrate. If the endpoint fails (no Supabase / no session / network), hide
    // the bell entirely and bail — the layout stays clean and guarded.
    fetch('/api/notifications')
      .then(function (res) {
        if (!res.ok) throw new Error('bad-status');
        return res.json();
      })
      .then(function (json) {
        if (!json || !json.ok) throw new Error('bad-body');
        list = Array.isArray(json.notifications) ? json.notifications : [];
        bell.hidden = false;
        render(list);
      })
      .catch(function () {
        bell.hidden = true;
      });
  })();
</script>

<script is:inline>
  (function () {
    var form = document.getElementById('app-signout-form');
    if (!form) return;
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var btn = form.querySelector('button');
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Çıkılıyor…';
      }
      fetch('/api/auth/signout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: '{}',
      })
        .then(function () {
          window.location.href = '/';
        })
        .catch(function () {
          // Endpoint failure: still leave the app so the user is not left
          // stuck on a dashboard they can't use.
          window.location.href = '/';
        });
    });
  })();
</script>

<style>
  .app-header {
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    border-top: 4px solid var(--teal);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .app-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 64px;
  }
  .app-header .brand small {
    font-size: 0.75rem;
  }
  .user-menu {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .user-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    background: var(--teal-soft);
    border: 1px solid var(--teal-soft);
    border-radius: 999px;
    max-width: 100%;
  }
  .user-avatar {
    width: 28px;
    height: 28px;
    flex: 0 0 28px;
    border-radius: 50%;
    background: var(--teal);
    color: #fff;
    font-weight: 800;
    font-size: 0.9rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .user-id {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    min-width: 0;
  }
  .user-name {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 180px;
  }
  .user-email {
    font-size: 0.75rem;
    color: var(--ink-soft);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 180px;
  }
  .signout-form {
    margin: 0;
  }
  .signout-btn {
    padding: 8px 16px;
    font-size: 0.9rem;
  }
  /* ---- Q19 notification bell ---- */
  .notif-bell {
    position: relative;
    display: inline-flex;
    flex: 0 0 auto;
  }
  .notif-bell__btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--bg);
    font-size: 1.15rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, transform 0.05s;
  }
  .notif-bell__btn:hover {
    background: var(--teal-soft);
    border-color: var(--teal-soft);
  }
  .notif-bell__btn:active {
    transform: translateY(1px);
  }
  .notif-bell__icon {
    display: inline-flex;
  }
  .notif-bell__badge {
    position: absolute;
    top: -6px;
    right: -6px;
    min-width: 19px;
    height: 19px;
    padding: 0 5px;
    border-radius: 999px;
    background: var(--brand);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 800;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #fff;
  }
  .notif-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    width: min(370px, calc(100vw - 32px));
    background: var(--bg);
    border: 1px solid var(--line);
    border-top: 4px solid var(--teal);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    z-index: 40;
    overflow: hidden;
  }
  .notif-panel__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    background: var(--bg-soft);
  }
  .notif-panel__title {
    font-weight: 800;
    font-size: 0.95rem;
  }
  .notif-panel__all {
    border: none;
    background: transparent;
    color: var(--teal);
    font-weight: 700;
    font-size: 0.82rem;
    cursor: pointer;
    padding: 2px 6px;
    border-radius: 6px;
  }
  .notif-panel__all:hover {
    background: var(--teal-soft);
    color: var(--teal-dark);
  }
  .notif-panel__body {
    max-height: min(50vh, 360px);
    overflow-y: auto;
  }
  .notif-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    width: 100%;
    text-align: left;
    padding: 12px 16px;
    border: none;
    background: var(--bg);
    cursor: pointer;
    font-family: inherit;
    border-bottom: 1px solid var(--line);
    transition: background 0.12s;
  }
  .notif-item:hover {
    background: var(--teal-soft);
  }
  .notif-item__dot {
    flex: 0 0 auto;
    width: 9px;
    height: 9px;
    margin-top: 6px;
    border-radius: 50%;
    background: transparent;
    border: 1px solid transparent;
  }
  .notif-item.is-unread .notif-item__dot {
    background: var(--brand);
    border-color: var(--brand);
    box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.18);
  }
  .notif-item__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1 1 auto;
  }
  .notif-item__title {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--ink);
  }
  .notif-item.is-unread .notif-item__title {
    color: var(--teal-dark);
  }
  .notif-item__body {
    font-size: 0.83rem;
    color: var(--ink-soft);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .notif-item__time {
    flex: 0 0 auto;
    font-size: 0.72rem;
    color: var(--ink-soft);
    white-space: nowrap;
    margin-top: 2px;
  }
  .notif-panel__body.has-empty {
    display: flex;
    align-items: center;
  }
  .notif-panel__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    text-align: center;
    padding: 28px 20px;
    color: var(--ink-soft);
    font-size: 0.9rem;
    width: 100%;
  }
  .notif-panel__empty > span:first-child {
    font-size: 1.8rem;
    line-height: 1;
  }
  .notif-panel__empty > span:last-child {
    max-width: 240px;
    font-size: 0.82rem;
  }
  .notif-panel__foot {
    border-top: 1px solid var(--line);
    padding: 10px 16px;
    text-align: center;
    background: var(--bg-soft);
  }
  .notif-panel__foot a {
    font-weight: 700;
    font-size: 0.85rem;
  }
  @media (max-width: 560px) {
    .notif-panel {
      position: fixed;
      right: 16px;
      left: 16px;
      width: auto;
      top: 72px;
    }
  }
  .app-footer {
    border-top: 1px solid var(--line);
    background: var(--bg-soft);
    padding: 20px 0;
    margin-top: 64px;
    color: var(--ink-soft);
    font-size: 0.88rem;
  }
  .app-footer .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .foot-link {
    font-weight: 600;
    font-size: 0.88rem;
  }
  @media (max-width: 560px) {
    .user-email {
      display: none;
    }
    .user-chip {
      padding: 6px 8px;
      max-width: 120px;
    }
    .user-name {
      max-width: 100px;
    }
    /* Signout button on small screens: icon-only or hide text */
    .signout-btn {
      padding: 8px 12px;
      font-size: 0.8rem;
    }
    .app-bar {
      gap: 8px;
    }
    .brand small {
      display: none;
    }
  }
</style>