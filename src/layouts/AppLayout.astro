---
// Languago app shell for signed-in areas (/dashboard/* and /teacher/*).
// Unlike the public Layout (marketing nav: Ana Sayfa/İndir/Kayıt Ol/Giriş Yap),
// this renders a slim app header: a brand link into the app and a user menu
// (signed-in user's name/email + "Çıkış Yap"). No marketing links.
//
// The signed-in user is read server-side (guarded). If the session cannot be
// resolved (e.g. build/prerender without cookies), the menu simply falls back
// to the sign-out button without a name/email.
interface Props {
  title: string;
  description?: string;
  /** Fully-qualified page URL (e.g. "https://www.languago.site/..."). */
  canonical?: string;
  image?: string;
}

import '../styles/global.css';
import { createSupabaseClient, pageCookieSource } from '../lib/supabase';

const {
  title,
  description = 'Samet Tıraşoğlu ile İngilizce öğrenin: kelime, dil bilgisi, okuma ve sınıf içi oyunlar.',
  canonical,
  image,
} = Astro.props;

const siteUrl = Astro.site?.origin || 'https://www.languago.site';
const path = Astro.url.pathname;
const pageUrl = canonical || `${siteUrl}${path}`;
const ogImage = image || `${siteUrl}/og-cover.png`;

let userName: string | null = null;
let userEmail: string | null = null;
const supabase = createSupabaseClient(pageCookieSource(Astro));
if (supabase) {
  try {
    const { data } = await supabase.auth.getUser();
    const u = data.user;
    if (u) {
      userEmail = u.email ?? null;
      userName =
        (u.user_metadata?.full_name as string | undefined) || userEmail;
    }
  } catch {
    // Ignore — fall back to a menu without identity.
  }
}

const displayName = userName ?? userEmail ?? null;
const initial = displayName ? displayName.trim().charAt(0).toUpperCase() : 'H';
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- SEO -->
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={pageUrl} />
    <meta name="theme-color" content="#0d9488" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🐟</text></svg>" />

    <!-- PWA (manifest metadatas only; SW is registered on the public landing) -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Languago" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Languago" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="576" />
    <meta property="og:image:alt" content="Languago — İngilizce öğrenmenin oyunlu yolu" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <slot name="head" />
  </head>
  <body>
    <header class="app-header">
      <div class="container app-bar">
        <a class="brand" href="/dashboard">
          <span class="fish">📚</span> Languago
          <small>panel</small>
        </a>

        <div class="user-menu">
          {
            displayName && (
              <span class="user-chip" title={userEmail ?? displayName}>
                <span class="user-avatar">{initial}</span>
                <span class="user-id">
                  <span class="user-name">{displayName}</span>
                  {userEmail && <span class="user-email">{userEmail}</span>}
                </span>
              </span>
            )
          }
          <form id="app-signout-form" class="signout-form">
            <button class="btn ghost signout-btn" type="submit">Çıkış Yap</button>
          </form>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="app-footer">
      <div class="container">
        <span>© {new Date().getFullYear()} Languago — Samet Tıraşoğlu</span>
        <a class="foot-link" href="/dashboard">Öğrenci Paneli</a>
      </div>
    </footer>
  </body>
</html>

<script is:inline>
  (function () {
    var form = document.getElementById('app-signout-form');
    if (!form) return;
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var btn = form.querySelector('button');
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Çıkılıyor…';
      }
      fetch('/api/auth/signout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: '{}',
      })
        .then(function () {
          window.location.href = '/';
        })
        .catch(function () {
          // Endpoint failure: still leave the app so the user is not left
          // stuck on a dashboard they can't use.
          window.location.href = '/';
        });
    });
  })();
</script>

<style>
  .app-header {
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    border-top: 4px solid var(--teal);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .app-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 64px;
  }
  .app-header .brand small {
    font-size: 0.75rem;
  }
  .app-header .brand .fish {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: var(--teal-soft);
    font-size: 1.15rem;
    color: var(--teal);
  }
  .user-menu {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .user-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    background: var(--teal-soft);
    border: 1px solid var(--teal-soft);
    border-radius: 999px;
    max-width: 100%;
  }
  .user-avatar {
    width: 28px;
    height: 28px;
    flex: 0 0 28px;
    border-radius: 50%;
    background: var(--teal);
    color: #fff;
    font-weight: 800;
    font-size: 0.9rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .user-id {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    min-width: 0;
  }
  .user-name {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 180px;
  }
  .user-email {
    font-size: 0.75rem;
    color: var(--ink-soft);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 180px;
  }
  .signout-form {
    margin: 0;
  }
  .signout-btn {
    padding: 8px 16px;
    font-size: 0.9rem;
  }
  .app-footer {
    border-top: 1px solid var(--line);
    background: var(--bg-soft);
    padding: 20px 0;
    margin-top: 64px;
    color: var(--ink-soft);
    font-size: 0.88rem;
  }
  .app-footer .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .foot-link {
    font-weight: 600;
    font-size: 0.88rem;
  }
  @media (max-width: 560px) {
    .user-email {
      display: none;
    }
    .user-chip {
      padding: 6px 8px;
    }
  }
</style>