---
interface Props {
  title: string;
  description?: string;
  /** Fully-qualified page URL (e.g. "https://www.languago.site/..."). */
  canonical?: string;
  image?: string;
}

import '../styles/global.css';
import MobilePublicNav from '../components/MobilePublicNav.astro';

const {
  title,
  description = 'Languago ile İngilizce öğrenin: kelime, dil bilgisi, okuma ve sınıf içi oyunlar.',
  canonical,
  image,
} = Astro.props;

const siteUrl = Astro.site?.origin || 'https://www.languago.site';
const path = Astro.url.pathname;
const pageUrl = canonical || `${siteUrl}${path}`;
const ogImage = image || `${siteUrl}/og-cover.png`;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- SEO -->
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={pageUrl} />
    <meta name="theme-color" content="#0d9488" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/logo/kommo-32.png" />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0d9488" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Languago" />
    <link rel="apple-touch-icon" href="/logo/kommo-180.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Languago" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="576" />
    <meta property="og:image:alt" content="Languago — İngilizce öğrenmenin oyunlu yolu" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JS-free progressive content: no client framework, no hydration box -->

    <slot name="head" />

    <!-- Organization + WebSite structured data (static JSON-LD, no set:html —
         a set:html/is:inline script in the head slot reorders the SSR stream
         on this page: content leaks after </html>. Kept plain/literal. -->
    <script type="application/ld+json">{
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://www.languago.site/#website",
          "url": "https://www.languago.site/",
          "name": "Languago",
          "description": "İngilizce öğrenmenin oyunlu yolu: kelime dağarcığı, dil bilgisi, okuma becerileri ve sınıf içi oyunlar.",
          "inLanguage": "tr-TR",
          "publisher": { "@id": "https://www.languago.site/#organization" }
        },
        {
          "@type": "EducationalOrganization",
          "@id": "https://www.languago.site/#organization",
          "name": "Languago",
          "alternateName": "Languago İngilizce",
          "description": "İngilizce öğrenme: kelime, dil bilgisi, okuma ve sınıf içi oyunlarla hem bireysel hem sınıf içi öğrenme deneyimi.",
          "url": "https://www.languago.site/",
          "logo": "https://www.languago.site/mascot.png",
          "email": "contact@languago.site",
          "teaches": "English",
          "inLanguage": ["tr", "en"],
          "areaServed": { "@type": "Place", "name": "Türkiye" }
        }
      ]
    }</script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">İçeriğe geç</a>
    <div class="notice-bar">
      <div class="container">
        🚀 Yeni Languago Android uygulamamız yayında —{' '}
        <a href="/indir">Hemen indir</a>
      </div>
    </div>
    <header class="site">
      <div class="container">
        <a class="brand" href="/">
          <img class="brand-mark" src="/logo/kommo-96.png" alt="Kommo — Languago maskotu (kitap okuyan Komodo ejderi)" width="96" height="96" /> Languago
        </a>
        <nav class="site" aria-label="Ana gezinme">
          <a class="nav" href="/">Ana Sayfa</a>
          <a class="nav" href="/ogren">Öğren</a>
          <a class="nav" href="/materyal-uretici">Materyal Üretici</a>
          <a class="nav" href="/blog">Blog</a>
          <a class="nav" href="/indir">İndir</a>
          <a class="nav" href="/fiyatlandirma">Fiyatlandırma</a>
          <a class="nav" href="/iletisim">İletişim</a>
        </nav>
        <a class="btn primary cta" href="/signin">Giriş Yap</a>
      </div>
    </header>
    <MobilePublicNav />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <footer class="site">
      <div class="container footer-grid">
        <div class="fcol f-brand">
          <a class="brand" href="/">
            <img src="/mascot.png" alt="Languago maskotu" class="footer-mascot" width="1024" height="1024" loading="lazy" />
            Languago
          </a>
          <p>
            İngilizce öğrenmenin eğlenceli yolu — kelime, dil bilgisi, okuma ve
            sınıf içi oyunlarla.
          </p>

        </div>
        <div class="fcol">
          <h4>Platform</h4>
          <a href="/">Ana Sayfa</a>
          <a href="/blog">Blog</a>
          <a href="/indir">İndir</a>
          <a href="/ogren">Öğrenme Yolu</a>
          <a href="/fiyatlandirma">Fiyatlandırma</a>
          <a href="/dashboard">Öğrenci Paneli</a>
        </div>
        <div class="fcol">
          <h4>Şirket</h4>
          <a href="/hakkimizda">Hakkımızda</a>
          <a href="/iletisim">İletişim</a>
          <a href="/kvkk">KVKK</a>
          <a href="/cerez-politikasi">Çerez Politikası</a>
        </div>
        <div class="fcol">
          <h4>Destek</h4>
          <a href="/iletisim">İletişim</a>
          <a href="/signup">Kayıt Ol</a>
          <a href="/signin">Giriş Yap</a>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} Languago. Tüm hakları saklıdır.</span>
      </div>
    </footer>
  <script is:inline>
      // Register the PWA service worker safely — only on the public landing,
      // only when supported, and never in a way that could break auth/SSR.
      if ('serviceWorker' in navigator && window.location.href.indexOf('/app') === -1) {
        window.addEventListener('load', function () {
          try {
            navigator.serviceWorker.register('/sw.js').catch(function () {});
          } catch (e) {
            /* ignore */
          }
        });
      }
    </script>
  </body>
</html>