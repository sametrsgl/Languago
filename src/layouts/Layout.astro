---
interface Props {
  title: string;
  description?: string;
  /** Fully-qualified page URL (e.g. "https://www.languago.site/..."). */
  canonical?: string;
  image?: string;
}

import '../styles/global.css';

const {
  title,
  description = 'Samet Tıraşoğlu ile İngilizce öğrenin: kelime, dil bilgisi, okuma ve sınıf içi oyunlar.',
  canonical,
  image,
} = Astro.props;

const siteUrl = Astro.site?.origin || 'https://www.languago.site';
const path = Astro.url.pathname;
const pageUrl = canonical || `${siteUrl}${path}`;
const ogImage = image || `${siteUrl}/og-cover.png`;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- SEO -->
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={pageUrl} />
    <meta name="theme-color" content="#0d9488" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🐟</text></svg>" />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0d9488" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Languago" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Languago" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="576" />
    <meta property="og:image:alt" content="Languago — İngilizce öğrenmenin oyunlu yolu" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JS-free progressive content: no client framework, no hydration box -->

    <slot name="head" />
  </head>
  <body>
    <div class="notice-bar">
      <div class="container">
        🚀 Yeni Languago Android uygulamamız yayında —{' '}
        <a href="/indir">Hemen indir</a>
      </div>
    </div>
    <header class="site">
      <div class="container">
        <a class="brand" href="/">
          <span class="fish">📚</span> Languago
        </a>
        <nav class="site" aria-label="Ana gezinme">
          <a class="nav" href="/">Ana Sayfa</a>
          <a class="nav" href="/blog">Blog</a>
          <a class="nav" href="/indir">İndir</a>
          <a class="nav" href="/iletisim">İletişim</a>
        </nav>
        <a class="btn primary cta" href="/signin">Giriş Yap</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site">
      <div class="container footer-grid">
        <div class="fcol f-brand">
          <a class="brand" href="/">
            <img src="/mascot.png" alt="Languago maskotu" class="footer-mascot" width="1024" height="1024" loading="lazy" />
            Languago
          </a>
          <p>
            İngilizce öğrenmenin eğlenceli yolu — kelime, dil bilgisi, okuma ve
            sınıf içi oyunlarla.
          </p>
          <div class="f-social">
            <a href="https://instagram.com" aria-label="Instagram" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#fff" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.8" fill="#fff" stroke="none"/></svg>
            </a>
            <a href="https://x.com" aria-label="X" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="#fff" stroke-width="2.4" aria-hidden="true"><path d="M4 4l16 16M20 4L4 20"/></svg>
            </a>
            <a href="https://discord.com" aria-label="Discord" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#fff" stroke-width="2" aria-hidden="true"><path d="M12 3C7.5 3 4 5.8 4 9.3c0 2 1.1 3.8 2.8 4.9L6 19l3.6-1.9c.8.2 1.6.3 2.4.3 4.5 0 8-2.8 8-6.3S16.5 3 12 3z"/></svg>
            </a>
            <a href="https://youtube.com" aria-label="YouTube" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#fff" stroke-width="2" aria-hidden="true"><rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="M10 9.5v5l4.5-2.5z" fill="#fff" stroke="none"/></svg>
            </a>
          </div>
        </div>
        <div class="fcol">
          <h4>Platform</h4>
          <a href="/">Ana Sayfa</a>
          <a href="/blog">Blog</a>
          <a href="/indir">İndir</a>
          <a href="/dashboard">Öğrenci Paneli</a>
        </div>
        <div class="fcol">
          <h4>Şirket</h4>
          <a href="/hakkimizda">Hakkımızda</a>
          <a href="/iletisim">İletişim</a>
          <a href="/kvkk">KVKK</a>
          <a href="/cerez-politikasi">Çerez Politikası</a>
        </div>
        <div class="fcol">
          <h4>Destek</h4>
          <a href="/iletisim">İletişim</a>
          <a href="/signup">Kayıt Ol</a>
          <a href="/signin">Giriş Yap</a>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} Languago — Samet Tıraşoğlu. Tüm hakları saklıdır.</span>
      </div>
    </footer>
  <script is:inline>
      // Register the PWA service worker safely — only on the public landing,
      // only when supported, and never in a way that could break auth/SSR.
      if ('serviceWorker' in navigator && window.location.href.indexOf('/app') === -1) {
        window.addEventListener('load', function () {
          try {
            navigator.serviceWorker.register('/sw.js').catch(function () {});
          } catch (e) {
            /* ignore */
          }
        });
      }
    </script>
  </body>
</html>