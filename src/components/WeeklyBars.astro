---
// One measure over the last weeks as small bars (one series, so no legend: the
// title names it). The current week is highlighted; each bar shows its value on
// hover or keyboard focus; a hidden table carries the same numbers.
import type { Week } from '../lib/weekly-activity';
interface Props { title: string; unit: string; weeks: Week[]; values: number[] }
const { title, unit, weeks, values } = Astro.props;
const max = Math.max(1, ...values);
const total = values.reduce((a, b) => a + b, 0);
const nice = Math.max(1, Math.ceil(max / (max > 20 ? 10 : max > 5 ? 5 : 1)) * (max > 20 ? 10 : max > 5 ? 5 : 1));
---

<figure class="wb">
  <figcaption><span class="wb-title">{title}</span><b class="wb-total">{total.toLocaleString('tr-TR')}</b><span class="wb-sub">son 8 hafta</span></figcaption>
  <div class="wb-plot" aria-hidden="true">
    <span class="wb-max">{nice}</span>
    {weeks.map((w, i) => (
      <div class={`wb-col${w.current ? ' is-now' : ''}`} tabindex="0" data-tip={`${w.current ? 'Bu hafta' : `${w.label} haftası`}: ${values[i]} ${unit}`}>
        <i style={`height:${values[i] ? Math.max(4, (values[i] / nice) * 100) : 0}%`}></i>
      </div>
    ))}
  </div>
  <div class="wb-axis" aria-hidden="true"><span>{weeks[0]?.label}</span><span>bu hafta</span></div>
  <table class="sr-only"><caption>{title}, haftalara göre</caption><thead><tr><th>Hafta</th><th>{unit}</th></tr></thead>
    <tbody>{weeks.map((w, i) => <tr><td>{w.label}</td><td>{values[i]}</td></tr>)}</tbody></table>
</figure>

<style>
  .wb { margin: 0; display: grid; gap: 10px; min-width: 0; }
  .wb figcaption { display: grid; grid-template-columns: 1fr auto; align-items: baseline; gap: 0 10px; }
  .wb-title { font-weight: 700; color: var(--ink-2); font-size: 14px; }
  .wb-total { font-size: 28px; color: var(--ink); font-variant-numeric: tabular-nums; grid-row: span 2; }
  .wb-sub { font-size: 12px; color: var(--muted); }
  .wb-plot { position: relative; height: 96px; display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 2px; align-items: end; border-bottom: 1px solid rgba(255, 255, 255, .12); padding-top: 14px; }
  .wb-max { position: absolute; top: 0; left: 0; font-size: 11px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .wb-plot::before { content: ""; position: absolute; left: 0; right: 0; top: 14px; border-top: 1px dashed rgba(255, 255, 255, .08); }
  .wb-col { position: relative; height: 100%; display: flex; align-items: flex-end; justify-content: center; cursor: default; outline: none; }
  .wb-col i { display: block; width: min(70%, 22px); border-radius: 4px 4px 0 0; background: rgba(45, 212, 191, .45); transition: background .15s; }
  .wb-col.is-now i { background: #2dd4bf; }
  .wb-col:hover i, .wb-col:focus-visible i { background: #5eead4; }
  .wb-col:focus-visible { box-shadow: 0 0 0 2px #5eead4; border-radius: 6px; }
  .wb-col:hover::after, .wb-col:focus-visible::after { content: attr(data-tip); position: absolute; bottom: calc(100% + 6px); left: 50%; transform: translateX(-50%); white-space: nowrap; padding: 6px 10px; border-radius: 8px; background: #132624; border: 1px solid rgba(255, 255, 255, .14); color: var(--ink); font-size: 12.5px; font-weight: 700; z-index: 5; pointer-events: none; }
  .wb-col:first-child:hover::after, .wb-col:first-child:focus-visible::after { left: 0; transform: none; }
  .wb-col:last-child:hover::after, .wb-col:last-child:focus-visible::after { left: auto; right: 0; transform: none; }
  .wb-axis { display: flex; justify-content: space-between; font-size: 11.5px; color: var(--muted); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
