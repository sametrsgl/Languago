# Copy to .env and fill in from your Supabase project
# (Supabase Dashboard → Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Material Maker LLM (OpenAI-compatible chat endpoint; reuses the OpenCode Go endpoint).
# LLM_BASE_URL defaults to https://opencode.ai/zen/go/v1, LLM_MODEL defaults to
# deepseek-v4-pro. LLM_API_KEY is REQUIRED — the generator 500s without it.
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-v4-pro
LLM_API_KEY=your-opencode-go-api-key