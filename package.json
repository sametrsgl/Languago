{
  "name": "languago-platform",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Languago — Languago teaching platform (Astro SSR + Supabase)",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "test": "node --test tests/**/*.mjs tests/**/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "content:check": "node scripts/validate-content.mjs",
    "postinstall": "patch-package",
    "port:content": "node scripts/port_content.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.4.0",
    "@astrojs/vercel": "^11.0.10",
    "@sparticuz/chromium": "^149.0.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "astro": "^7.3.2",
    "parse5": "^7.3.0",
    "puppeteer-core": "^25.9.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4.3.3"
  },
  "overrides": {
    "path-to-regexp": "6.3.0",
    "tar": "7.5.22"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "esbuild@0.27.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true
  }
}
